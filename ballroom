// _widget-set KEY VALUE: the one thing the panel cannot do through a verb of its own. A widget setting lives in
// the shell's configuration, and only the shell may write it; everything else the panel changes goes through the
// same verbs a person types. The value arrives as text because that is what a command line carries; the type
// comes from the schema, so the panel and the terminal cannot disagree about what a setting is.
function setWidgetSetting(key: string, value: string): string {
  const w = WIDGET_SETTINGS.find((x) => x.key === key);
  if (!w) throw new Fail(`no widget setting ${clean(key).slice(0, 40)}`, EXIT.usage);
  const v = w.type === "boolean" ? value === "on" || value === "true" : w.type === "integer" ? Number(value) : value;
  setWidgetValue(w.key, v);
  return "ok";
}

// ---------------------------------------------------------------- spectrum
// One cava process, raw ASCII frames, one JSON line per frame on stdout. cava ends with this process, and
// this process ends when its reader goes away, so no analyser outlives the bar.
async function verbSpectrum(args: string[]) {
  const bars = Math.max(2, Math.min(64, Number(optionValue(args, "--bars") ?? 10)));
  const fps = Math.max(5, Math.min(60, Number(optionValue(args, "--fps") ?? 30)));
  const source = optionValue(args, "--source") ?? "auto";
  if (!/^(auto|\d+)$/.test(source)) throw new Fail("--source is auto or an object serial", EXIT.usage);
  // What the capture is called says what it reads (rule 8). A serial has to belong to a device that exists.
  let who = "output";
  if (source !== "auto") {
    const g = readGraph();
    const input = g.inputs.find((d) => d.serial === Number(source));
    if (input) {
      if (input.mute) throw new Fail(`${input.label} is muted; a muted input is never read`, EXIT.notFound);
      who = "input";
    } else if (!g.outputs.some((d) => d.serial === Number(source))) throw new Fail(`no device has the serial ${source}`, EXIT.notFound);
  }
  ensureDir(RUNTIME);
  // A spectrum that was killed outright left its file behind: those of processes that are gone are removed.
  for (const f of readdirSync(RUNTIME).filter((x) => /^cava-\d+\.conf$/.test(x))) {
    try { process.kill(Number(f.slice(5, -5)), 0); } catch (e: any) { if (e?.code === "ESRCH") rmSync(join(RUNTIME, f), { force: true }); }
  }
  // One file per process: two spectra run at once, and a restarted one must never pick up the other's source.
  const conf = join(RUNTIME, `cava-${process.pid}.conf`);
  writeFileSync(conf, [
    "[general]", `bars = ${bars}`, `framerate = ${fps}`, "sleep_timer = 2",
    "[input]", "method = pipewire", `source = ${source}`,
    "[output]", "method = raw", "channels = mono", "mono_option = average", "raw_target = /dev/stdout",
    "data_format = ascii", "ascii_max_range = 1000", "bar_delimiter = 59", "frame_delimiter = 10", "",
  ].join("\n"), { mode: 0o600 });
  let proc: ReturnType<typeof Bun.spawn>;
  const env = { ...process.env, PIPEWIRE_PROPS: `{ node.name = ballroom.spectrum.${who} application.name = Ballroom }` };
  try { proc = Bun.spawn({ cmd: ["cava", "-p", conf], env, stdin: "ignore", stdout: "pipe", stderr: "ignore" }); }
  catch { rmSync(conf, { force: true }); throw new Fail("cava is not installed"); }
  const stop = () => { try { proc.kill("SIGTERM"); } catch { /* already gone */ } rmSync(conf, { force: true }); process.exit(0); };
  process.on("SIGTERM", stop); process.on("SIGINT", stop); process.on("SIGHUP", stop);
  process.stdout.on("error", stop);
  // Orphaned when the parent dies: the kernel hands the process to init, and that is the signal to stop.
  const parent = process.ppid;
  setInterval(() => { if (process.ppid !== parent) stop(); }, 1000);
  const decoder = new TextDecoder();
  let buffer = "";
  for await (const chunk of proc.stdout as ReadableStream<Uint8Array>) {
    buffer += decoder.decode(chunk, { stream: true });
    let nl: number;
    while ((nl = buffer.indexOf("\n")) >= 0) {
      const line = buffer.slice(0, nl); buffer = buffer.slice(nl + 1);
      const bands = line.split(";").filter((x) => x !== "").map((x) => Math.min(1, Number(x) / 1000));
      if (bands.length === bars) process.stdout.write(JSON.stringify({ bands }) + "\n");
    }
  }
  const rc = await proc.exited;
  rmSync(conf, { force: true });
  throw new Fail(`cava ended with exit ${rc}`);
}

function optionValue(args: string[], name: string): string | undefined {
  const i = args.indexOf(name);
  return i >= 0 ? args[i + 1] : undefined;
}

