function eqNode(g: Graph): any { return g.objects.find((o) => o.type === "PipeWire:Interface:Node" && o.info?.props?.["node.name"] === EQ_NODE); }
function eqLiveControls(g: Graph): Record<string, number> | null {
  const n = eqNode(g);
  if (!n) return null;
  const props = (n.info?.params?.Props ?? []).find((p: any) => Array.isArray(p.params) && p.params.some((x: any) => typeof x === "string" && x.includes(":")));
  if (!props) return {};
  const out: Record<string, number> = {};
  for (let i = 0; i + 1 < props.params.length; i += 2) out[String(props.params[i])] = Number(props.params[i + 1]);
  return out;
}
function foreignFilters(g: Graph): string[] {
  return g.objects.filter((o) => o.type === "PipeWire:Interface:Node").map((o) => o.info?.props ?? {})
    .filter((p) => String(p["media.class"]) === "Audio/Sink" && (p["filter.smart"] === true || p["filter.smart"] === "true") && p["node.name"] !== EQ_NODE)
    .map((p) => String(p["node.name"]));
}
const unit = (verb: string) => run(["systemctl", "--user", verb, EQ_UNIT], 5000);
const shapeOfConf = (): string | null => { try { return /^# shape: (.*)$/m.exec(readFileSync(EQ_CONF, "utf8"))?.[1] ?? null; } catch { return null; } };

// Brings the equalizer in line with sound.json, presets and the default device. Returns what it did.
// Rule 1: the answer is read from the graph afterwards. A filter that sleeps (nothing plays) takes new values
// when sound comes back and shows them only then (measured); that is reported as pending, not as done.
type SyncResult = { action: "none" | "started" | "stopped" | "rebuilt" | "live"; running: boolean; pending: boolean; plan: EqPlan };
function eqSync(opts: { restart?: boolean; force?: boolean; stop?: boolean } = {}): SyncResult {
  let g = readGraph();
  const sound = loadSound();
  const plan = soundPlan(g, sound);
  ensureDir(RUNTIME);
  if (opts.stop) {
    if (!eqNode(g) && unit("is-active").rc !== 0) return { action: "none", running: false, pending: false, plan };
    must(unit("stop"), "systemctl --user stop");
    g = waitFor((x) => !eqNode(x), 3000);
    rmSync(join(RUNTIME, "eq-live.json"), { force: true });
    if (eqNode(g)) throw new Fail("the equalizer did not stop");
    return { action: "stopped", running: false, pending: false, plan };
  }
  const running = !!eqNode(g);
  // Off and not running: nothing to do; an equalizer is only started to be used.
  if (!sound.enabled && !running) return { action: "none", running: false, pending: false, plan };
  if (!running || opts.restart || shapeOfConf() !== SHAPE) {
    // A start that failed is not retried on every change in the graph: apply runs on each of them, and each
    // try waits seconds for a filter that will not come. A verb the user types always tries.
    const failedFile = join(RUNTIME, "eq-failed.json");
    if (!running && !opts.force) {
      try { const f = JSON.parse(readFileSync(failedFile, "utf8")); if (Date.now() - f.at < 30000) throw new Fail(`the equalizer did not start ${Math.round((Date.now() - f.at) / 1000)} s ago; ballroom eq restart tries again now`); }
      catch (e) { if (e instanceof Fail) throw e; }
    }
    const failed = (message: string) => { writeRuntime("eq-failed.json", JSON.stringify({ at: Date.now(), message }) + "\n"); return new Fail(message); };
    rmSync(failedFile, { force: true });
    ensureDir(join(HOME, ".config", "ballroom"));
    // The configuration that worked last is kept beside the new one until the new one has loaded; a start that
    // fails puts it back, so there is always a file the user can return to.
    const tmp = `${EQ_CONF}.tmp.${process.pid}`, lastGood = `${EQ_CONF}.last-good`;
    if (existsSync(EQ_CONF)) copyFileSync(EQ_CONF, lastGood);
    writeFileSync(tmp, eqConfText(plan), { mode: 0o600 });
    renameSync(tmp, EQ_CONF);
    const rollBack = () => { if (existsSync(lastGood)) renameSync(lastGood, EQ_CONF); };
    const r = unit("restart");
    if (r.rc === 127) { rollBack(); throw new Fail("systemctl is not installed; the equalizer runs as a user service"); }
    if (r.rc !== 0) { rollBack(); throw failed(`${EQ_UNIT} did not start (is it installed? ballroom's install.sh puts it in place)`); }
    g = waitFor((x) => !!eqNode(x) && eqLiveControls(x) !== null, 4000);
    if (!eqNode(g)) { rollBack(); throw failed(`${EQ_UNIT} started, but its filter did not appear; journalctl --user -u ${EQ_UNIT} says why`); }
    rmSync(lastGood, { force: true });
    writeRuntime("eq-live.json", JSON.stringify({ preamp: plan.bypass ? 0 : plan.preamp, device: plan.device, at: Date.now() }) + "\n");
    return { action: running ? "rebuilt" : "started", running: true, pending: false, plan };
  }
  const want = eqControls(plan);
  const have = eqLiveControls(g) ?? {};
  const changed = Object.entries(want).filter(([k, v]) => have[k] === undefined || Math.abs(have[k] - v) > 0.0005);
  writeRuntime("eq-live.json", JSON.stringify({ preamp: plan.bypass ? 0 : plan.preamp, device: plan.device, at: Date.now() }) + "\n");
  if (!changed.length) return { action: "none", running: true, pending: false, plan };
  // All changed controls in one call: one click, not one per band.
  const node = eqNode(g);
  must(run(["pw-cli", "set-param", String(node.id), "Props", `{ params = [ ${changed.map(([k, v]) => `"${k}" ${num(v)}`).join(" ")} ] }`]), "pw-cli set-param");
  if (node.info?.state === "suspended") return { action: "live", running: true, pending: true, plan };
  g = waitFor((x) => { const c = eqLiveControls(x) ?? {}; return changed.every(([k, v]) => c[k] !== undefined && Math.abs(c[k] - v) < 0.01); }, 2000);
  const c = eqLiveControls(g) ?? {};
  const missed = changed.filter(([k, v]) => c[k] === undefined || Math.abs(c[k] - v) >= 0.01);
  if (missed.length && eqNode(g)?.info?.state === "suspended") return { action: "live", running: true, pending: true, plan };
  if (missed.length) throw new Fail(`the equalizer did not take ${missed.length} of ${changed.length} values${process.env.BALLROOM_DEBUG ? `: ${missed.map(([k, v]) => `${k}=${v}/${c[k]}`).join(" ")}` : ""}`);
  return { action: "live", running: true, pending: false, plan };
}

// The equalizer's preamp goes with its process. If that process dies, the sound plays on the device without it,
// louder by the preamp; apply takes the device down by that much until the equalizer is back, so a failure never makes it louder.
// The preamp of a running equalizer holds the sound down by that much. When the preamp goes away (the filter
// died, or the user turned the equalizer off), the default output is brought down by the same amount so the
// loudness stays, and the level that was set is written down next to the level it came from. When the preamp
// is back, the output is raised again only if it still stands exactly where it was put: anything the user
// changed meanwhile stays, and the compensation is dropped and named. The raise never goes above the level it
// came from, nor above the device's cap, so the return of the equalizer can never be a jump.
const COMP_FILE = () => join(RUNTIME, "eq-compensation.json");
type Compensation = { device: string; db: number; from: number; to: number };
function loadCompensation(): Compensation | null {
  try { const c = JSON.parse(readFileSync(COMP_FILE(), "utf8")); return typeof c?.device === "string" && [c.db, c.from, c.to].every((x: any) => typeof x === "number") ? c : null; } catch { return null; }
}
function compensateDown(d: Device, db: number, changes: string[], why: string) {
  const to = Math.round(d.volume * Math.cbrt(Math.pow(10, db / 20)) * 1000) / 1000;
  setVolume(d.name, to);
  const after = readGraph().outputs.find((x) => x.name === d.name);
  writeRuntime("eq-compensation.json", JSON.stringify({ device: d.name, db, from: d.volume, to: after?.volume ?? to }) + "\n");
  changes.push(`${d.name}: ${db} dB ${why}`);
}
function compensateBack(g: Graph, changes: string[]) {
  const comp = loadCompensation();
  if (!comp) return;
  rmSync(COMP_FILE(), { force: true });
  const d = g.outputs.find((x) => x.name === comp.device);
  if (!d) { changes.push(`${comp.device}: not present, its level stays where it is`); return; }
  if (Math.abs(d.volume - comp.to) > 0.005) { changes.push(`${d.name}: its level was changed meanwhile and stays at ${percent(d.volume)} %`); return; }
  const target = Math.min(comp.from, d.cap ?? comp.from);
  if (target <= d.volume) return;
  setVolume(d.name, target);
  changes.push(`${d.name}: back to ${percent(target)} %, the equalizer is back`);
}
function eqGuard(g: Graph, changes: string[]) {
  const sound = loadSound();
  let live: any = null;
  try { live = JSON.parse(readFileSync(join(RUNTIME, "eq-live.json"), "utf8")); } catch { /* the equalizer never ran in this login */ }
  const present = !!eqNode(g);
  if (sound.enabled && !present && live && live.preamp < 0 && !loadCompensation()) {
    const d = g.outputs.find((x) => x.isDefault && !x.filter);
    if (d) compensateDown(d, live.preamp, changes, "while the equalizer is gone");
  }
  if (present && sound.enabled) compensateBack(g, changes);
}

// AutoEQ's ParametricEQ.txt: "Preamp: -6.2 dB" and "Filter 1: ON PK Fc 105 Hz Gain -2.1 dB Q 0.70".
function parseAutoEq(text: string): Preset {
  const bands: Band[] = [];
  let preamp: "auto" | number = "auto";
  for (const line of text.split(/\r?\n/)) {
    const pre = /^\s*Preamp:\s*(-?[\d.]+)\s*dB/i.exec(line);
    if (pre) { preamp = Number(pre[1]); continue; }
    const m = /^\s*Filter\s*\d*:\s*(ON|OFF)\s+(PK|PEQ|LSC|LS|LSQ|HSC|HS|HSQ)\s+Fc\s+([\d.]+)\s*Hz(?:\s+Gain\s+(-?[\d.]+)\s*dB)?(?:\s+Q\s+([\d.]+))?/i.exec(line);
    if (!m) continue;
    if (m[1].toUpperCase() === "OFF") continue;
    const kind = m[2].toUpperCase();
    const type: BandType = kind.startsWith("L") ? "lowshelf" : kind.startsWith("H") ? "highshelf" : "peaking";
    bands.push(clampBand({ type, freq: Number(m[3]), gain: Number(m[4] ?? 0), q: Number(m[5] ?? (type === "peaking" ? 1 : 0.7)) }));
  }
  if (!bands.length) throw new Fail("no filter lines found; expected AutoEQ's ParametricEQ.txt", EXIT.usage);
  if (bands.length > MAX_BANDS) throw new Fail(`${bands.length} filters; Ballroom takes up to ${MAX_BANDS}`, EXIT.usage);
  checkFits(bands);
  return { preamp, bands };
}

function eqReport(plan: EqPlan, running: boolean, g: Graph) {
  const presets = allPresets();
  return {
    enabled: loadSound().enabled, running, device: plan.device, preset: plan.presetName, maxBands: SLOT_COUNT,
    builtin: plan.presetName in BUILTIN_PRESETS && !(plan.presetName in loadPresets().presets),
    presets: Object.keys(presets), preamp: plan.preamp, preampMode: plan.preset.preamp === "auto" ? "auto" : "fixed",
    bands: plan.bands, balance: loadSound().balance, mono: loadSound().mono, swap: loadSound().swap,
    foreign: foreignFilters(g),
    curve: CURVE_FREQS.map((f) => ({ f, db: Math.round((bandsDb(plan.bands, f) + plan.preamp) * 100) / 100 })),
  };
}

// The device a preset change is for: the named one, or the default output.
function eqTarget(g: Graph, words: string[]): Device { return findDevice(g, "sink", words.join(" ")); }
// A built-in preset is never edited in place: the first edit copies it to "Custom" and gives that to the device.
function editablePreset(g: Graph, device: Device): { name: string; presets: Presets } {
  const store = loadPresets();
  const all = allPresets();
  const current = loadDevices().devices[device.name]?.eq;
  let name = current && all[current] ? current : "Flat";
  if (!(name in store.presets)) {
    // A built-in preset is never edited in place: it is copied under a free name, and a copy that another
    // device already uses is not overwritten.
    let copy = "Custom";
    for (let n = 2; copy in store.presets; n++) copy = `Custom ${n}`;
    store.presets[copy] = JSON.parse(JSON.stringify(all[name]));
    name = copy;
    const devices = loadDevices();
    (devices.devices[device.name] ??= {}).eq = name;
    saveJson("devices.json", devices);
  }
  return { name, presets: store };
}

function verbEq(args: string[]): Out {
  const reading = !args.length || args[0] === "show" || (args[0] === "preset" && (args[1] ?? "list") === "list");
  return reading ? eqNow(args) : withLock(() => eqNow(args));
}
function eqNow(args: string[]): Out {
  const [sub, ...rest] = args;
  const say = (r: SyncResult, text: string, extra: object = {}) => {
    const g = readGraph();
    return { json: { ok: true, action: r.action, pending: r.pending, ...eqReport(r.plan, r.running, g), ...extra },
             text: text + (r.pending ? " (the filter sleeps while nothing plays and takes it when sound comes)" : ""),
             osd: { icon: "volume-high", message: loadSound().enabled ? `Equalizer on: ${r.plan.presetName}` : "Equalizer off" } };
  };
  const saveSound = (patch: Partial<Sound>) => { const s2 = { ...loadSound(), ...patch }; saveJson("sound.json", s2); };
  switch (sub) {
    case undefined: case "show": {
      const g = readGraph();
      const plan = soundPlan(g);
      const rep = eqReport(plan, !!eqNode(g), g);
      const lines = [`EQ ${rep.enabled ? (rep.running ? "on" : "on, but not running") : "off"}${plan.device ? `, for ${g.outputs.find((d) => d.name === plan.device)?.label}` : ""}: ${plan.presetName}`,
        `preamp ${plan.preamp} dB (${rep.preampMode})${rep.balance ? `, balance ${rep.balance}` : ""}${rep.mono ? ", mono" : ""}${rep.swap ? ", swapped" : ""}`,
        ...plan.bands.map((b, i) => `  ${String(i + 1).padStart(2)}  ${b.type.padEnd(9)} ${String(b.freq).padStart(5)} Hz  ${(b.gain >= 0 ? "+" : "") + b.gain.toFixed(1)} dB  Q ${b.q.toFixed(2)}`),
        ...rep.foreign.map((f) => `warning: another filter sits in front of the output: ${f}`)];
      return { json: { ok: true, ...rep }, text: lines.join("\n") };
    }
    case "on": {
      saveSound({ enabled: true });
      const r = eqSync({ force: true });
      // The output was brought down when the equalizer went off; with the preamp back it comes back, if untouched.
      const changes: string[] = [];
      if (r.running) compensateBack(readGraph(), changes);
      return say(r, `EQ on (${r.action}): ${r.plan.presetName}${changes.length ? `; ${changes.join("; ")}` : ""}`, { changes });
    }
    case "off": {
      const before = soundPlan(readGraph());
      const wasOn = loadSound().enabled;
      // Without the preamp the output would be louder by that much at once: the device is brought down first,
      // and only then does the filter go neutral, so there is no moment in between that is louder.
      const changes: string[] = [];
      if (wasOn && before.preamp < 0 && !loadCompensation()) {
