        if (d) compensateDown(d, before.preamp, changes, "so the loudness stays the same with the equalizer off");
      }
      saveSound({ enabled: false });
      const r = eqSync();
      return say(r, `EQ off: the filter passes the sound unchanged${r.running ? " and keeps running, so nothing that plays is interrupted" : ""}${changes.length ? `; ${changes.join("; ")}` : ""}`, { changes });
    }
    case "stop": {
      // The preamp goes with the process: the device comes down by it first, as when the equalizer goes off, so
      // stopping is never louder. With the equalizer still on, the next apply starts it again and brings it back.
      const changes: string[] = [];
      const g0 = readGraph();
      const pre = soundPlan(g0).preamp;
      if (eqNode(g0) && loadSound().enabled && pre < 0 && !loadCompensation()) {
        const d = g0.outputs.find((x) => x.isDefault && !x.filter);
        if (d) compensateDown(d, pre, changes, "so the loudness stays the same without the equalizer");
      }
      const r = eqSync({ stop: true });
      return say(r, `${r.action === "stopped" ? "EQ process stopped; players on it may pause" : "EQ process was not running"}${changes.length ? `; ${changes.join("; ")}` : ""}`, { changes });
    }
    case "restart": { const r = eqSync({ restart: true, force: true }); return say(r, `EQ ${r.action}`); }
    case "sync": { const r = eqSync({ force: true }); return say(r, `EQ ${r.action}`); }
    case "preset": {
      const [op, ...more] = rest;
      if (!op || op === "list") {
        const g = readGraph(); const plan = soundPlan(g); const store = loadPresets().presets;
        const names = Object.keys(allPresets());
        return { json: { ok: true, presets: names.map((n) => ({ name: n, builtin: !(n in store) && n in BUILTIN_PRESETS, current: n === plan.presetName })) },
                 text: names.map((n) => `${n === plan.presetName ? "*" : " "} ${n}${n in store ? "" : "  (built in)"}`).join("\n") };
      }
      if (op === "use") {
        const [name, ...dev] = more;
        if (!name || !(name in allPresets())) throw new Fail(`no preset called "${name ?? ""}"; ballroom eq preset list`, EXIT.notFound);
        const g = readGraph(); const d = eqTarget(g, dev);
        const devices = loadDevices(); (devices.devices[d.name] ??= {}).eq = name; saveJson("devices.json", devices);
        const r = eqSync(); return say(r, `${d.label}: ${name}${d.isDefault ? "" : " (applies when it is the default)"}`);
      }
      if (op === "save") {
        const name = clean(more.join(" ")).trim().slice(0, 40);
        if (!name || name in BUILTIN_PRESETS) throw new Fail("usage: ballroom eq preset save NAME (not the name of a built-in preset)", EXIT.usage);
        const g = readGraph(); const plan = soundPlan(g);
        const store = loadPresets(); store.presets[name] = { preamp: plan.preset.preamp, bands: plan.bands };
        saveJson("presets.json", store);
        if (plan.device) { const devices = loadDevices(); (devices.devices[plan.device] ??= {}).eq = name; saveJson("devices.json", devices); }
        return { json: { ok: true, saved: name }, text: `saved as ${name}` };
      }
      if (op === "rm") {
        const name = more.join(" ");
        const store = loadPresets();
        if (!(name in store.presets)) throw new Fail(name in BUILTIN_PRESETS ? `${name} is built in` : `no preset called "${name}"`, EXIT.notFound);
        delete store.presets[name]; saveJson("presets.json", store);
        const devices = loadDevices();
        for (const d of Object.values(devices.devices)) if (d.eq === name) delete d.eq;
        saveJson("devices.json", devices);
        const r = eqSync(); return say(r, `removed ${name}`);
      }
      throw new Fail("usage: ballroom eq preset list|use NAME [DEVICE]|save NAME|rm NAME", EXIT.usage);
    }
    case "import": {
      const file = rest[0];
      if (!file) throw new Fail("usage: ballroom eq import FILE [NAME]", EXIT.usage);
      let text: string;
      try { text = readFileSync(file, "utf8"); } catch { throw new Fail(`cannot read ${file}`, EXIT.notFound); }
      const preset = parseAutoEq(text);
      const name = clean(rest.slice(1).join(" ") || file.split("/").pop()!.replace(/\.txt$/i, "").replace(/ ParametricEQ$/i, "")).trim().slice(0, 40);
      if (name in BUILTIN_PRESETS) throw new Fail(`${name} is the name of a built-in preset`, EXIT.usage);
      const store = loadPresets(); store.presets[name] = preset; saveJson("presets.json", store);
      return { json: { ok: true, imported: name, bands: preset.bands.length, preamp: preset.preamp }, text: `imported ${name}: ${preset.bands.length} filters, preamp ${preset.preamp}` };
    }
    case "band": {
      const [n, freq, gain, q, type] = rest;
      const i = Number(n) - 1;
      if (!Number.isInteger(i) || i < 0 || i >= MAX_BANDS || [freq, gain].some((x) => x === undefined || !isFinite(Number(x))) || (q !== undefined && !(Number(q) > 0))) throw new Fail("usage: ballroom eq band N FREQ GAIN [Q] [peaking|lowshelf|highshelf]", EXIT.usage);
      if (type && !["peaking", "lowshelf", "highshelf"].includes(type)) throw new Fail("a band is peaking, lowshelf or highshelf", EXIT.usage);
      const g = readGraph(); const d = eqTarget(g, []);
      const { name, presets } = editablePreset(g, d);
      const p = presets.presets[name];
      while (p.bands.length <= i) p.bands.push({ type: "peaking", freq: 1000, gain: 0, q: 1 });
      p.bands[i] = clampBand({ type: (type as BandType) ?? p.bands[i].type, freq: Number(freq), gain: Number(gain), q: q !== undefined ? Number(q) : p.bands[i].q });
      checkFits(p.bands);
      saveJson("presets.json", presets);
      if (rest.includes("--later")) return { json: { ok: true, saved: name }, text: "saved" };
      const r = eqSync(); return say(r, `band ${i + 1} of ${name}: ${r.action}`);
    }
    case "preamp": {
      const v = rest[0];
      if (v === undefined || (v !== "auto" && !isFinite(Number(v)))) throw new Fail("usage: ballroom eq preamp DB|auto", EXIT.usage);
      const g = readGraph(); const d = eqTarget(g, []);
      const { name, presets } = editablePreset(g, d);
      presets.presets[name].preamp = v === "auto" ? "auto" : Math.max(-24, Math.min(6, Number(v)));
      saveJson("presets.json", presets);
      const r = eqSync(); return say(r, `preamp of ${name}: ${r.plan.preamp} dB`);
    }
    case "balance": {
      const v = Number(rest[0]);
      if (rest[0] === undefined || !isFinite(v)) throw new Fail("usage: ballroom eq balance -1..1 (0 is the middle)", EXIT.usage);
      saveSound({ balance: Math.max(-1, Math.min(1, Math.round(v * 100) / 100)) });
      const r = eqSync(); return say(r, `balance ${loadSound().balance}${loadSound().enabled ? "" : " (takes effect with the EQ on)"}`);
    }
    case "stereo": {
      if (rest[0] !== "reset") throw new Fail("usage: ballroom eq stereo reset", EXIT.usage);
      saveSound({ balance: 0, mono: false, swap: false });
      const r = eqSync(); return say(r, "balance centered, mono and swap off");
    }
    case "mono": case "swap": {
      const v = rest[0];
      if (!["on", "off"].includes(v ?? "")) throw new Fail(`usage: ballroom eq ${sub} on|off`, EXIT.usage);
      saveSound({ [sub]: v === "on" } as Partial<Sound>);
      const r = eqSync(); return say(r, `${sub} ${v}${loadSound().enabled ? "" : " (takes effect with the EQ on)"}`);
    }
  }
  throw new Fail(`unknown: eq ${sub}`, EXIT.usage);
}

// ---------------------------------------------------------------- stage
// The stage plays radio, SoundCloud and DI.FM without a window of its own. The engine is mpv: headless, idle,
// without a configuration, driven over its JSON IPC socket. ballroom-stage.service runs it, and `play` starts
// the unit when the socket does not answer; pause, stop and next never start it. Its sound is a stream in the
// graph named Ballroom, with Ballroom's level, route and equalizer; mpv's own volume is never touched, or two
// volumes would stack.
//
// Measured on mpv 0.41: the socket answers 150 ms after the start, a local address plays 60 ms after `loadfile`,
// a radio stream in about 1 s, a SoundCloud track about 4 s after yt-dlp resolved its page (2 s); `stop` answers within
// 15 ms while an address that never answers is loading, and a new `loadfile` replaces such an address at once.
// mpv runs with --ytdl=no: with it on, mpv hands every address to yt-dlp first, and a radio stream never plays.
// Turning ytdl on for one file only is a race: mpv loads its ytdl_hook script while the file already opens, and
// under load ffmpeg opens the page before the hook exists. So a SoundCloud page is resolved here with yt-dlp
// (about 2 s) and mpv gets the direct address. mpv-mpris is not loaded: without a session bus it stalls mpv.
//
// A live stream is not paused but stopped and remembered: mpv would keep buffering, and the sound after the
// pause would lag behind the station by the length of the pause (measured: 4 s of pause, 4 s of lag). Playing it
// again tunes in live. A track (SoundCloud) pauses in place.
//
// Every address goes to mpv over the socket, never as a process argument: /proc shows arguments to every local
// user, and a DI.FM address carries the listen key. DI.FM and its sister stations (the AudioAddict network) have
// no free streams any more; with a premium listen key the premium playlist of a channel names its stream, and
// the server checks the key ("Invalid Listen Key"). The key is a secret: it comes in over stdin or a hidden
// prompt, never as an argument (shell history, /proc), it lives in audioaddict.json (0600), every text Ballroom
// prints has it masked, the stream's title in the graph is forced to the channel name so the address never shows
// there, and what Ballroom remembers of a DI.FM stream is the channel, never the address.
type StageKind = "radio" | "soundcloud" | "di" | "url";
type StageItem = { title: string; kind: StageKind; url?: string; subtitle?: string; network?: string; channel?: string; set?: boolean };
type StageStore = { schemaVersion: 1; favorites: StageItem[]; recent: StageItem[] };
const STAGE_UNIT = "ballroom-stage.service";
// node.name and application.name of mpv's stream, from --audio-client-name in the unit.
const STAGE_NODE = "Ballroom";
const STAGE_SOCK = join(RUNTIME, "mpv.sock");
const STAGE_UA = `ballroom/${VERSION} (Omarchy plugin)`;
const AA_API = (BENCH && process.env.BALLROOM_AUDIOADDICT_API) || "https://api.audioaddict.com/v1";
// The networks play here only with a premium listen key: their free playlists point at servers that do not
// resolve, and a third-party player gets an announcement stream instead of music (measured).
const AA_NETWORKS: Record<string, { name: string; host: string }> = {
  di: { name: "DI.FM", host: "listen.di.fm" }, radiotunes: { name: "RadioTunes", host: "listen.radiotunes.com" },
  jazzradio: { name: "JazzRadio", host: "listen.jazzradio.com" }, classicalradio: { name: "ClassicalRadio", host: "listen.classicalradio.com" },
  rockradio: { name: "RockRadio", host: "listen.rockradio.com" }, zenradio: { name: "ZenRadio", host: "listen.zenradio.com" },
};
// The bench serves the API and the playlists itself: {network} in the template is the network's key.
const aaListen = (network: string) => ((BENCH && process.env.BALLROOM_AUDIOADDICT_LISTEN) || "https://{host}").replace("{host}", AA_NETWORKS[network].host).replace("{network}", network);
// The community radio directory. all.api picks a mirror by DNS; two named mirrors follow when it does not answer.
const RADIO_API = BENCH && process.env.BALLROOM_RADIO_API ? [process.env.BALLROOM_RADIO_API]
  : ["https://all.api.radio-browser.info", "https://de1.api.radio-browser.info", "https://de2.api.radio-browser.info"];
const CACHE = join(process.env.XDG_CACHE_HOME ?? join(HOME, ".cache"), "ballroom");
const NOW_FILE = join(RUNTIME, "stage-now.json");

function loadStage(): StageStore {
  return loadJson("stage.json", { schemaVersion: 1, favorites: [], recent: [] } as StageStore, (v) => Array.isArray(v.favorites) && Array.isArray(v.recent));
}
let keyCache: string | null | undefined;
function listenKey(): string | null {
  if (keyCache === undefined) {
    const v = loadJson("audioaddict.json", { schemaVersion: 1, listenKey: "" } as { schemaVersion: 1; listenKey: string }, (x) => typeof x.listenKey === "string");
    keyCache = v.listenKey ? v.listenKey : null;
  }
  return keyCache;
}
// Everything the stage prints goes through this.
function maskKey(text: string): string {
  const k = listenKey();
  return k ? text.split(k).join("…") : text;
}
const hostOf = (url: string) => { try { return new URL(url).host; } catch { return "the server"; } };
const isSoundcloudPage = (url: string) => {
  try { const u = new URL(url); return u.protocol === "https:" && /(^|\.)soundcloud\.com$/.test(u.hostname); } catch { return false; }
};

// In process, so that an address with a key is never a process argument, and so that `ballroom json` starts
// no process for the stage. The address never appears in a message: only its host. Only https, no redirects
// (a redirect could carry the key elsewhere), and at most FETCH_CAP bytes: past that the answer is refused,
// not cut, because a cut list is a different list.
const FETCH_CAP = 1024 * 1024;
async function fetchRaw(url: string, timeout = 12000): Promise<{ status: number; text: string }> {
  if (!BENCH && !url.startsWith("https://")) throw new Fail(`only https is spoken to ${hostOf(url)}`);
  let r: Response;
  try { r = await fetch(url, { headers: { "User-Agent": STAGE_UA }, signal: AbortSignal.timeout(timeout), redirect: "manual" }); }
  catch (e: any) {
    if (e?.name === "TimeoutError") throw new Fail(`no answer from ${hostOf(url)} within ${Math.round(timeout / 1000)} s`, EXIT.timeout);
    throw new Fail(`no answer from ${hostOf(url)}`);
  }
  if (r.status >= 300 && r.status < 400) throw new Fail(`${hostOf(url)} redirects elsewhere; not followed`);
  const reader = r.body?.getReader();
  if (!reader) return { status: r.status, text: "" };
  const chunks: Uint8Array[] = []; let size = 0;
  for (;;) {
    const { done, value } = await reader.read();
    if (done) break;
    size += value.byteLength;
    if (size > FETCH_CAP) { try { await reader.cancel(); } catch { /* closing anyway */ } throw new Fail(`${hostOf(url)} sent more than ${FETCH_CAP / 1024} KiB; refused`); }
    chunks.push(value);
  }
  return { status: r.status, text: new TextDecoder().decode(Buffer.concat(chunks.map((c) => Buffer.from(c)))) };
}
async function fetchText(url: string, timeout = 12000): Promise<string> {
  const r = await fetchRaw(url, timeout);
  if (r.status < 200 || r.status >= 300) throw new Fail(`${hostOf(url)} answered with ${r.status}`);
  return r.text;
}

type AaChannel = { network: string; key: string; name: string; description: string };
const channelItem = (c: AaChannel): StageItem => ({ title: c.name, kind: "di", network: c.network, channel: c.key, subtitle: AA_NETWORKS[c.network].name });
// The channel list from the cache alone, without a fetch: `json` runs every second and starts no process.
function cachedChannels(network: string): StageItem[] | null {
  try {
    const cached = JSON.parse(readFileSync(join(CACHE, `audioaddict-${network}.json`), "utf8"));
    return Array.isArray(cached.channels) ? cached.channels.map(channelItem) : null;
  } catch { return null; }
}
async function aaChannels(network: string): Promise<AaChannel[]> {
  ensureDir(CACHE);
  const file = join(CACHE, `audioaddict-${network}.json`);
  try {
    const cached = JSON.parse(readFileSync(file, "utf8"));
    if (Date.now() - cached.at < 24 * 3600 * 1000 && Array.isArray(cached.channels)) return cached.channels;
  } catch { /* first time, or old */ }
  let list: any[];
  try { list = JSON.parse(await fetchText(`${AA_API}/${network}/channels`)); } catch (e) { if (e instanceof Fail) throw e; throw new Fail(`${AA_NETWORKS[network].name} sent no channel list`); }
  const channels = (Array.isArray(list) ? list : []).filter((c) => c && c.key && c.name)
    .map((c) => ({ network, key: String(c.key), name: clean(String(c.name)), description: clean(String(c.description_short ?? "")).slice(0, 160) }));
  writeFileSync(file, JSON.stringify({ at: Date.now(), channels }) + "\n", { mode: 0o600 });
  return channels;
}

// The stream of a channel: the premium playlist names it, and says so when the key is not accepted.
async function aaStreamUrl(network: string, channel: string, key = listenKey()): Promise<string> {
  if (!key) throw new Fail(`${AA_NETWORKS[network].name} needs a premium listen key: ballroom di key set (your account page on di.fm shows it)`, EXIT.usage);
  // The server answers a wrong key with 403 and the words "Invalid Listen Key" (measured over https).
  const r = await fetchRaw(`${aaListen(network)}/premium_high/${encodeURIComponent(channel)}.pls?listen_key=${encodeURIComponent(key)}`);
  if (r.status === 401 || r.status === 403 || /invalid listen key/i.test(r.text)) throw new Fail(`${AA_NETWORKS[network].name} does not accept the listen key; is the premium subscription active?`);
  if (r.status < 200 || r.status >= 300) throw new Fail(`${AA_NETWORKS[network].name} answered with ${r.status}`);
  const file = /^File1=(.+)$/m.exec(r.text)?.[1]?.trim();
  if (!file || !/^https?:\/\//.test(file)) throw new Fail(`${AA_NETWORKS[network].name} sent no stream for ${channel}`);
  return file;
}

// A key is checked with DI.FM first and written only then; a wrong one never touches the disk.
async function diKeySet(v: string): Promise<void> {
  if (!/^[A-Za-z0-9]{8,64}$/.test(v)) throw new Fail("a listen key is 8 to 64 letters and digits", EXIT.usage);
  await aaStreamUrl("di", (await aaChannels("di"))[0]?.key ?? "trance", v);
  withLock(() => saveJson("audioaddict.json", { schemaVersion: 1, listenKey: v }));
  keyCache = undefined;
}
// A secret from the terminal: a hidden prompt on a TTY, the first line of stdin otherwise (a pipe or a file).
// The shell builtin `read` takes it, so it is never an argument of any process.
async function readSecret(prompt: string): Promise<string> {
  // isatty on the descriptor, not process.stdin: touching process.stdin opens a stream that keeps the process
  // alive until the writer closes the pipe.
  if (isatty(0)) {
    const p = Bun.spawnSync({ cmd: ["sh", "-c", 'printf "%s " "$1" >&2; stty -echo 2>/dev/null; IFS= read -r k; stty echo 2>/dev/null; printf "\\n" >&2; printf "%s" "$k"', "sh", prompt],
                              stdin: "inherit", stdout: "pipe", stderr: "inherit" });
    return p.stdout.toString().trim();
  }
  // The first line only, read straight from the descriptor: the widget writes the key and keeps the pipe open
  // until the process ends, and a stream object on stdin would keep the process waiting for the pipe to close.
  const chunk = Buffer.alloc(4096);
  let buf = "";
  for (;;) {
    let n = 0;
    try { n = readSync(0, chunk, 0, chunk.length, null); }
    catch (e: any) { if (e?.code === "EAGAIN") { Bun.sleepSync(10); continue; } throw e; }
    if (n === 0) break;
    buf += chunk.subarray(0, n).toString();
    const nl = buf.indexOf("\n");
    if (nl >= 0) { buf = buf.slice(0, nl); break; }
    if (buf.length > 4096) break;
  }
  return buf.trim();
}

// ---- mpv over its socket
// One connection, a batch of commands, the answers in the order of the commands (mpv numbers them by request_id).
function mpvIpc(commands: any[][], timeout = 2500): Promise<any[]> {
  return new Promise((resolve, reject) => {
    const answers: any[] = new Array(commands.length);
    let got = 0, buf = "", done = false, sock: any = null;
    const finish = (err?: Error) => { if (done) return; done = true; clearTimeout(timer); if (err) reject(err); else resolve(answers); };
    const timer = setTimeout(() => { try { sock?.end(); } catch { /* closing anyway */ } finish(new Fail("the stage did not answer", EXIT.timeout)); }, timeout);
    Bun.connect({
      unix: STAGE_SOCK,
      socket: {
        open(s) { sock = s; s.write(commands.map((c, i) => JSON.stringify({ command: c, request_id: i + 1 })).join("\n") + "\n"); },
        data(s, chunk) {
          buf += chunk.toString();
          let nl: number;
          while ((nl = buf.indexOf("\n")) >= 0) {
            const line = buf.slice(0, nl); buf = buf.slice(nl + 1);
            let v: any; try { v = JSON.parse(line); } catch { continue; }
            const i = Number(v?.request_id) - 1;
            if (Number.isInteger(i) && i >= 0 && i < commands.length && answers[i] === undefined) { answers[i] = v; got++; }
          }
          if (got === commands.length) { s.end(); finish(); }
        },
        close() { finish(got === commands.length ? undefined : new Fail("the stage closed the connection")); },
        error() { finish(new Fail("the stage did not answer")); },
        connectError() { finish(new Fail("the stage is not running", EXIT.notFound)); },
      },
    }).catch(() => finish(new Fail("the stage is not running", EXIT.notFound)));
  });
}
async function mpvGet(names: string[]): Promise<Record<string, any>> {
  const a = await mpvIpc(names.map((n) => ["get_property", n]));
  const out: Record<string, any> = {};
  names.forEach((n, i) => { out[n] = a[i]?.error === "success" ? a[i].data : undefined; });
  return out;
}
async function mpvCmd(cmd: any[], timeout = 2500): Promise<any> {
  const [a] = await mpvIpc([cmd], timeout);
  if (a?.error !== "success") throw new Fail(`mpv refused ${String(cmd[0])}: ${maskKey(clean(String(a?.error ?? "no answer"))).slice(0, 120)}`);
  return a;
}
const stageInstalled = () => !!Bun.which("mpv");
async function stageRunning(): Promise<boolean> {
  try { await mpvGet(["idle-active"]); return true; } catch { return false; }
}
async function ensureStage(): Promise<void> {
  if (!stageInstalled()) throw new Fail("the stage needs mpv: omarchy pkg add mpv", EXIT.notFound);
  if (await stageRunning()) return;
  ensureDir(RUNTIME);
  const r = run(["systemctl", "--user", "start", STAGE_UNIT], 8000);
  if (r.rc !== 0) throw new Fail(`${STAGE_UNIT} did not start (is it installed? install.sh puts it in place)`);
  const until = Date.now() + 5000;
  while (Date.now() < until) { if (await stageRunning()) return; await Bun.sleep(100); }
  throw new Fail("mpv started but does not answer on its socket");
}

function kindOfPath(path: string): StageKind {
  if (/soundcloud\.com/i.test(path)) return "soundcloud";
  if (/\.(di\.fm|radiotunes\.com|jazzradio\.com|classicalradio\.com|rockradio\.com|zenradio\.com)(:\d+)?\//i.test(path)) return "di";
  return "url";
}
function loadNow(): any | null {
  try { return JSON.parse(readFileSync(NOW_FILE, "utf8")); } catch { return null; }
}
function saveNow(now: object) { writeRuntime("stage-now.json", JSON.stringify(now) + "\n"); }

// What the stage shows. Read from mpv in one connection, plus the stored lists and DI.FM's now-playing.
// Nothing here starts a process: the widget asks every second while the panel is open.
async function stageState() {
  const available = stageInstalled();
  const store = loadStage();
  const now = loadNow();
  let m: Record<string, any> | null = null;
  if (available) {
    try { m = await mpvGet(["idle-active", "core-idle", "pause", "path", "media-title", "metadata/by-key/icy-title", "metadata/by-key/icy-name", "duration", "time-pos", "playlist-count", "paused-for-cache"]); }
    catch { m = null; }
  }
  const running = !!m;
  const loaded = running && m!["idle-active"] === false;
  const path = loaded && typeof m!.path === "string" ? m!.path : "";
  // What Ballroom started is recognised by a hash of the address mpv plays: a DI.FM address carries the key.
  const ours = !!(now && path && now.urlHash === String(Bun.hash(path)));
  // A live stream that Ballroom stopped for a pause, ready to be tuned in again.
  const resting = !!(now && now.paused && running && !loaded);
  const state = !available ? "missing" : !running ? "off"
    : loaded ? (m!.pause === true ? "paused" : m!["core-idle"] === true ? "loading" : "playing")
    : resting ? "paused" : "stopped";
  const kind: StageKind | null = loaded ? (ours ? now.kind : kindOfPath(path)) : resting ? now.kind : null;
  const title = loaded ? (ours ? String(now.title ?? "") : String(m!["media-title"] ?? "")) : resting ? String(now.title ?? "") : "";
  const icy = loaded && typeof m!["metadata/by-key/icy-title"] === "string" ? m!["metadata/by-key/icy-title"].trim() : "";
  let subtitle = icy || ((ours || resting) ? String(now.subtitle ?? "") : "");
  if (!icy && (ours || resting) && now.kind === "di") {
    try {
      const np = JSON.parse(readFileSync(join(RUNTIME, "stage-di-now.json"), "utf8"));
      if (Date.now() - np.at < 120000 && np.channel === now.channel && np.text) subtitle = np.text;
    } catch { /* not fetched yet */ }
  }
  // A live stream: a station, or anything with ICY headers, or something that plays and has no length. While a
  // file is still loading its length is simply unknown, and that is not live.
  const live = kind === "radio" || kind === "di" || (loaded && (typeof m!["metadata/by-key/icy-name"] === "string" || (m!["core-idle"] === false && m!.duration == null)));
  let results: any = null;
  try { results = JSON.parse(readFileSync(join(RUNTIME, "stage-results.json"), "utf8")); } catch { /* no search yet */ }
  const sclist = loadScList();
  const channels = cachedChannels("di");
  // set: a SoundCloud playlist. The panel opens it instead of playing it, so the flag has to travel.
  const show = (i: StageItem) => ({ id: stageId(i), title: maskKey(clean(String(i.title ?? ""))).slice(0, 160), kind: i.kind,
                                    subtitle: maskKey(clean(String(i.subtitle ?? ""))).slice(0, 160), set: i.set === true });
  const queue: Queue | null = (ours || resting) && now?.queue && Array.isArray(now.queue.ids) ? now.queue : null;
  return {
    available, running, state, kind, live, ours,
    title: maskKey(clean(title)).slice(0, 160), subtitle: maskKey(clean(subtitle)).slice(0, 160),
    // What played last, for the row at the top while nothing is loaded: play resumes it.
    lastTitle: !loaded && !resting && now?.title ? maskKey(clean(String(now.title))).slice(0, 160) : "",
    queue: queue ? { length: queue.ids.length, pos: queue.pos } : null,
    position: loaded && typeof m!["time-pos"] === "number" ? Math.round(m!["time-pos"]) : null,
    duration: loaded && !live && typeof m!.duration === "number" ? Math.round(m!.duration) : null,
    playlist: loaded ? Number(m!["playlist-count"] ?? 0) : 0,
    buffering: loaded && m!["paused-for-cache"] === true,
    favorites: store.favorites.map(show), recent: store.recent.slice(0, 8).map(show),
    results: results ? { kind: results.kind, query: maskKey(clean(String(results.query ?? ""))), items: (results.items ?? []).map(show), complete: results.complete !== false } : null,
    // The list of a SoundCloud profile the panel last asked for: which one it is, whose, and when.
    sclist: sclist ? { what: sclist.what, user: sclist.user, at: sclist.at, items: sclist.items.map(show) } : null,
    // Every channel of DI.FM, once the list was fetched (ballroom di channels): the library lists them under
    // DI.FM when no search is showing, each with a star.
    channels: channels ? { network: "di", items: channels.map(show) } : null,
    diKey: !!listenKey(),
  };
}

// The widget names a row by this, not by its position: a search that finishes or a favorite that goes between
// two readings must not make a click play or remove the wrong entry. The id carries no address.
const stageId = (i: StageItem) => String(Bun.hash(`${i.kind}|${i.network ?? ""}|${i.url ?? i.channel ?? ""}`));
// The queue: the list an entry was chosen from (results, favorites, recent or likes), as ids and a position,
