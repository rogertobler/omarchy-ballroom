  ballroom spectrum [--bars N] [--fps N] [--source auto|SERIAL]   one JSON line of bands per frame; a
                               SERIAL of an input reads that microphone, so only do it while someone watches

Add --json to any verb for machine readable output. Add --osd to vol, mute, out, in, eq on|off, play, pause, stop, toggle
or scene use to show the result on Omarchy's on-screen display, the way the media keys do (for key bindings).`;

async function main() {
  const argv = process.argv.slice(2);
  const args = argv.filter((a) => a !== "--json" && a !== "--osd");
  const [verb, ...rest] = args;
  // The bar widget reads `ballroom json` and has to get JSON back on a failure too, not text on stderr.
  const json = argv.includes("--json") || verb === "json";
  const osdWanted = argv.includes("--osd");
  const say = (o: Out) => {
    console.log(json ? JSON.stringify({ ...o.json, warnings: [...new Set([...(o.json.warnings ?? []), ...warnings])] }) : o.text);
    if (osdWanted && o.osd) showOsd(o.osd);
  };
  try {
    switch (verb) {
      case undefined: case "status": say(await verbStatus()); break;
      case "json": console.log(JSON.stringify(await stateJson(readGraph()))); break;
      case "out": say(verbOut(rest)); break;
      case "in": say(verbIn(rest)); break;
      case "vol": case "volume": say(verbVol(rest)); break;
      case "mute": say(verbMute(rest)); break;
      case "route": say(verbRoute(rest)); break;
      case "device": say(verbDevice(rest)); break;
      case "apply": say(verbApply()); break;
      case "_guard": say(verbGuard(rest)); break;
      case "bt": say(verbBt(rest)); break;
      case "eq": say(verbEq(rest)); break;
      case "stage": case "play": case "pause": case "next": case "prev": case "stop": case "toggle": case "seek":
      case "radio": case "sc": case "di": case "fav": say(await verbStage(verb, rest)); break;
      case "scene": say(await verbScene(rest)); break;
      case "doctor": say(await verbDoctor()); break;
      case "_widget-set": console.log(setWidgetSetting(rest[0] ?? "", rest.slice(1).join(" "))); break;
      case "_widget-schema": console.log(JSON.stringify(WIDGET_SETTINGS.filter((w) => !w.own))); break;
      case "spectrum": await verbSpectrum(rest); break;
      case "help": case "-h": case "--help": console.log(HELP); break;
      case "--version": console.log(VERSION); break;
      default: throw new Fail(`unknown verb "${verb}"; ballroom help lists them`, EXIT.usage);
    }
  } catch (e) {
    const code = e instanceof Fail ? e.code : EXIT.failed;
    const message = maskKey(clean(e instanceof Fail ? e.message : "unexpected failure"));
    if (process.env.BALLROOM_DEBUG && e instanceof Error) console.error(e.stack);
    if (json) console.log(JSON.stringify({ ok: false, error: message, code }));
    else console.error(`ballroom: ${message}`);
    process.exit(code);
  }
}

main();
