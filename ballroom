// wrong keyring can open the old ones and leave the session shut, and then only the public tracks come and
// nobody is told why. yt-dlp says when it left some behind (' (N could not be decrypted)', cookies.py:353), and
// only a run that left none behind counts.
function cookieSpecWorks(spec: string): boolean {
  const r = run(["yt-dlp", "--cookies-from-browser", spec, "--cookies", "/dev/null"], 20000);
  const said = `${r.out}\n${r.err}`;
  if (/could not be decrypted/.test(said)) return false;
  const m = /Extracted (\d+) cookies/.exec(said);
  return !!m && Number(m[1]) > 0;
}
function resolveCookieSpec(b: BrowserStore): string | null {
  if (b.browser === "firefox") return cookieSpecWorks(b.value) ? b.value : null;
  for (const k of KEYRINGS) { const spec = `${b.browser}+${k}:${b.profile}`; if (cookieSpecWorks(spec)) return spec; }
  return cookieSpecWorks(b.value) ? b.value : null;
}
// Trying the keyrings costs a second or two per browser, and this sits in front of every search, every list and
// every play, so the answer is kept. Keyed on WHICH stores are signed in, not on when they were last written: a
// browser that is running rewrites its store continuously, and keying on that would re-probe on nearly every
// call and eat the deadline of the very verb the user is waiting for. The keyring of a desktop does not change
// from one hour to the next; a day is the right patience, and a browser that appears or goes drops the memo.
type CookieMemo = { spec: string; store: string; at: number };
let cookieSpecNow: string | null | undefined;
function autoCookieSpec(): string | null {
  if (cookieSpecNow !== undefined) return cookieSpecNow;
  cookieSpecNow = null;
  if (!Bun.which("yt-dlp")) return null;
  const signedIn = browserStores().filter((b) => b.soundcloud);
  const stamp = signedIn.map((b) => b.value).sort().join("|");
  let memo: CookieMemo | null = null;
  try { memo = JSON.parse(readFileSync(join(RUNTIME, "sc-cookies.json"), "utf8")); } catch { /* not resolved yet */ }
  // The memo is read back from a file, so it goes through the same check as a value that was typed.
  if (memo && memo.store === stamp && Date.now() - memo.at < 86400000) {
    cookieSpecNow = cookieSpecOk(memo.spec) ? memo.spec : null;
    return cookieSpecNow;
  }
  let found = "";
  for (const b of signedIn) { const spec = resolveCookieSpec(b); if (spec) { found = spec; break; } }
  try { writeRuntime("sc-cookies.json", JSON.stringify({ spec: found, store: stamp, at: Date.now() })); } catch { /* the memo is a convenience */ }
  if (!found && signedIn.length) warnings.push("a browser is signed in on SoundCloud, but its session could not be unlocked; only public tracks show");
  cookieSpecNow = found || null;
  return cookieSpecNow;
}

// Which browsers keep a cookie store on this machine, and which of them holds a SoundCloud session. Only the
// host column of the store is read, never a cookie value: the answer is a browser name and the profile that
// holds the session, which is exactly what yt-dlp is given. The store is opened read only, so a browser that is
// running keeps it. yt-dlp looks for a Chromium profile under the browser's usual directory only, and a profile
// that lives anywhere else is found by nobody: that is why the profile goes into the setting as a path.
// readable false means the store is there but could not be opened (locked, being written, a schema we do not
// know). That is not the same as "not signed in", and saying the second when the first is true would send the
// user off to sign in to an account they are already signed in to.
type BrowserStore = { browser: string; profile: string; cookies: string; label: string; value: string; soundcloud: boolean; readable: boolean };
const CHROMIUM_ROOTS: Record<string, string[]> = {
  brave: ["BraveSoftware"],
  chrome: ["google-chrome", "google-chrome-beta", "google-chrome-unstable"],
  chromium: ["chromium"],
  edge: ["microsoft-edge", "microsoft-edge-beta", "microsoft-edge-dev"],
  opera: ["opera", "opera-beta", "opera-developer"],
  vivaldi: ["vivaldi", "vivaldi-snapshot"],
};
function listDir(dir: string): string[] {
  try { return readdirSync(dir); } catch { return []; }
}
// How many cookies of soundcloud.com the store holds, or null when it cannot be read (a store that is being
// written, a format we do not know). The table and the column are ours, not the user's.
function soundcloudCookies(file: string, table: string, column: string): number | null {
  try {
    const db = new Database(file, { readonly: true });
    try { return Number((db.query(`select count(*) as n from ${table} where ${column} like '%soundcloud.com'`).get() as any)?.n ?? 0); }
    finally { db.close(); }
  } catch { return null; }
}
function browserStores(): BrowserStore[] {
  const found: BrowserStore[] = [];
  const cfg = process.env.XDG_CONFIG_HOME ?? join(HOME, ".config");
  for (const [browser, roots] of Object.entries(CHROMIUM_ROOTS)) {
    // A browser directory is the one with the Local State beside the profiles: Brave keeps its own one level
    // deeper, under BraveSoftware.
    const dirs: string[] = [];
    for (const r of roots) {
      const base = join(cfg, r);
      if (!existsSync(base)) continue;
      if (existsSync(join(base, "Local State"))) dirs.push(base);
      else for (const d of listDir(base)) if (existsSync(join(base, d, "Local State"))) dirs.push(join(base, d));
    }
    for (const dir of dirs) {
      for (const p of listDir(dir)) {
        if (p !== "Default" && !p.startsWith("Profile ")) continue;
        const file = [join(dir, p, "Network", "Cookies"), join(dir, p, "Cookies")].find((f) => existsSync(f));
        if (!file) continue;
        const n = soundcloudCookies(file, "cookies", "host_key");
        found.push({ browser, profile: join(dir, p), cookies: file, label: `${browser} \u00b7 ${p}`, value: `${browser}:${join(dir, p)}`,
                     soundcloud: (n ?? 0) > 0, readable: n !== null });
      }
    }
  }
  const ff = join(HOME, ".mozilla", "firefox");
  for (const p of listDir(ff)) {
    const file = join(ff, p, "cookies.sqlite");
    if (!existsSync(file)) continue;
    const n = soundcloudCookies(file, "moz_cookies", "host");
    found.push({ browser: "firefox", profile: join(ff, p), cookies: file, label: `firefox \u00b7 ${p.replace(/^\w+\./, "")}`, value: `firefox:${join(ff, p)}`,
                 soundcloud: (n ?? 0) > 0, readable: n !== null });
  }
  // Signed in on SoundCloud first, so the panel and "auto" take one that carries a session.
  return found.sort((a, b) => Number(b.soundcloud) - Number(a.soundcloud) || a.label.localeCompare(b.label));
}

// What a SoundCloud profile holds, as yt-dlp lists it: a flat playlist of titles and page addresses, no length
// (measured: 1 to 2 s for the first entries). The four lists SoundCloud itself offers on a profile. A playlist
// is not a track: it is opened into the results, not played. One list at a time is kept for the panel in the
// runtime directory; the panel asks again after ten minutes.
const SC_LISTS: Record<string, string> = { likes: "likes", playlists: "sets", uploads: "tracks", reposts: "reposts" };
type ScList = { at: number; user: string; what: string; items: StageItem[] };
function loadScList(): ScList | null {
  try {
    const v = JSON.parse(readFileSync(join(RUNTIME, "stage-sc.json"), "utf8"));
    return typeof v?.user === "string" && typeof v?.what === "string" && Array.isArray(v.items) ? v : null;
  } catch { return null; }
}
// Who the browser session belongs to. SoundCloud addresses every list by profile name, and the session does not
// say the name anywhere yt-dlp would read it; but soundcloud.com/you answers a signed-in request with a 301 to
// the profile, and that is the name. Measured: 301, Location //soundcloud.com/<name>.
//
// Say it plainly, because the code cannot make it smaller: yt-dlp has no way to export one site's cookies, so
// the file it writes here holds the WHOLE browser jar in clear text, every site the browser is signed in to
// (measured: 747 entries). Only the soundcloud.com rows are read out of it, but all of them touched the disk.
// Against that: the file is ours before yt-dlp sees it (created with O_EXCL and O_NOFOLLOW at 0600, so no link
// can send it anywhere else), it is removed the moment it has been read and before any request goes out, a
// signal removes it too, and one left by a kill is swept on the next run. It happens once per user: the name it
// finds is kept, and nothing asks again.
function sweepJars() {
  for (const f of readdirSync(RUNTIME).filter((x) => /^sc-jar\.\d+$/.test(x))) {
    const pid = Number(f.slice(7));
    try { process.kill(pid, 0); } catch (e: any) { if (e?.code === "ESRCH") rmSync(join(RUNTIME, f), { force: true }); }
  }
}
async function soundcloudWhoami(): Promise<string | null> {
  const args = ytdlpCookieArgs();
  if (!args.length) return null;
  ensureDir(RUNTIME);
  try { sweepJars(); } catch { /* the sweep is a courtesy to earlier runs */ }
  const jar = join(RUNTIME, `sc-jar.${process.pid}`);
  const drop = () => rmSync(jar, { force: true });
  const bail = () => { drop(); process.exit(EXIT.failed); };
  let header = "";
  process.on("SIGTERM", bail); process.on("SIGINT", bail); process.on("SIGHUP", bail);
  try {
    // Ours, not a link, readable by nobody else: O_EXCL fails on anything that is already there, so a link put
    // in the way beforehand cannot be followed.
    // It carries the one line that makes it an empty cookie jar. yt-dlp LOADS the file it is told to write
    // before it writes it, and an empty file is not a jar: it stopped with "does not look like a Netscape
    // format cookies file" and wrote nothing, which left the account nameless with everything else in order.
    try {
      const fd = openSync(jar, FS.O_CREAT | FS.O_EXCL | FS.O_WRONLY | FS.O_NOFOLLOW, 0o600);
      try { writeSync(fd, "# Netscape HTTP Cookie File\n"); } finally { closeSync(fd); }
    } catch { return null; }
    run(["yt-dlp", "--no-warnings", ...args, "--cookies", jar, "--skip-download", "--simulate", "--", "https://soundcloud.com/discover"], 30000);
    let text = ""; try { text = readFileSync(jar, "utf8"); } catch { return null; }
    const pairs: string[] = [];
    for (const line of text.split("\n")) {
      if (!line || line.startsWith("#")) continue;
      const f = line.split("\t");
      if (f.length >= 7 && /soundcloud\.com$/.test(f[0].replace(/^\./, ""))) pairs.push(`${f[5]}=${f[6]}`);
    }
    header = pairs.join("; ");
