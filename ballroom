// Auto headroom: the curve's highest point, never above 0 dB after the preamp.
function autoPreamp(bands: Band[]): number {
  let peak = 0;
  for (let i = 0; i <= 240; i++) peak = Math.max(peak, bandsDb(bands, 20 * Math.pow(1000, i / 240)));
  // Never below -24 dB: a preset can stack bands, and a preamp without a floor would become the jump it is
  // there to prevent when the equalizer goes off.
  return Math.max(-24, -Math.ceil(peak * 10) / 10) || 0;
}

type EqPlan = { device: string | null; presetName: string; preset: Preset; bands: Band[]; preamp: number; matrix: number[]; bypass: boolean };
function soundPlan(g: Graph, sound = loadSound()): EqPlan {
  const def = g.outputs.find((d) => d.isDefault && !d.filter) ?? null;
  const presets = allPresets();
  const wanted = def ? loadDevices().devices[def.name]?.eq : undefined;
  const presetName = wanted && presets[wanted] ? wanted : "Flat";
  const preset = presets[presetName];
  const bands = preset.bands.slice(0, MAX_BANDS).map(clampBand);
  while (bands.length < SLOTS.length) bands.push({ type: "peaking", freq: 1000, gain: 0, q: 1 });
  const preamp = preset.preamp === "auto" ? autoPreamp(bands) : Math.max(-24, Math.min(6, Number(preset.preamp)));
  // Balance takes from one side only; mono sums at half each; swap crosses. [LL, LR, RL, RR]: out channel, in channel.
  const l = Math.min(1, 1 - sound.balance), r = Math.min(1, 1 + sound.balance);
  const base = sound.mono ? [0.5, 0.5, 0.5, 0.5] : sound.swap ? [0, 1, 1, 0] : [1, 0, 0, 1];
  const matrix = [base[0] * l, base[1] * l, base[2] * r, base[3] * r].map((x) => Math.round(x * 1000) / 1000);
  return { device: def?.name ?? null, presetName, preset, bands, preamp, matrix, bypass: !sound.enabled };
}

// A preset fits the fixed graph when no kind of filter needs more slots than there are.
function checkFits(bands: Band[]) {
  for (const t of Object.keys(SLOT_COUNT) as BandType[]) {
    const n = bands.filter((b) => b.type === t && b.gain !== 0).length;
    if (n > SLOT_COUNT[t]) throw new Fail(`${n} ${t} filters; the equalizer has room for ${SLOT_COUNT[t]}`, EXIT.usage);
  }
}

// Every control of the fixed graph. Bands fill the slots of their kind in order; a slot without a band, and
// every slot when the equalizer is off, stands at 0 dB. Off also means preamp 0 and a straight matrix.
function slotBands(plan: EqPlan): { name: string; type: BandType; band: Band }[] {
  const out: { name: string; type: BandType; band: Band }[] = [];
  const used: Record<BandType, Band[]> = { peaking: [], lowshelf: [], highshelf: [] };
  if (!plan.bypass) for (const b of plan.bands) if (b.gain !== 0 && used[b.type].length < SLOT_COUNT[b.type]) used[b.type].push(b);
  for (const t of ["lowshelf", "peaking", "highshelf"] as BandType[]) {
    for (let i = 0; i < SLOT_COUNT[t]; i++) {
      const neutral: Band = { type: t, freq: t === "lowshelf" ? 100 : t === "highshelf" ? 10000 : 1000, gain: 0, q: t === "peaking" ? 1 : 0.7 };
      out.push({ name: `${SLOT_PREFIX[t]}${i}`, type: t, band: used[t][i] ?? neutral });
    }
  }
  return out;
}
function eqControls(plan: EqPlan): Record<string, number> {
