#!/usr/bin/python3 -I
# Ballroom command. One program for the bar widget (JSON) and the terminal; the code is ballroom_cmd.py beside
# this file, and this file only finds it and runs it, so that Python can keep it compiled.
#
# The interpreter is named by its path and runs isolated (-I): PYTHON* variables, the user's site directory and
# the directory of this file never reach the module search path. The module is loaded from its file by path, not
# by name through sys.path: nothing else in this directory can be imported by it, so a json.py or any other file
# put beside the command never stands in for a module of the standard library, and no module of the same name
# elsewhere on the path is taken for ours. realpath: ~/.local/bin/ballroom is a link into the plugin folder.
#
# The compiled module is kept in $XDG_CACHE_HOME/ballroom/pyc (~/.cache/ballroom/pyc), never beside the code: the
# plugin folder is a checkout that stays as it came. The cache root is this user's and writable by nobody else, the
# two directories below it are this user's own, 0700, and not links, and every use goes through their
# descriptors; a cache that is not so is not used, and neither is one that cannot be made. Then nothing is kept and the command runs
# all the same, only slower to start. Only this module is kept there, by this file and not through
# sys.pycache_prefix: the prefix moves the bytecode of every module imported after it, the standard library's
# too, and the first start then compiles some fifty of them again (measured: about 480 ms instead of 200 ms).
import os
import sys


def _private_dir(name, parent_fd):
    """The directory NAME inside PARENT_FD, made if missing, opened without following a link, and only if it is
    this user's own and closed to everyone else. Everything after this goes through the descriptor, so a parent
    renamed or replaced after the check cannot redirect what is read or written."""
    try:
        os.mkdir(name, 0o700, dir_fd=parent_fd)
    except FileExistsError:
        pass
    fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=parent_fd)
    st = os.fstat(fd)
    if st.st_uid != os.getuid() or st.st_mode & 0o077:
        os.close(fd)
        raise OSError(f"{name} is not a private directory of this user")
    return fd


def _bytecode_cache():
    """A descriptor of $XDG_CACHE_HOME/ballroom/pyc, or None. The cache root itself may be a link, as ~/.cache
    often is, but it must belong to this user and be writable by nobody else."""
    base = os.environ.get("XDG_CACHE_HOME") or os.path.join(os.environ.get("HOME") or "/nonexistent", ".cache")
    if not os.path.isabs(base):
        return None
    fds = []
    try:
        fds.append(os.open(base, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC))
        st = os.fstat(fds[-1])
        if st.st_uid != os.getuid() or st.st_mode & 0o022:
            return None
        fds.append(_private_dir("ballroom", fds[-1]))
        pyc = _private_dir("pyc", fds[-1])
        return pyc
    except OSError:
        return None
    finally:
        for fd in fds:
            os.close(fd)


def _code(path, pyc):
    """The module compiled, from the cache when the cache was made from exactly these source bytes by this
    Python, else compiled now and, with a cache, kept for the next start. The match is a digest of the bytes read
    here, not their size and time: a checkout can write another version with the same size within one tick of the
    clock. Only this module's code is kept there: the standard library keeps using the compiled files it was
    installed with."""
    import hashlib
    import marshal
    import types
    with open(path, "rb") as f:
        source = f.read()
    digest = hashlib.sha256(source).hexdigest()
    stamp = f"{sys.implementation.cache_tag} {digest} {path}\n".encode("utf-8", "surrogateescape")
    keep = "ballroom_cmd.bin"
    if pyc is not None:
        try:
            fd = os.open(keep, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=pyc)
            with os.fdopen(fd, "rb") as f:
                if os.fstat(f.fileno()).st_uid == os.getuid() and f.readline() == stamp:
                    code = marshal.loads(f.read())
                    if isinstance(code, types.CodeType):
                        return code
        except (OSError, ValueError, EOFError, TypeError):
            pass  # none yet, damaged, or from another source or Python
    code = compile(source, path, "exec", dont_inherit=True)
    if pyc is not None:
        temp = f"{keep}.{os.getpid()}.{os.urandom(8).hex()}"
        try:
            fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600, dir_fd=pyc)
            with os.fdopen(fd, "wb") as f:
                f.write(stamp + marshal.dumps(code))
            os.rename(temp, keep, src_dir_fd=pyc, dst_dir_fd=pyc)
        except OSError:
            pass  # the next start compiles again
        finally:
            try:
                os.remove(temp, dir_fd=pyc)
            except OSError:
                pass
    return code


def _run():
    import types
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "ballroom_cmd.py")
    module = types.ModuleType("ballroom_cmd")
    module.__file__ = path
    sys.modules["ballroom_cmd"] = module
    pyc = _bytecode_cache()
    try:
        code = _code(path, pyc)
    finally:
        if pyc is not None:
            os.close(pyc)
    exec(code, module.__dict__)
    module.entry()


try:
    _run()
except SystemExit:
    raise
except BaseException:
    # Outside the bench nothing leaves as a trace; the command says it failed, as it does for any surprise.
    if os.environ.get("BALLROOM_BENCH") == "1" and os.environ.get("BALLROOM_DEBUG"):
        raise
    try:
        sys.stderr.write("ballroom: unexpected failure\n")
    except Exception:
        pass
    os._exit(120)
