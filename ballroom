  try {
    const res = await fetch("https://soundcloud.com/you", { redirect: "manual", headers: { cookie: header, "user-agent": STAGE_UA },
                                                            signal: AbortSignal.timeout(15000) });
    location = res.headers.get("location") ?? "";
  } catch { return null; }
  // Anchored: only soundcloud.com itself names the profile, not a host that merely carries the words.
  const m = /^(?:https?:)?\/\/soundcloud\.com\/([A-Za-z0-9_.-]{1,64})\/?$/.exec(location.trim());
  return m ? m[1] : null;
}

// One page of a profile, flat. A track keeps its uploader as the subtitle, a playlist how many tracks it holds.
function soundcloudPage(url: string, what: string, who?: string): StageItem[] {
  if (!Bun.which("yt-dlp")) throw new Fail("SoundCloud needs yt-dlp: omarchy pkg add yt-dlp", EXIT.notFound);
  const r = run(["yt-dlp", "--no-warnings", "--flat-playlist", "-J", "--playlist-items", "1-200", ...ytdlpCookieArgs(), "--", url], 60000);
  if (r.timedOut) throw new Fail("SoundCloud did not answer within 45 s", EXIT.timeout);
  if (r.rc !== 0) throw new Fail(/404/.test(r.err) ? (who ? `SoundCloud knows no profile called ${who}` : "SoundCloud knows no such playlist")
                                                   : `yt-dlp could not read the ${what} (is it up to date? is the profile public?)`);
  let v: any; try { v = JSON.parse(r.out); } catch { throw new Fail("yt-dlp sent no list"); }
  return (Array.isArray(v?.entries) ? v.entries : [])
    .filter((e: any) => e && /^https:\/\/soundcloud\.com\/[^/?#]+\//.test(String(e.url ?? "")))
    .map((e: any) => {
      const u = String(e.url);
      const set = /\/sets\//.test(u);
      return { title: clean(String(e.title ?? "")).trim().slice(0, 120) || "untitled", kind: "soundcloud" as const, url: u, set: set || undefined,
               subtitle: set ? `playlist${typeof e.playlist_count === "number" ? `, ${e.playlist_count} tracks` : ""}`
                             : clean(decodeURIComponent(u.split("/")[3] ?? "")).slice(0, 60) };
    });
}

// One of the four lists a profile offers. Likes and reposts hold both tracks and playlists; uploads only tracks;
// playlists only playlists.
function soundcloudList(what: string, userArg: string): ScList {
  if (!Object.hasOwn(SC_LISTS, what)) throw new Fail(`no such list "${what}"; one of ${Object.keys(SC_LISTS).join(", ")}`, EXIT.usage);
  const user = (userArg || String(widgetValues().soundcloudUser ?? "")).trim();
  if (!user) throw new Fail("no SoundCloud name: ballroom sc name NAME, or ballroom sc whoami with a signed-in browser", EXIT.usage);
  if (!/^[A-Za-z0-9_.-]{1,64}$/.test(user)) throw new Fail("a SoundCloud name is letters, digits, dots, dashes and underscores", EXIT.usage);
  const items = soundcloudPage(`https://soundcloud.com/${user}/${SC_LISTS[what]}`, what, user);
  const list: ScList = { at: Date.now(), user, what, items };
  writeRuntime("stage-sc.json", JSON.stringify(list) + "\n");
  return list;
}

// A playlist is opened, not played: its tracks become the results, so they scroll, star and walk with next and
// prev like any other search.
function soundcloudOpen(item: StageItem): StageItem[] {
  // Only a SoundCloud playlist. Every list can hold an address from somewhere else (a radio result carries
  // whatever the open directory says), and this call hands the address to yt-dlp with the browser session
  // attached: it must never be pointed anywhere but the site the session belongs to.
  if (item.kind !== "soundcloud" || item.set !== true || !/^https:\/\/soundcloud\.com\//.test(String(item.url ?? "")))
    throw new Fail("that is not a SoundCloud playlist", EXIT.usage);
  const items = soundcloudPage(item.url, "playlist").filter((x) => !x.set);
  if (!items.length) throw new Fail("that playlist holds no tracks that can be played", EXIT.notFound);
  writeRuntime("stage-results.json", JSON.stringify({ kind: "soundcloud", query: item.title, items, complete: true }) + "\n");
  return items;
}

function remember(item: StageItem) { withLock(() => rememberNow(item)); }
function rememberNow(item: StageItem) {
  const store = loadStage();
  const same = (a: StageItem) => a.kind === item.kind && (a.url ?? a.channel) === (item.url ?? item.channel) && a.network === item.network;
  store.recent = [item, ...store.recent.filter((x) => !same(x))].slice(0, 20);
  saveJson("stage.json", store);
}

// Loads the address over the socket and reports what mpv does with it, up to 15 s: playing, replaced by
// another address meanwhile, or failed. Only what played gets into the recent list.
async function stagePlay(item: StageItem, queue: Queue | null = null): Promise<{ state: string }> {
  await ensureStage();
  let url = item.url ?? "";
  if (item.kind === "di") url = await aaStreamUrl(item.network!, item.channel!);
  if (!/^https?:\/\//.test(url)) throw new Fail("the stage plays http and https addresses", EXIT.usage);
  // An address that carries the listen key is only ever the one DI.FM hands out for a channel; anything else
  // with the key in it would end up in the lists and in every answer.
  const key = listenKey();
  if (item.kind !== "di" && key && url.includes(key)) throw new Fail("that address carries the listen key; play the channel with ballroom di play", EXIT.usage);
  if (item.kind === "soundcloud") url = resolveSoundCloud(url);
  // The title mpv shows, in the graph too: the item's name, never the address.
  const options: Record<string, string> = { "force-media-title": clean(item.title).slice(0, 120) || "Stage" };
  // pause is a global switch in mpv and would carry over from a paused track to the next address.
  const [, a] = await mpvIpc([["set_property", "pause", false], ["loadfile", url, "replace", -1, options]], 5000);
  if (a?.error !== "success") throw new Fail(`mpv did not take the address: ${maskKey(clean(String(a?.error ?? "no answer"))).slice(0, 120)}`);
  const entry = Number(a?.data?.playlist_entry_id ?? 0);
  // What is remembered: the channel for DI.FM (never the address with the key), the page for SoundCloud (the
  // direct address expires), the address itself otherwise.
  const stored: StageItem = { ...item, url: item.kind === "di" ? undefined : item.kind === "soundcloud" ? item.url : url };
  saveNow({ ...stored, urlHash: String(Bun.hash(url)), paused: false, queue: queue && queue.ids.length > 1 ? queue : undefined });
  let state = "loading";
  const until = Date.now() + 15000;
  while (Date.now() < until) {
    const m = await mpvGet(["idle-active", "core-idle", "playlist/0/id"]);
    if (m["idle-active"] === true) { state = "failed"; break; }
    if (Number(m["playlist/0/id"]) !== entry) { state = "replaced"; break; }
    if (m["core-idle"] === false) { state = "playing"; break; }
    await Bun.sleep(150);
  }
  if (state === "playing") remember(stored);
  if (state === "failed") throw new Fail(`${item.title}: the stream could not be played (no answer from the server, or not a sound stream)`);
  return { state };
}

// The direct address behind a SoundCloud page. It expires after a while, so it is resolved on every play and
// never kept; the page address is what favorites and the recent list remember.
function resolveSoundCloud(page: string): string {
  if (!Bun.which("yt-dlp")) throw new Fail("SoundCloud needs yt-dlp: omarchy pkg add yt-dlp", EXIT.notFound);
  const r = run(["yt-dlp", "--no-warnings", "-g", "-f", "bestaudio/best", ...ytdlpCookieArgs(), "--", page], 30000);
  if (r.timedOut) throw new Fail("SoundCloud did not answer within 30 s", EXIT.timeout);
  const direct = r.out.split("\n").map((l) => l.trim()).find((l) => /^https?:\/\//.test(l));
  if (r.rc !== 0 || !direct) throw new Fail("yt-dlp could not resolve the SoundCloud page (is it up to date? is the track public?)");
  return direct;
}

// What plays right now, as an item that can be kept: what Ballroom started, or what mpv reports otherwise.
async function stageNowItem(): Promise<StageItem | null> {
  const st = await stageState();
  const now = loadNow();
  const strip = (n: any): StageItem => { const { urlHash, paused, ...item } = n; void urlHash; void paused; return item; };
  if (!st.running) return null;
  if (st.ours && now) return strip(now);
  // A live stream Ballroom stopped for a pause.
  if (st.state === "paused" && now && now.paused) return strip(now);
  if (st.state === "playing" || st.state === "loading" || st.state === "paused") {
    const m = await mpvGet(["path"]);
    const path = typeof m.path === "string" ? m.path : "";
    if (!path) return null;
    const key = listenKey();
    if (kindOfPath(path) === "di" || (key && path.includes(key))) throw new Fail("what plays carries a listen key in its address; play the channel with ballroom di play to keep it", EXIT.usage);
    return { title: st.title || path.replace(/^https?:\/\//, "").slice(0, 80), kind: kindOfPath(path), url: path };
  }
  return null;
}

const mmss = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, "0")}`;

async function radioSearch(q: string, offset = 0): Promise<any[]> {
  const params = new URLSearchParams({ name: q, limit: String(PAGE), offset: String(offset), hidebroken: "true", order: "clickcount", reverse: "true" });
  for (const base of RADIO_API) {
    try {
      const list = JSON.parse(await fetchText(`${base}/json/stations/search?${params}`, 8000));
      if (Array.isArray(list)) return list;
    } catch { /* the next mirror */ }
  }
  throw new Fail("the radio directory (radio-browser.info) did not answer");
}

// PAGE results at a time (measured: the directory answers forty as fast as fifteen, SoundCloud takes about
// twice as long for forty); `more` fetches the next page of the same search and appends it. The results file
// says whether a further page can come (`complete`): the directory takes an offset, SoundCloud is asked for a
// longer list, DI.FM is complete at once.
const PAGE = 40;
async function stageSearch(kind: "radio" | "soundcloud" | "di", query: string, more = false): Promise<StageItem[]> {
  const q = clean(query).trim();
  if (!q) throw new Fail("search for what?", EXIT.usage);
  if (q.length > 200) throw new Fail("that search is too long", EXIT.usage);
  let previous: StageItem[] = [];
  if (more) {
    let old: any = null;
    try { old = JSON.parse(readFileSync(join(RUNTIME, "stage-results.json"), "utf8")); } catch { /* nothing to add to */ }
    if (old && old.kind === kind && old.query === q && Array.isArray(old.items)) { if (old.complete) return old.items; previous = old.items; }
  }
  let items: StageItem[] = [];
  let complete = true;
  if (kind === "di") {
    const words = q.toLowerCase().split(/\s+/);
    for (const network of Object.keys(AA_NETWORKS)) {
      for (const c of await aaChannels(network)) {
        const hay = `${c.name} ${c.key} ${AA_NETWORKS[network].name}`.toLowerCase();
        if (words.every((w) => hay.includes(w))) items.push({ title: c.name, kind: "di", network, channel: c.key, subtitle: AA_NETWORKS[network].name });
      }
    }
    items = items.slice(0, 60);
  } else if (kind === "radio") {
    const page = await radioSearch(q, previous.length);
    complete = page.length < PAGE;
    items = page.filter((s) => s && /^https?:\/\//.test(String(s.url_resolved || s.url || ""))).map((s) => ({
      title: clean(String(s.name ?? "")).trim().slice(0, 120) || "unnamed station", kind: "radio" as const, url: String(s.url_resolved || s.url),
      subtitle: [s.codec ? `${clean(String(s.codec))}${s.bitrate ? ` ${Number(s.bitrate)}k` : ""}` : "", clean(String(s.country ?? "")).slice(0, 40)].filter(Boolean).join(" · "),
    }));
  } else {
    if (!Bun.which("yt-dlp")) throw new Fail("SoundCloud needs yt-dlp: omarchy pkg add yt-dlp", EXIT.notFound);
    const want = previous.length + PAGE;
    // No session on the search: it costs 2.8 s to unlock the cookie store on every keystroke that comes to rest,
    // and it buys nothing here. Measured: two identical searches return different results either way, so the
    // difference between signed in and not cannot be told apart from that. The lists keep their session, where
    // it demonstrably adds the private entries.
    const r = run(["yt-dlp", "--no-warnings", "--flat-playlist", "-J", `scsearch${want}:${q}`], 60000 + previous.length * 500);
    if (r.timedOut) throw new Fail("SoundCloud did not answer within 45 s", EXIT.timeout);
    if (r.rc !== 0) throw new Fail("yt-dlp could not search SoundCloud (is it up to date?)");
    let v: any; try { v = JSON.parse(r.out); } catch { throw new Fail("yt-dlp sent no results"); }
    const entries = Array.isArray(v?.entries) ? v.entries : [];
    complete = entries.length < want;
    // Only SoundCloud's own pages: a result is later handed to yt-dlp with the browser's cookies, and those are
    // for SoundCloud alone.
    items = entries.filter((e: any) => e && isSoundcloudPage(String(e.webpage_url || e.url || ""))).map((e: any) => ({
      title: clean(String(e.title ?? "")).trim().slice(0, 120) || "untitled", kind: "soundcloud" as const, url: String(e.webpage_url || e.url),
      subtitle: [clean(String(e.uploader ?? "")).slice(0, 60), typeof e.duration === "number" ? mmss(e.duration) : ""].filter(Boolean).join(" · "),
    }));
  }
  if (previous.length) {
    const seen = new Set(previous.map(stageId));
    items = [...previous, ...items.filter((i) => !seen.has(stageId(i)))];
  }
  writeRuntime("stage-results.json", JSON.stringify({ kind, query: q, items, complete }) + "\n");
  return items;
}

function stageResult(n: string): StageItem {
  let results: any;
  try { results = JSON.parse(readFileSync(join(RUNTIME, "stage-results.json"), "utf8")); } catch { throw new Fail("search first: ballroom radio search …", EXIT.notFound); }
  const i = Number(n) - 1;
  const item = results.items?.[i];
  if (!Number.isInteger(i) || !item) throw new Fail(`no result ${n}; the last search had ${results.items?.length ?? 0}`, EXIT.notFound);
  return item;
}

async function stageDiNow(): Promise<string> {
  const now = loadNow();
  if (!now || now.kind !== "di") return "";
  let list: any;
  try { list = JSON.parse(await fetchText(`${AA_API}/${now.network}/currently_playing`)); } catch (e) { if (e instanceof Fail) throw e; throw new Fail("no now-playing list"); }
  const entry = (Array.isArray(list) ? list : []).find((x: any) => x.channel_key === now.channel);
  const t = entry?.track;
  const text = t ? clean(`${t.display_artist ?? ""}${t.display_artist && t.display_title ? " · " : ""}${t.display_title ?? ""}`).slice(0, 140) : "";
  writeRuntime("stage-di-now.json", JSON.stringify({ at: Date.now(), channel: now.channel, text }) + "\n");
  return text;
}

async function stageOut(extra: object, text: string): Promise<Out> {
  const state = await stageState();
  return { json: { ok: true, ...extra, stage: state }, text: maskKey(text),
           osd: { icon: "volume-high", message: state.title ? `Stage ${state.state}: ${state.title}` : `Stage ${state.state}` } };
}

// Resume: a paused track continues, a stopped live stream is tuned in again, otherwise the last thing played.
async function stageResume(): Promise<Out> {
  const st = await stageState();
  if (st.state === "paused" && st.running && (await mpvGet(["idle-active"]))["idle-active"] === false) {
    await mpvCmd(["set_property", "pause", false]);
    await Bun.sleep(200);
    return stageOut({}, `resumed: ${(await stageState()).state}`);
  }
  const now = loadNow();
  const item: StageItem | null = now ? (({ urlHash, paused, ...rest }) => { void urlHash; void paused; return rest; })(now) : loadStage().recent[0] ?? null;
  if (!item) throw new Fail("nothing to resume; ballroom play URL, or search first", EXIT.notFound);
  const r = await stagePlay(item);
  return stageOut({ played: item.title, state: r.state }, `${item.title}: ${r.state}`);
}

async function stagePause(): Promise<Out> {
  const st = await stageState();
  if (!st.running) return stageOut({}, "nothing plays: the stage is off");
  if (st.state === "playing" || st.state === "loading") {
    if (st.live) {
      await mpvCmd(["stop"]);
      const now = loadNow();
      if (now && st.ours) saveNow({ ...now, paused: true });
    } else await mpvCmd(["set_property", "pause", true]);
    await Bun.sleep(200);
  }
  return stageOut({}, `pause: ${(await stageState()).state}`);
}

async function verbStage(verb: string, args: string[]): Promise<Out> {
  const [sub, ...rest] = args;
  switch (verb) {
    case "stage": {
      if (!sub || sub === "status") {
        const st = await stageState();
        const line = !st.available ? "stage: mpv is not installed (omarchy pkg add mpv)"
          : !st.running ? "stage: off (ballroom play starts it)"
          : `stage: ${st.state}${st.title ? `, ${st.title}${st.subtitle ? ` · ${st.subtitle}` : ""}` : ""}`;
        return { json: { ok: true, stage: st }, text: maskKey([line, ...st.favorites.map((f, i) => `  ★${i + 1}  ${f.title}  (${f.kind})`)].join("\n")) };
      }
      if (sub === "start") { await ensureStage(); return stageOut({}, "the stage is running"); }
      if (sub === "quit") {
        run(["systemctl", "--user", "stop", STAGE_UNIT], 8000);
        const until = Date.now() + 3000;
        while (Date.now() < until && await stageRunning()) await Bun.sleep(100);
        return stageOut({}, (await stageRunning()) ? "mpv still answers on the stage socket (not started by the unit?)" : "the stage is off");
      }
      if (sub === "refresh") return stageOut({ now: await stageDiNow() }, "refreshed");
      if (sub === "clear") { rmSync(join(RUNTIME, "stage-results.json"), { force: true }); return stageOut({}, "results cleared"); }
      throw new Fail("usage: ballroom stage [status|start|quit|refresh|clear]", EXIT.usage);
    }
    case "play": {
      const what = args.join(" ").trim();
      if (!what) return stageResume();
      let item: StageItem;
      let queue: Queue | null = null;
      if (/^https?:\/\//.test(what)) item = { title: what.replace(/^https?:\/\//, "").slice(0, 80), kind: kindOfPath(what), url: what };
      else if (/^\*\d+$/.test(what) || /^fav\s+\d+$/.test(what)) { const i = Number(what.replace(/\D/g, "")) - 1; const favs = loadStage().favorites; if (!favs[i]) throw new Fail(`no favorite ${i + 1}`, EXIT.notFound); item = favs[i]; queue = queueOf(favs, i); }
      else if (/^~\d+$/.test(what)) { const i = Number(what.slice(1)) - 1; const rec = loadStage().recent; if (!rec[i]) throw new Fail(`nothing played ${i + 1} ago`, EXIT.notFound); item = rec[i]; queue = queueOf(rec, i); }
      else if (/^#?\d+$/.test(what)) { const n = Number(what.replace("#", "")); item = stageResult(String(n)); queue = queueOf(stageLists()[0].items, n - 1); }
      else if (/^id:\d+$/.test(what)) { const found = stageLocate(what.slice(3)); if (!found) throw new Fail("that entry is gone", EXIT.notFound); item = found.item; queue = found.queue; }
      else {
        const favs = loadStage().favorites;
        const i = favs.findIndex((x) => x.title.toLowerCase().includes(what.toLowerCase()));
        if (i < 0) throw new Fail(`nothing called "${what}" in the favorites; ballroom radio search ${what}`, EXIT.notFound);
        item = favs[i]; queue = queueOf(favs, i);
      }
      if (item.kind === "di" && kindOfPath(item.url ?? "") === "di") throw new Fail("a DI.FM address is not played directly (it carries the key): ballroom di play CHANNEL", EXIT.usage);
      const r = await stagePlay(item, queue);
      return stageOut({ played: item.title, state: r.state }, `${item.title}: ${r.state === "playing" ? "playing" : `${r.state} (streams can take a few seconds)`}`);
    }
    case "pause": return stagePause();
    case "toggle": {
      const st = await stageState();
      return st.state === "playing" || st.state === "loading" ? stagePause() : stageResume();
    }
    case "stop": {
      if (!(await stageRunning())) return stageOut({}, "nothing plays: the stage is off");
      await mpvCmd(["stop"]);
      const now = loadNow();
      if (now && now.paused) saveNow({ ...now, paused: false });
      await Bun.sleep(200);
      return stageOut({}, `stop: ${(await stageState()).state}`);
    }
    case "next": case "prev": {
      if (!(await stageRunning())) return stageOut({}, "nothing plays: the stage is off");
      const step = verb === "next" ? 1 : -1;
      // A playlist inside mpv comes first; otherwise the queue, the list the entry was chosen from.
      const m = await mpvGet(["playlist-count"]);
      if (Number(m["playlist-count"] ?? 0) > 1) {
        let moved = true;
        try { await mpvCmd([verb === "next" ? "playlist-next" : "playlist-prev"]); } catch { moved = false; }
        await Bun.sleep(200);
        return stageOut({ moved }, moved ? `${verb}: ${(await stageState()).state}` : `nothing ${step > 0 ? "after" : "before"} this one`);
      }
      const now = loadNow();
      const q: Queue | null = now?.queue && Array.isArray(now.queue.ids) ? now.queue : null;
      const pos = q ? q.pos + step : -1;
      if (!q || pos < 0 || pos >= q.ids.length) return stageOut({ moved: false }, `nothing ${step > 0 ? "after" : "before"} this one`);
      // A list can hold playlists between its tracks; they are opened, not played, so the walk steps over them.
      let at = pos, found = stageLocate(q.ids[at]);
      while (found && found.item.set === true) {
        at += step;
        if (at < 0 || at >= q.ids.length) return stageOut({ moved: false }, `nothing ${step > 0 ? "after" : "before"} this one`);
        found = stageLocate(q.ids[at]);
      }
      if (!found) return stageOut({ moved: false }, "the next entry is gone from its list");
      const r = await stagePlay(found.item, { ids: q.ids, pos: at });
      return stageOut({ moved: true, played: found.item.title, state: r.state }, `${found.item.title}: ${r.state}`);
    }
    case "seek": {
      const what = (sub ?? "").trim();
      if (!/^[+-]?\d+$/.test(what)) throw new Fail("usage: ballroom seek SECONDS | +N | -N", EXIT.usage);
      const st = await stageState();
      if (!st.running || (st.state !== "playing" && st.state !== "paused" && st.state !== "loading")) return stageOut({}, "nothing plays");
      if (st.live) throw new Fail("a live stream has no position to seek to", EXIT.usage);
      if (/^[+-]/.test(what)) await mpvCmd(["seek", what, "relative"]);
      else await mpvCmd(["set_property", "time-pos", Number(what)]);
      await Bun.sleep(150);
      const after = await stageState();
      return stageOut({ position: after.position, duration: after.duration }, `at ${after.position ?? 0} s of ${after.duration ?? 0}`);
    }
    case "radio": case "sc": case "di": {
      const kind = verb === "sc" ? "soundcloud" : verb as "radio" | "di";
      if (verb === "di" && sub === "key") {
        const v = rest.join("").trim();
        if (!v) return { json: { ok: true, diKey: !!listenKey() }, text: listenKey() ? "a listen key is set (not shown); ballroom di key set replaces it, and a single dash instead of a key removes it" : "no listen key; ballroom di key set" };
        if (v === "-") { withLock(() => saveJson("audioaddict.json", { schemaVersion: 1, listenKey: "" })); keyCache = undefined; return { json: { ok: true, diKey: false }, text: "listen key removed" }; }
        if (v !== "set") throw new Fail("the key is not taken as an argument (it would land in the shell history and in the process list): ballroom di key set, then type or pipe it", EXIT.usage);
        const k = await readSecret("DI.FM listen key:");
        if (!k) throw new Fail("no key given", EXIT.usage);
        await diKeySet(k);
        return { json: { ok: true, diKey: true }, text: "listen key accepted by DI.FM, and kept (not shown)" };
      }
      if (verb === "di" && (sub === "channels" || sub === "list")) {
        const nets = rest[0] ? [rest[0]] : Object.keys(AA_NETWORKS);
        for (const n of nets) if (!AA_NETWORKS[n]) throw new Fail(`no network ${n}; one of ${Object.keys(AA_NETWORKS).join(", ")}`, EXIT.usage);
        const all: AaChannel[] = []; for (const n of nets) all.push(...await aaChannels(n));
        return { json: { ok: true, channels: all }, text: all.map((c) => `${AA_NETWORKS[c.network].name.padEnd(15)} ${c.name}`).join("\n") };
      }
      if (verb === "di" && sub === "play") {
        const q = rest.join(" ").trim().toLowerCase();
        const all: AaChannel[] = []; for (const n of Object.keys(AA_NETWORKS)) all.push(...await aaChannels(n));
        const c = all.find((x) => x.key === q || x.name.toLowerCase() === q) ?? all.find((x) => x.name.toLowerCase().includes(q));
        if (!q || !c) throw new Fail(`no channel "${q}"; ballroom di search ${q}`, EXIT.notFound);
        const item: StageItem = { title: c.name, kind: "di", network: c.network, channel: c.key, subtitle: AA_NETWORKS[c.network].name };
        const r = await stagePlay(item);
        return stageOut({ played: c.name, state: r.state }, `${AA_NETWORKS[c.network].name} ${c.name}: ${r.state}`);
      }
      if (verb === "sc" && (sub === "browsers" || sub === "cookies")) {
        if (sub === "browsers") {
          const found = browserStores();
          // The path stays here: the panel names a browser and the command knows where that browser keeps it.
          return { json: { ok: true, browsers: found.map(({ browser, label, soundcloud, readable }) => ({ browser, label, soundcloud, readable })) },
                   text: found.length ? found.map((b) => `  ${b.soundcloud ? "\u2605" : " "} ${b.label}${b.readable ? "" : "  (its store could not be opened)"}`).join("\n")
                                      : "no browser keeps a cookie store here" };
        }
        const want = rest.join(" ").trim();
        const shown = () => { const v = String(widgetValues().soundcloudCookies ?? "").trim(); return v.split(":")[0] || "none"; };
        if (!want) return { json: { ok: true, cookies: shown() }, text: shown() === "none" ? "no browser named; ballroom sc cookies auto" : `cookies from ${shown()}` };
        if (want === "-") { setWidgetValue("soundcloudCookies", ""); return { json: { ok: true, cookies: "none" }, text: "no cookies are read any more" }; }
        // auto: the first store that carries a SoundCloud session. A browser named by hand is matched against
        // what was found, so the profile comes along; a name nothing matches is kept as it was typed.
        const found = browserStores();
        const pick = want === "auto" ? found.find((b) => b.soundcloud)
          : found.find((b) => b.browser === want.toLowerCase() && b.soundcloud) ?? found.find((b) => b.browser === want.toLowerCase());
        if (want === "auto" && !pick) throw new Fail("no browser here is signed in on SoundCloud; sign in in the browser, or name it: ballroom sc cookies brave", EXIT.notFound);
        if (!pick && !cookieSpecOk(want)) throw new Fail("that is not a browser name like brave, or brave:/path/to/profile", EXIT.usage);
        // The same walk the automatic choice takes: a Chromium store from version 11 on needs the keyring, and
        // the plain browser:profile spec reads none of it (measured: 0 of 747 cookies without it). Keeping the
        // spec without asking stored something that could never work, and the account came back nameless.
        let value = pick ? pick.value : want;
        if (pick && Bun.which("yt-dlp")) {
          const spec = resolveCookieSpec(pick);
          if (!spec) throw new Fail(`the cookie store of ${pick.browser} could not be unlocked; unlock your keyring, or name the profile: ballroom sc name NAME`, EXIT.notFound);
          value = spec;
        } else if (pick) warnings.push("yt-dlp is not installed, so the browser session could not be tried; it is kept as it is");
        setWidgetValue("soundcloudCookies", value);
        return { json: { ok: true, cookies: pick ? pick.browser : want, soundcloud: pick ? pick.soundcloud : null },
                 text: pick ? `cookies from ${pick.label}${pick.soundcloud ? ", signed in on SoundCloud" : ", no SoundCloud session in it"}` : `cookies from ${want}` };
      }
      if (verb === "sc" && sub === "whoami") {
        const who = await soundcloudWhoami();
        if (!who) throw new Fail("the browser session does not say who it belongs to; name the profile: ballroom sc name NAME", EXIT.notFound);
        if (rest[0] !== "--show") setWidgetValue("soundcloudUser", who);
        return { json: { ok: true, user: who }, text: who };
      }
      if (verb === "sc" && sub === "name") {
        const want = rest.join(" ").trim();
        if (!want) { const v = String(widgetValues().soundcloudUser ?? "").trim(); return { json: { ok: true, user: v }, text: v || "no name; ballroom sc name NAME, or ballroom sc whoami with a signed-in browser" }; }
        if (want === "-") { setWidgetValue("soundcloudUser", ""); return { json: { ok: true, user: "" }, text: "the name is gone" }; }
        if (!/^[A-Za-z0-9_.-]{1,64}$/.test(want)) throw new Fail("a SoundCloud name is letters, digits, dots, dashes and underscores", EXIT.usage);
        setWidgetValue("soundcloudUser", want);
        return { json: { ok: true, user: want }, text: want };
      }
      if (verb === "sc" && (sub === "likes" || sub === "list")) {
        // sc list [WHAT] [NAME]: named, the list has to be one of the four, or a profile name would silently be
        // taken for a list and the wrong page fetched.
        const what = sub === "likes" ? "likes" : rest.length ? String(rest.shift()) : "likes";
        const r = soundcloudList(what, rest.join(" "));
        return stageOut({ what, count: r.items.length, user: r.user },
          r.items.length ? r.items.map((x, i) => `  ${String(i + 1).padStart(2)}  ${x.title}${x.subtitle ? `  · ${x.subtitle}` : ""}`).join("\n") : `nothing in the ${what} of ${r.user}`);
      }
      if (verb === "sc" && sub === "open") {
        const id = /^id:\d+$/.test(rest[0] ?? "") ? rest[0]!.slice(3) : "";
        const item = id ? stageById(id) : null;
        if (!item) throw new Fail("name a playlist by its id: ballroom sc open id:N", EXIT.notFound);
        const items = soundcloudOpen(item);
        return stageOut({ opened: item.title, tracks: items.length }, `${item.title}: ${items.length} tracks`);
      }
      if (sub === "search") {
        const more = rest.includes("--more");
        const items = await stageSearch(kind, rest.filter((w) => w !== "--more").join(" "), more);
        return stageOut({ results: items.length }, items.length ? items.map((x, i) => `  ${String(i + 1).padStart(2)}  ${x.title}${x.subtitle ? `  · ${x.subtitle}` : ""}`).join("\n") : "nothing found");
      }
      if (sub === "play") {
        const r0 = stageResult(rest[0] ?? "");
        const r = await stagePlay(r0);
        return stageOut({ played: r0.title, state: r.state }, `${r0.title}: ${r.state}`);
      }
      throw new Fail(`usage: ballroom ${verb} search QUERY | ${verb} play N${verb === "di" ? " | di channels [NETWORK] | di play CHANNEL | di key [set|-]" : verb === "sc" ? " | sc list [likes|playlists|uploads|reposts] [NAME] | sc open id:N | sc browsers | sc cookies [auto|BROWSER|-] | sc name [NAME|-] | sc whoami" : ""}`, EXIT.usage);
    }
    case "fav": return withLockAsync(async () => favNow(sub, rest));
  }
  throw new Fail(`unknown verb ${verb}`, EXIT.usage);
}
async function favNow(sub: string | undefined, rest: string[]): Promise<Out> {
  {
    {
      const store = loadStage();
      if (!sub || sub === "list") return stageOut({}, store.favorites.map((f, i) => `  ★${i + 1}  ${f.title}  (${f.kind})`).join("\n") || "no favorites; ballroom fav add");
      if (sub === "add") {
        let item: StageItem | null = null;
        if (rest[0] && /^id:\d+$/.test(rest[0])) { item = stageById(rest[0].slice(3)); if (!item) throw new Fail("that entry is gone", EXIT.notFound); }
        else if (rest[0] && /^#?\d+$/.test(rest[0])) item = stageResult(rest[0].replace("#", ""));
        else item = await stageNowItem();
        if (!item) throw new Fail("nothing to add: play something, or name a search result (ballroom fav add 3)", EXIT.notFound);
        // A favorite is something that plays. A playlist is opened, and a kept playlist would have no answer to
        // the question what it should play.
        if (item.set === true) throw new Fail("a playlist is opened, not kept: ballroom sc open id:N, then keep a track from it", EXIT.usage);
        const same = (a: StageItem) => a.kind === item!.kind && (a.url ?? a.channel) === (item!.url ?? item!.channel) && a.network === item!.network;
        // A SoundCloud hit is kept by its page address, which is resolved again when it plays.
        if (!store.favorites.some(same)) store.favorites.push({ ...item });
        saveJson("stage.json", store);
        return stageOut({ added: item.title }, `★ ${item.title}`);
      }
      if (sub === "rm") {
        const i = /^id:\d+$/.test(rest[0] ?? "") ? store.favorites.findIndex((f) => stageId(f) === rest[0]!.slice(3)) : Number(rest[0]) - 1;
        if (!store.favorites[i]) throw new Fail(`no favorite ${rest[0] ?? ""}`, EXIT.notFound);
        const [gone] = store.favorites.splice(i, 1); saveJson("stage.json", store);
        return stageOut({ removed: gone.title }, `removed ${gone.title}`);
      }
      if (sub === "play") { return verbStage("play", [`*${rest[0] ?? ""}`]); }
      throw new Fail("usage: ballroom fav [list|add [N]|rm N|play N]", EXIT.usage);
    }
  }
}

// ---------------------------------------------------------------- desk: scenes, diagnosis, keys
// A scene is what the desk is set to: the default output and input, the level and mute of every device, the
// equalizer and its preset, the mode and codec of Bluetooth devices, and what the stage plays. `scene use`
// brings the graph back to it, in this order: output (with its cap and its preset), levels, input, equalizer,
// Bluetooth, stage. Everything is read back afterwards (rule 1), and what is not there right now is skipped and
// named, not invented. An input is never unmuted by a scene: a scene may close a microphone, never open one.
type SceneLevel = { volume: number; mute: boolean };
type Scene = {
  savedAt: string; defaultOutput: string | null; defaultInput: string | null;
  outputs: Record<string, SceneLevel>; inputs: Record<string, SceneLevel>;
  eq: { enabled: boolean; preset: string | null };
  bt: Record<string, { mode: "music" | "call" | "off"; codec: string | null }>;
  stage: StageItem | null;
};
type Scenes = { schemaVersion: 1; scenes: Record<string, Scene> };

function loadScenes(): Scenes {
  return loadJson("scenes.json", { schemaVersion: 1, scenes: {} } as Scenes, (v) => isObject(v.scenes));
}
// A scene name is a label, not a path: printable, short, no tab (lists key rows by it).
function sceneName(raw: string): string {
  const name = raw.trim();
  if (!name) throw new Fail("a scene needs a name: ballroom scene save NAME", EXIT.usage);
  if (/[\x00-\x1f\x7f-\x9f]/.test(name)) throw new Fail("a scene name has no control characters", EXIT.usage);
  if (name.length > 40) throw new Fail("a scene name is at most 40 characters", EXIT.usage);
  return name;
}
const sceneLevel = (d: Device): SceneLevel => ({ volume: Math.round(d.volume * 100) / 100, mute: d.mute });

async function sceneCapture(g: Graph): Promise<Scene> {
  const outputs: Record<string, SceneLevel> = {}; const inputs: Record<string, SceneLevel> = {};
  for (const d of g.outputs.filter((x) => !x.filter)) outputs[d.name] = sceneLevel(d);
  for (const d of g.inputs.filter((x) => !x.filter)) inputs[d.name] = sceneLevel(d);
  const bt: Scene["bt"] = {};
  for (const b of btDevices(g)) bt[b.address] = { mode: btModeNow(b), codec: btCodecNow(b) };
  let stage: StageItem | null = null;
  try { stage = await stageNowItem(); } catch { stage = null; }
  const plan = soundPlan(g);
  return { savedAt: new Date().toISOString(), defaultOutput: g.defaultSink, defaultInput: g.defaultSource,
           outputs, inputs, eq: { enabled: loadSound().enabled, preset: plan.device ? plan.presetName : null }, bt, stage };
}

function sceneSummary(g: Graph, s: Scene): string {
  const label = (name: string | null, list: Device[]) => name ? (list.find((d) => d.name === name)?.label ?? name) : "none";
  return [`${label(s.defaultOutput, g.outputs)}${s.defaultOutput && s.outputs[s.defaultOutput] ? ` ${percent(s.outputs[s.defaultOutput].volume)} %` : ""}`,
          `${Object.keys(s.outputs).length} outputs`, s.eq.enabled ? `eq ${s.eq.preset ?? ""}`.trim() : "eq off",
          s.stage ? `stage: ${s.stage.title}` : "stage off"].join(" · ");
}

// Applies a scene and reports every step; a device or preset that is not there is skipped by name.
async function sceneApply(name: string): Promise<{ applied: string[]; skipped: string[]; mismatched: string[] }> {
  const s = loadScenes().scenes[name];
  if (!s) throw new Fail(`no scene "${name}"; ballroom scene list`, EXIT.notFound);
  const applied: string[] = [], skipped: string[] = [], mismatched: string[] = [];
  const attempt = (what: string, f: () => void) => { try { f(); applied.push(what); } catch (e) { skipped.push(`${what}: ${e instanceof Fail ? e.message : "failed"}`); } };
  let g = readGraph();
  const present = (name: string, list: Device[]) => list.find((d) => d.name === name && !d.filter);
  // 1. The default output, through the verb: cap first, then the equalizer follows with the device's preset.
  if (s.defaultOutput) {
    const d = present(s.defaultOutput, g.outputs);
    if (!d) skipped.push(`output ${s.defaultOutput}: not present`);
    else if (!d.isDefault) attempt(`output ${d.label}`, () => { verbOut([d.name]); });
  }
  g = readGraph();
  // 2. Levels and mutes of every output the scene knows and the graph has.
  for (const [n, lv] of Object.entries(s.outputs)) {
    const d = present(n, g.outputs);
    if (!d) { skipped.push(`output ${n}: not present`); continue; }
    if (Math.abs(d.volume - lv.volume) > 0.005) attempt(`${d.label} ${percent(lv.volume)} %`, () => setVolume(d.name, lv.volume));
    if (d.mute !== lv.mute) attempt(`${d.label} ${lv.mute ? "muted" : "unmuted"}`, () => setMute(d.id, lv.mute));
  }
  // 3. The default input through its verb (a muted microphone stays muted), then levels; never an unmute.
  if (s.defaultInput) {
    const d = present(s.defaultInput, g.inputs);
    if (!d) skipped.push(`input ${s.defaultInput}: not present`);
    else if (!d.isDefault) attempt(`input ${d.label}`, () => { verbIn([d.name]); });
  }
  g = readGraph();
  for (const [n, lv] of Object.entries(s.inputs)) {
    const d = present(n, g.inputs);
    if (!d) { skipped.push(`input ${n}: not present`); continue; }
    if (Math.abs(d.volume - lv.volume) > 0.005) attempt(`${d.label} ${percent(lv.volume)} %`, () => setVolume(d.name, lv.volume));
    if (lv.mute && !d.mute) attempt(`${d.label} muted`, () => setMute(d.id, true));
    else if (!lv.mute && d.mute) skipped.push(`${d.label}: stays muted (a scene never opens a microphone)`);
  }
  // 4. The equalizer: the preset of the default output, then on or off, each one change and one click.
  if (s.eq.preset && s.eq.preset in allPresets()) {
    if (soundPlan(readGraph()).presetName !== s.eq.preset) attempt(`equalizer preset ${s.eq.preset}`, () => { verbEq(["preset", "use", s.eq.preset!]); });
  } else if (s.eq.preset) skipped.push(`equalizer preset ${s.eq.preset}: no such preset`);
  if (loadSound().enabled !== s.eq.enabled) attempt(`equalizer ${s.eq.enabled ? "on" : "off"}`, () => { verbEq([s.eq.enabled ? "on" : "off"]); });
  // 5. Bluetooth: mode and codec, each a guarded profile switch.
  g = readGraph();
  for (const [address, want] of Object.entries(s.bt)) {
    const b = btDevices(g).find((x) => x.address === address);
    if (!b) { skipped.push(`Bluetooth device ${address.replace(/[0-9A-Fa-f]{2}(?=(:|$))/g, "xx")}: not connected`); continue; }
    if (want.mode !== "off" && btModeNow(b) !== want.mode) attempt(`${b.label} ${want.mode} mode`, () => { if (!btSetMode(b, want.mode as "music" | "call").ok) throw new Fail("did not switch"); });
    if (want.codec && want.mode === "music") {
      const now = btDevices(readGraph()).find((x) => x.address === address);
      if (now && (btCodecNow(now) ?? "").toLowerCase() !== want.codec.toLowerCase()) attempt(`${b.label} codec ${want.codec}`, () => { if (!btSetCodec(now, want.codec!).ok) throw new Fail("did not switch"); });
    }
  }
  // 6. The stage: play what the scene played, or stop what plays when the scene had nothing.
  if (s.stage) {
    if (!stageInstalled()) skipped.push(`stage: ${s.stage.title} (mpv is not installed)`);
    else { try { const r = await stagePlay(s.stage); applied.push(`stage: ${s.stage.title} (${r.state})`); } catch (e) { skipped.push(`stage: ${s.stage.title}: ${e instanceof Fail ? e.message : "failed"}`); } }
  } else if (await stageRunning()) {
    const st = await stageState();
    if (st.state === "playing" || st.state === "loading" || st.state === "paused") { try { await mpvCmd(["stop"]); const now = loadNow(); if (now?.paused) saveNow({ ...now, paused: false }); applied.push("stage: stopped"); } catch { skipped.push("stage: could not stop"); } }
  }
  // Rule 1: what the graph says now, against the scene.
  const after = readGraph();
  if (s.defaultOutput && present(s.defaultOutput, after.outputs) && after.defaultSink !== s.defaultOutput) mismatched.push(`default output is ${after.defaultSink ?? "none"}`);
  if (s.defaultInput && present(s.defaultInput, after.inputs) && after.defaultSource !== s.defaultInput) mismatched.push(`default input is ${after.defaultSource ?? "none"}`);
  for (const [n, lv] of Object.entries(s.outputs)) { const d = present(n, after.outputs); if (d && (Math.abs(d.volume - lv.volume) > 0.02 || d.mute !== lv.mute)) mismatched.push(`${d.label} is at ${percent(d.volume)} %${d.mute ? " muted" : ""}`); }
  return { applied, skipped, mismatched };
}

async function verbScene(args: string[]): Promise<Out> {
  const [sub, ...rest] = args;
  if (sub === "save" || sub === "rm" || sub === "use") return withLockAsync(() => sceneNow(args));
  return sceneNow(args);
}
async function sceneNow(args: string[]): Promise<Out> {
  const [sub, ...rest] = args;
  const store = loadScenes();
  const g = readGraph();
  if (!sub || sub === "list") {
    const names = Object.keys(store.scenes).sort();
    return { json: { ok: true, scenes: names.map((n) => ({ name: n, savedAt: store.scenes[n].savedAt, summary: sceneSummary(g, store.scenes[n]) })) },
             text: names.length ? names.map((n) => `  ${n.padEnd(24)} ${sceneSummary(g, store.scenes[n])}`).join("\n") : "no scenes; ballroom scene save NAME keeps what is set now" };
  }
  if (sub === "save") {
    const name = sceneName(rest.join(" "));
    const scene = await sceneCapture(g);
    store.scenes[name] = scene;
    saveJson("scenes.json", store);
    return { json: { ok: true, saved: name, scene }, text: `scene ${name}: ${sceneSummary(g, scene)}` };
  }
  if (sub === "show") {
    const name = sceneName(rest.join(" "));
    const s = store.scenes[name];
    if (!s) throw new Fail(`no scene "${name}"; ballroom scene list`, EXIT.notFound);
    const label = (n: string, list: Device[]) => list.find((d) => d.name === n)?.label ?? `${n} (not present)`;
    const lines = [`scene ${name}, saved ${s.savedAt.slice(0, 16).replace("T", " ")}`,
      `  output  ${s.defaultOutput ? label(s.defaultOutput, g.outputs) : "none"}`, `  input   ${s.defaultInput ? label(s.defaultInput, g.inputs) : "none"}`,
      ...Object.entries(s.outputs).map(([n, lv]) => `  out ${label(n, g.outputs).padEnd(28)} ${String(percent(lv.volume)).padStart(3)} %${lv.mute ? "  muted" : ""}`),
      ...Object.entries(s.inputs).map(([n, lv]) => `  in  ${label(n, g.inputs).padEnd(28)} ${String(percent(lv.volume)).padStart(3)} %${lv.mute ? "  muted" : ""}`),
      `  eq      ${s.eq.enabled ? `on, ${s.eq.preset ?? "no preset"}` : "off"}`,
      ...Object.entries(s.bt).map(([a, b]) => `  bt      ${btDevices(g).find((x) => x.address === a)?.label ?? "a device that is not connected"}: ${b.mode}${b.codec ? `, ${b.codec}` : ""}`),
      `  stage   ${s.stage ? `${s.stage.title} (${s.stage.kind})` : "nothing"}`];
    return { json: { ok: true, name, scene: s }, text: maskKey(lines.join("\n")) };
  }
  if (sub === "rm") {
    const name = sceneName(rest.join(" "));
    if (!store.scenes[name]) throw new Fail(`no scene "${name}"`, EXIT.notFound);
    delete store.scenes[name]; saveJson("scenes.json", store);
    return { json: { ok: true, removed: name }, text: `removed scene ${name}` };
  }
  if (sub === "use") {
    const name = sceneName(rest.join(" "));
    const r = await sceneApply(name);
    const text = [`scene ${name}: ${r.applied.length ? r.applied.join(", ") : "nothing to change"}`,
      ...r.skipped.map((x) => `  skipped: ${x}`), ...r.mismatched.map((x) => `  not as saved: ${x}`)].join("\n");
    return { json: { ok: true, used: name, ...r }, text: maskKey(text), osd: { icon: "volume-high", message: `Scene ${name}` } };
  }
  throw new Fail("usage: ballroom scene [list|save NAME|use NAME|show NAME|rm NAME]", EXIT.usage);
}

// ---- diagnosis
type Check = { key: string; state: "ok" | "warn" | "bad"; text: string };
const DUMMY_SINK = "auto_null";
const CHECK_GLYPH: Record<Check["state"], string> = { ok: "✓", warn: "!", bad: "✗" };

// Where the names of the nodes a node feeds are read: the equalizer's output should feed the default output.
function feeds(g: Graph, nodeName: string): string[] {
  const byId = new Map(g.objects.filter((o) => o.type === "PipeWire:Interface:Node").map((o) => [o.id, String(o.info?.props?.["node.name"] ?? "")]));
  const from = [...byId.entries()].find(([, n]) => n === nodeName)?.[0];
  if (from === undefined) return [];
  return [...new Set(g.objects.filter((o) => o.type === "PipeWire:Interface:Link" && o.info?.["output-node-id"] === from).map((o) => byId.get(o.info["input-node-id"]) ?? "?"))];
}

// The fragments a user or another plugin put into PipeWire's and WirePlumber's drop-in directories. One that
// builds a filter is worth knowing about: Ballroom has none, and two filters in front of one output stack.
function filterFragments(): string[] {
  const base = process.env.XDG_CONFIG_HOME ?? join(HOME, ".config");
  const dirs = [join(base, "wireplumber", "wireplumber.conf.d"), join(base, "pipewire", "pipewire.conf.d"), join(base, "pipewire", "filter-chain.conf.d")];
  const found: string[] = [];
  for (const dir of dirs) {
    let names: string[] = [];
    try { names = readdirSync(dir).filter((f) => f.endsWith(".conf")); } catch { continue; }
    for (const f of names) {
      try { const text = readFileSync(join(dir, f), "utf8"); if (/filter-chain|filter\.smart/.test(text)) found.push(join(dir, f).replace(HOME, "~")); } catch { /* unreadable, not ours to judge */ }
    }
  }
  return found;
}

// pw-top's one shot: the ERR column counts xruns per node. Columns are read by the header's positions, because
// the FORMAT column is empty for a node that does not run and would shift a split by whitespace.
function xruns(): { total: number; nodes: string[]; available: boolean } {
  const r = run(["pw-top", "-b", "-n", "1"], 4000);
  if (r.rc !== 0 || r.timedOut) return { total: 0, nodes: [], available: false };
  const lines = r.out.split("\n");
  const header = lines.find((l) => /\bERR\b/.test(l) && /\bNAME\b/.test(l));
  if (!header) return { total: 0, nodes: [], available: false };
  const errFrom = header.indexOf("B/Q") + 3, errTo = header.indexOf("FORMAT"), nameAt = header.indexOf("NAME");
  let total = 0; const nodes: string[] = [];
  for (const l of lines.slice(lines.indexOf(header) + 1)) {
    if (l.length < nameAt) continue;
    const err = Number(l.slice(errFrom, errTo).trim());
    if (!Number.isFinite(err) || err <= 0) continue;
    total += err; nodes.push(`${clean(l.slice(nameAt).trim())} (${err})`);
  }
  return { total, nodes, available: true };
}

async function doctor(): Promise<Check[]> {
  const checks: Check[] = [];
  const add = (key: string, state: Check["state"], text: string) => checks.push({ key, state, text: clean(text) });
  const t0 = Date.now();
  const g = readGraph();
  add("graph", "ok", `PipeWire answers, ${g.objects.length} objects in ${Date.now() - t0} ms`);
  const wp = g.objects.some((o) => o.type === "PipeWire:Interface:Client" && o.info?.props?.["application.process.binary"] === "wireplumber")
          && g.objects.some((o) => o.type === "PipeWire:Interface:Metadata" && o.props?.["metadata.name"] === "default");
  add("wireplumber", wp ? "ok" : "bad", wp ? "WirePlumber is connected and holds the defaults" : "WirePlumber is not connected: no defaults, no routing");
  const pulse = run(["pactl", "info"], 2000);
  add("pulse", pulse.rc === 0 ? "ok" : pulse.rc === 127 ? "warn" : "bad", pulse.rc === 0 ? "pipewire-pulse answers" : pulse.rc === 127 ? "pactl is not installed, pipewire-pulse not checked" : "pipewire-pulse does not answer: applications that speak PulseAudio have no sound");
  const units = run(["systemctl", "--user", "is-active", "pipewire", "wireplumber", "pipewire-pulse", EQ_UNIT, STAGE_UNIT], 3000);
  if (units.rc === 127 || units.timedOut) add("units", "warn", "systemd --user is not reachable; the services were not checked");
  else {
    const names = ["pipewire", "wireplumber", "pipewire-pulse", EQ_UNIT, STAGE_UNIT];
    const states = units.out.trim().split("\n");
    const core = names.slice(0, 3).map((n, i) => `${n} ${states[i] ?? "?"}`);
    const coreOk = states.slice(0, 3).every((s) => s === "active");
    add("units", coreOk ? "ok" : "warn", `${core.join(", ")}; ${EQ_UNIT} ${states[3] ?? "?"}, ${STAGE_UNIT} ${states[4] ?? "?"}`);
  }
  const md = run(["pw-metadata", "-n", "settings", "0"], 2000).out;
  const setting = (k: string) => new RegExp(`key:'${k.replace(".", "\\.")}' value:'([^']*)'`).exec(md)?.[1] ?? null;
  const forced = [setting("clock.force-quantum"), setting("clock.force-rate")].map((v) => Number(v ?? 0)).filter((v) => v > 0);
  add("clock", forced.length ? "warn" : "ok", `${setting("clock.rate") ?? "?"} Hz, quantum ${setting("clock.quantum") ?? "?"} (${setting("clock.min-quantum") ?? "?"} to ${setting("clock.max-quantum") ?? "?"})${forced.length ? "; a forced quantum or rate is set by something else" : ""}`);
  const x = xruns();
  add("xruns", !x.available ? "warn" : x.total ? "warn" : "ok", !x.available ? "pw-top did not answer; xruns not counted" : x.total ? `${x.total} xruns since the nodes started: ${x.nodes.join(", ")}` : "no xruns on any node");
  // PipeWire puts a dummy sink (auto_null) in place when no device is left: sound goes nowhere, and that is
  // reported as no output, not as an output called Dummy.
  const out = g.outputs.find((d) => d.isDefault && !d.filter && d.name !== DUMMY_SINK);
  const onFilter = !out && g.outputs.some((d) => d.isDefault && d.filter);
  add("output", !out ? "bad" : !out.available ? "warn" : "ok", !out ? (onFilter ? "the default output is the equalizer's own node with no device behind it: nothing plays anywhere" : "no output: PipeWire plays into a dummy sink, nothing is heard") : `${out.label}, ${percent(out.volume)} %${out.mute ? ", muted" : ""}${out.available ? "" : ", unplugged"}${out.codec ? `, ${out.codec.toUpperCase()}` : ""}`);
  const inp = g.inputs.find((d) => d.isDefault);
  add("input", !inp ? "warn" : "ok", !inp ? "no default input" : `${inp.label}, ${percent(inp.volume)} %${inp.mute ? ", muted" : ""}`);
  const snd = loadSound(); const node = eqNode(g);
  if (snd.enabled && !node) add("eq", "bad", "the equalizer is on but its process is not running: ballroom eq restart");
  else if (snd.enabled && node) {
    const fed = feeds(g, `${EQ_NODE}.output`);
    const inFront = !!g.defaultSink && fed.includes(g.defaultSink);
    add("eq", inFront ? "ok" : "warn", inFront ? `on, preset ${soundPlan(g).presetName}, in front of ${out?.label ?? g.defaultSink}` : `on and running, but not in front of the default output (feeds ${fed.length ? fed.join(", ") : "nothing"}); ballroom apply`);
  } else add("eq", "ok", node ? "off; the process idles neutral so that nothing is interrupted" : "off");
  const ff = foreignFilters(g);
  add("foreign", ff.length ? "warn" : "ok", ff.length ? `another filter is in front of the output: ${ff.join(", ")} (Ballroom does not touch it; two filters stack)` : "no foreign filter in front of the output");
  const frags = filterFragments();
  add("fragments", frags.length ? "warn" : "ok", frags.length ? `a configuration fragment builds a filter: ${frags.join(", ")} (not Ballroom's; it may fight the equalizer)` : "no fragment builds a filter");
  const st = await stageState();
  add("stage", !st.available ? "warn" : "ok", !st.available ? "mpv is not installed: no stage (omarchy pkg add mpv)" : `mpv present, ${st.running ? st.state : "off"}${Bun.which("yt-dlp") ? "" : "; yt-dlp is not installed, so no SoundCloud"}`);
  const tools = [["cava", "no spectrum"], ["mpv", "nothing plays"], ["yt-dlp", "no SoundCloud"]].filter(([t]) => !Bun.which(t));
  add("tools", tools.length ? "warn" : "ok", tools.length ? tools.map(([t, why]) => `${t} is not installed (${why})`).join("; ") : "cava, mpv and yt-dlp are installed");
  const rules = loadRules();
  const here = routesIn(rules, g.setup);
  const stale = Object.keys(here).filter((app) => !g.streams.some((s) => s.app === app));
  const elsewhere = Object.keys(rules.routes).filter((k) => k !== g.setup).length;
  add("settings", warnings.length ? "bad" : "ok", warnings.length ? warnings.join("; ") : `${Object.keys(loadDevices().devices).length} device entries, ${Object.keys(here).length} routes in this setup${stale.length ? ` (${stale.length} for applications that do not play right now)` : ""}${elsewhere ? `, rules for ${elsewhere} other setups` : ""}, ${Object.keys(loadScenes().scenes).length} scenes`);
  return checks;
}

async function verbDoctor(): Promise<Out> {
  const checks = await doctor();
  const count = (s: Check["state"]) => checks.filter((c) => c.state === s).length;
  return { json: { ok: true, checks, summary: { ok: count("ok"), warn: count("warn"), bad: count("bad") } },
           text: maskKey(checks.map((c) => `${CHECK_GLYPH[c.state]} ${c.key.padEnd(12)} ${c.text}`).join("\n")) };
}

// The cheap version for the widget, from the graph alone: what the panel foot warns about every second.
function health(g: Graph): string[] {
  const out: string[] = [];
  const def = g.outputs.find((d) => d.isDefault && !d.filter && d.name !== DUMMY_SINK);
  if (!def) out.push(g.outputs.some((d) => d.isDefault && d.filter) ? "no output behind the equalizer" : "no output: PipeWire plays into a dummy sink");
  else if (!def.available) out.push(`${def.label} is unplugged`);
  if (loadSound().enabled && !eqNode(g)) out.push("the equalizer is on but not running");
  const ff = foreignFilters(g);
  if (ff.length) out.push(`another filter is in front of the output: ${ff.join(", ")}`);
  return out;
}

// ---- keys
// `--osd` after a verb shows the result on Omarchy's on-screen display, the way the media keys do, so that a
// key binding can call `ballroom vol +5 --osd` instead of the stock scripts and keep caps and routes.
function showOsd(osd: { icon: string; percent?: number; message?: string }) {
  if (!Bun.which("omarchy-osd")) return;
  const args = ["omarchy-osd", "-i", osd.icon];
  if (osd.percent !== undefined) args.push("-p", String(Math.max(0, Math.min(100, Math.round(osd.percent)))));
  if (osd.message) args.push("-m", clean(osd.message).slice(0, 80));
  run(args, 2000);
}

// The output after the default one, among those that are plugged in and not hidden, in the order they are listed.
function nextOutput(g: Graph): Device {
  const list = g.outputs.filter((d) => !d.filter && !d.hidden && d.available);
  if (!list.length) throw new Fail("no output is plugged in", EXIT.notFound);
  const i = list.findIndex((d) => d.isDefault);
  return list[(i + 1) % list.length];
}

// ---- what the terminal shows, and the widget's own settings
// This is the only surface in the terminal: there is no second one to keep in step with the panel. `ballroom
// help` is where a verb is found, and every verb prints for a person and, with --json, for a program.
const A = { bold: "\x1b[1m", dim: "\x1b[2m", green: "\x1b[32m", red: "\x1b[31m", off: "\x1b[0m" };
// A name from the graph is text from outside; a control character in it could repaint the terminal.
// Bidi controls are in the class as well: a name with one of them would turn the reading direction of a row.
const clean = (x: string) => String(x).replace(/[\x00-\x1f\x7f-\x9f\u061c\u200e\u200f\u202a-\u202e\u2066-\u2069]/g, "·");

// The widget's own settings, as manifest.json declares them (the bench compares the two). They live in the
// shell's configuration; the shell writes them, Ballroom only asks it to.
// len is how long a string setting may be. The default of 40 fits a name; a browser profile is a path and needs
// more, and a value cut in the middle of a path sends yt-dlp to a directory that does not exist.
// `own` marks what the panel writes by itself and nobody types: it is not in the manifest's schema, so the
// settings page never offers it, and the shell hands it back with the rest all the same.
type WidgetSetting = { key: string; label: string; type: "string" | "boolean" | "integer" | "enum"; def: string | boolean | number;
                       min?: number; max?: number; len?: number; options?: string[]; own?: boolean };
const WIDGET_ID = "rogertobler.ballroom";
const WIDGET_SETTINGS: WidgetSetting[] = [
  { key: "title", label: "Name", type: "string", def: "" },
  { key: "stageButton", label: "Pause button in the bar", type: "boolean", def: true },
  { key: "spectrum", label: "Show the spectrum", type: "boolean", def: true },
  { key: "inputSpectrum", label: "Spectrum of the microphone", type: "boolean", def: true },
  { key: "inputMeters", label: "Level bar in every input row", type: "boolean", def: true },
  // Which parts the panel shows and in which order, as one line of ids; a dash in front of one switches it off.
  // The panel keeps the meaning of the line, the command only keeps the line. There is no second switch per
  // section beside it: two ways to hide one thing are two chances to disagree.
  { key: "sections", label: "Sections and their order", type: "string", def: "", len: 200 },
  { key: "soundcloudUser", label: "SoundCloud name", type: "string", def: "" },
  { key: "soundcloudCookies", label: "SoundCloud browser cookies", type: "string", def: "", len: 240 },
  { key: "spectrumBars", label: "Bars in the spectrum", type: "integer", def: 8, min: 4, max: 24 },
  { key: "spectrumColor", label: "Colour of the bars", type: "enum", def: "Mono", options: ["Mono", "Accent", "Rainbow"] },
  { key: "refreshIntervalSec", label: "Status interval (seconds)", type: "integer", def: 5, min: 2, max: 60 },
  // Which parts the panel has folded shut, in the shape of the sections line: an id on its own is open, an id
  // with a dash in front of it is folded. The panel writes it when a section's line is clicked, so that the
  // panel opens the next time the way it was left; an empty line means nothing has been folded yet.
  { key: "folded", label: "Folded sections", type: "string", def: "", len: 200, own: true },
];

function widgetValues(): Record<string, string | boolean | number> {
  const values: Record<string, string | boolean | number> = Object.fromEntries(WIDGET_SETTINGS.map((w) => [w.key, w.def]));
  try {
    const config = JSON.parse(readFileSync(join(process.env.XDG_CONFIG_HOME ?? join(HOME, ".config"), "omarchy", "shell.json"), "utf8"));
    for (const section of Object.values(config?.bar?.layout ?? {})) {
      for (const entry of Array.isArray(section) ? section : []) {
        if (!isObject(entry) || (entry as any).id !== WIDGET_ID) continue;
        for (const w of WIDGET_SETTINGS) if ((entry as any)[w.key] !== undefined) values[w.key] = (entry as any)[w.key];
      }
    }
  } catch { /* no shell configuration: the defaults are what the widget uses */ }
  return values;
}

function setWidgetValue(key: string, value: string | boolean | number) {
  const w = WIDGET_SETTINGS.find((x) => x.key === key);
  if (!w) throw new Fail(`no widget setting ${key}`, EXIT.usage);
  if (w.type === "boolean" && typeof value !== "boolean") throw new Fail(`${w.label} is on or off`, EXIT.usage);
  if (w.type === "integer" && (typeof value !== "number" || !Number.isInteger(value) || value < w.min! || value > w.max!)) throw new Fail(`${w.label} is a whole number from ${w.min} to ${w.max}`, EXIT.usage);
  if (w.type === "enum" && !w.options!.includes(String(value))) throw new Fail(`${w.label} is one of ${w.options!.join(", ")}`, EXIT.usage);
  if (w.type === "string") value = clean(String(value)).trim().slice(0, w.len ?? 40);
  const r = run(["omarchy-shell", "shell", "setBarWidget", WIDGET_ID, key, JSON.stringify(value), "{}"]);
  if (r.rc === 127) throw new Fail("omarchy-shell is not installed; widget settings live in the shell");
  if (r.timedOut || r.rc !== 0) throw new Fail("the shell did not take the setting; is it running?");
  if (r.out.trim() !== "ok") throw new Fail(`the shell refused the setting: ${clean(r.out.trim()).slice(0, 120)}`);
  // Rule 1: the shell says ok, the configuration it wrote says whether it is true.
  const deadline = Date.now() + 2000;
  while (Date.now() < deadline) {
    if (widgetValues()[key] === value) return;
    Bun.sleepSync(50);
  }
  throw new Fail(`the shell answered ok, but ${w.label} did not change in its configuration`);
}

