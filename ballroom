  const pre = plan.bypass ? 0 : plan.preamp;
  const c: Record<string, number> = {
    "mixL:Gain 1": m[0], "mixL:Gain 2": m[1], "mixR:Gain 1": m[2], "mixR:Gain 2": m[3],
    "preL:Gain": pre, "preR:Gain": pre,
  };
  // A slot at 0 dB keeps the frequency and Q it has: changing those at 0 dB would reset a filter for nothing.
  for (const { name, band } of slotBands(plan)) for (const side of ["L", "R"]) {
    c[`${side}_${name}:Gain`] = band.gain;
    if (band.gain !== 0) { c[`${side}_${name}:Freq`] = band.freq; c[`${side}_${name}:Q`] = band.q; }
  }
  return c;
}
const num = (x: number) => (Number.isInteger(x) ? x.toFixed(1) : String(x));
function eqConfText(plan: EqPlan): string {
  const c = eqControls(plan);
  const node = (name: string, label: string, keys: string[]) =>
    `          { type = builtin name = ${name} label = ${label}${keys.length ? ` control = { ${keys.map((k) => `"${k}" = ${num(c[`${name}:${k}`])}`).join(" ")} }` : ""} }`;
  const nodes = [node("inL", "copy", []), node("inR", "copy", []),
    node("mixL", "mixer", ["Gain 1", "Gain 2"]), node("mixR", "mixer", ["Gain 1", "Gain 2"]),
    `          { type = builtin name = preL label = bq_highshelf control = { "Freq" = 0.0 "Q" = 1.0 "Gain" = ${num(plan.preamp)} } }`,
    `          { type = builtin name = preR label = bq_highshelf control = { "Freq" = 0.0 "Q" = 1.0 "Gain" = ${num(plan.preamp)} } }`];
  const links = [`{ output = "inL:Out" input = "mixL:In 1" }`, `{ output = "inR:Out" input = "mixL:In 2" }`,
    `{ output = "inL:Out" input = "mixR:In 1" }`, `{ output = "inR:Out" input = "mixR:In 2" }`,
    `{ output = "mixL:Out" input = "preL:In" }`, `{ output = "mixR:Out" input = "preR:In" }`];
  const slots = slotBands(plan);
  for (const side of ["L", "R"]) {
    slots.forEach(({ name, type, band }, i) => {
      nodes.push(`          { type = builtin name = ${side}_${name} label = ${LABEL[type]} control = { "Freq" = ${num(band.freq)} "Q" = ${num(band.q)} "Gain" = ${num(band.gain)} } }`);
      links.push(`{ output = "${i === 0 ? `pre${side}` : `${side}_${slots[i - 1].name}`}:Out" input = "${side}_${name}:In" }`);
    });
  }
  const last = slots[slots.length - 1].name;
