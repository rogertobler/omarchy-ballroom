#!/usr/bin/env bun
// Ballroom command. One program for the bar widget (JSON) and the terminal.
//
// Every verb follows these rules. They are not style: each one was measured on PipeWire 1.6.8 and
// WirePlumber 0.5.17, and DESIGN.md says how.
//
//   1. Measure, then report. After every write the graph is read back, and the answer comes from that reading.
//      wpctl exits 0 even for a profile that does not exist.
//   2. Volumes use the cubic scale that wpctl, pactl and Quickshell share: 50 % is 0.125 inside PipeWire.
//   3. No object id is kept beyond one reading. PipeWire hands ids out again after a restart or a hotplug.
//      Devices are named by node.name, streams by object.serial.
//   4. Every call to a tool has a time limit. A hung wpctl must not hang the bar.
//   5. WirePlumber is never restarted. With a Bluetooth headset a restart takes about twelve seconds.
//   6. A change that makes a device vanish never plays through another device: fallback outputs are muted
//      around it, and exactly those mutes are taken back afterwards.
//   7. No error text of a PipeWire tool is compared, only exit codes and structured output.
//   8. The microphone is never opened on the side. What Ballroom reads from inputs (the spectrum of the default
//      input, a level per listed input) runs only while the panel is open and stops with it; the spectrum
//      carries the name ballroom.spectrum.input, and none of it is listed as a listener.
//   9. A secret is never a process argument and never printed. The DI.FM listen key comes in over stdin or a
//      hidden prompt, goes to mpv over its socket, and is masked in every text and every title in the graph.
import { existsSync, mkdirSync, readFileSync, writeFileSync, renameSync, chmodSync, rmSync, readdirSync, lstatSync, copyFileSync, readSync, writeSync, openSync, closeSync, constants as FS } from "fs";
import { join } from "path";
import { isatty } from "tty";
import { Database } from "bun:sqlite";

const VERSION = "0.1.0";

// ---------------------------------------------------------------- places
// The bench sets BALLROOM_BENCH=1 and may then hand in a recorded graph, fake servers and a short time limit.
// Outside the bench none of those switches exists: a variable exported in a session must not change what the
// widget reads or where a key goes. The tools come from a fixed path for the same reason: ~/.local/bin is
// first on PATH here, and a file placed there must not replace wpctl or systemctl for every panel call.
const BENCH = process.env.BALLROOM_BENCH === "1";
if (!BENCH) process.env.PATH = "/usr/bin:/usr/local/bin:/usr/share/omarchy/bin";
const HOME = process.env.HOME ?? "/tmp";
const CONFIG = join(process.env.XDG_CONFIG_HOME ?? join(HOME, ".config"), "ballroom");
// The runtime directory is the session's own, on tmpfs and 0700. There is no fallback to /tmp: another local
// user could plant that directory first and fill it with links.
if (!process.env.XDG_RUNTIME_DIR) { console.error("ballroom: XDG_RUNTIME_DIR is not set; run it inside your session"); process.exit(1); }
const RUNTIME = join(process.env.XDG_RUNTIME_DIR, "ballroom");
const TIMEOUT_MS = Number((BENCH && process.env.BALLROOM_TIMEOUT_MS) || 3000);

// Ballroom's own directories are created 0700 and checked every time: never a link, never another user's,
// never open to others. A directory that fails this is refused, not used.
function ensureDir(dir: string) {
  if (!existsSync(dir)) mkdirSync(dir, { recursive: true, mode: 0o700 });
  const st = lstatSync(dir);
  if (st.isSymbolicLink() || !st.isDirectory() || st.uid !== process.getuid!()) throw new Fail(`${dir} is not a directory of this user; refusing to use it`);
  if ((st.mode & 0o077) !== 0) {
    // The runtime directory is shared ground and is refused when open; a directory in the home is Ballroom's own
    // and is closed instead.
    if (dir === RUNTIME) throw new Fail(`${dir} is open to other users; refusing to use it`);
    chmodSync(dir, 0o700);
  }
}
// A runtime file is written whole: a reader that comes every second (the widget) must never see half of it.
function writeRuntime(name: string, text: string) {
  ensureDir(RUNTIME);
  const file = join(RUNTIME, name);
  const temp = `${file}.tmp.${process.pid}`;
  writeFileSync(temp, text, { mode: 0o600 });
  renameSync(temp, file);
}

// One writer at a time. The widget runs apply on every change in the graph, an action beside it, and the
// terminal on top: two of them changing a settings file or restarting the equalizer at once
// would lose one change or restart twice. The lock is a file in the runtime directory with the writer's pid;
// a lock of a process that is gone is taken over. Reading verbs never take it.
let lockDepth = 0;
function lockAcquire() {
  if (lockDepth++ > 0) return;
  ensureDir(RUNTIME);
  const file = join(RUNTIME, "lock");
  const until = Date.now() + 5000;
  for (;;) {
    try { writeFileSync(file, String(process.pid), { flag: "wx", mode: 0o600 }); return; }
    catch (e: any) { if (e?.code !== "EEXIST") throw e; }
    let holder = NaN;
    try { holder = Number(readFileSync(file, "utf8")); } catch { /* being written or just removed */ }
    if (Number.isInteger(holder) && holder > 0) {
      try { process.kill(holder, 0); } catch (e: any) { if (e?.code === "ESRCH") { rmSync(file, { force: true }); continue; } }
    }
    if (Date.now() > until) { lockDepth--; throw new Fail("another ballroom is busy changing settings; try again", EXIT.failed); }
    Bun.sleepSync(20);
  }
}
function lockRelease() {
  if (--lockDepth > 0) return;
  rmSync(join(RUNTIME, "lock"), { force: true });
}
function withLock<T>(f: () => T): T {
  lockAcquire();
  try { return f(); } finally { lockRelease(); }
}
async function withLockAsync<T>(f: () => Promise<T>): Promise<T> {
  lockAcquire();
  try { return await f(); } finally { lockRelease(); }
}

// ---------------------------------------------------------------- failures
// Exit codes are part of the interface: the panel and scripts branch on them.
const EXIT = { ok: 0, failed: 1, usage: 2, notFound: 3, timeout: 4 } as const;

class Fail extends Error {
  code: number;
  constructor(message: string, code: number = EXIT.failed) {
    super(message);
    this.code = code;
  }
}

// ---------------------------------------------------------------- running tools
type RunResult = { rc: number; out: string; err: string; timedOut: boolean };

// The modification time of a file, or null when it is not there. Used to notice that a cookie store was written.
function statSafe(path: string): { mtimeMs: number } | null {
  try { return lstatSync(path); } catch { return null; }
}

function run(cmd: string[], timeout = TIMEOUT_MS): RunResult {
  try {
    const p = Bun.spawnSync({ cmd, stdin: "ignore", stdout: "pipe", stderr: "pipe", timeout, killSignal: "SIGKILL" });
    return { rc: p.exitCode ?? 1, out: p.stdout.toString(), err: p.stderr.toString(), timedOut: !!p.exitedDueToTimeout };
  } catch {
    // The tool is not installed. That is a state to report, not a crash.
    return { rc: 127, out: "", err: "", timedOut: false };
  }
}

function must(r: RunResult, what: string): RunResult {
  if (r.timedOut) throw new Fail(`${what} did not answer within ${TIMEOUT_MS} ms`, EXIT.timeout);
  if (r.rc === 127) throw new Fail(`${what} is not installed`);
  if (r.rc !== 0) throw new Fail(`${what} failed with exit ${r.rc}`);
  return r;
}

// ---------------------------------------------------------------- stored settings
// Two small files, each with a schema version. A file that cannot be read is moved aside and replaced by
// defaults, never silently overwritten: the user may want to see what was in it.
type DeviceSettings = { alias?: string; hidden?: boolean; favorite?: boolean; kind?: Kind; cap?: number | null; eq?: string };
type Devices = { schemaVersion: 1; caps: Record<Kind, number | null>; devices: Record<string, DeviceSettings> };
// Routes are kept per setup: the sorted names of the outputs that are plugged in right now (see setupKey). An
// application sent to the monitor while docked is not sent there at the kitchen table, where a rule for the
// speakers may hold instead; where no rule is written for the setup at hand, the application follows the default.
type Rules = { schemaVersion: 2; routes: Record<string, Record<string, string>> };
type Kind = "headphones" | "speakers";

const DEFAULT_DEVICES: Devices = { schemaVersion: 1, caps: { headphones: 0.5, speakers: null }, devices: {} };
const DEFAULT_RULES: Rules = { schemaVersion: 2, routes: {} };
const warnings: string[] = [];

function loadJson<T extends { schemaVersion: number }>(name: string, fallback: T, valid: (v: any) => boolean): T {
  const file = join(CONFIG, name);
  if (!existsSync(file)) return structuredClone(fallback);
  let parsed: any;
  try { parsed = JSON.parse(readFileSync(file, "utf8")); } catch { parsed = undefined; }
  if (parsed && parsed.schemaVersion === fallback.schemaVersion && valid(parsed)) return parsed;
  const aside = join(CONFIG, name.replace(/\.json$/, `.invalid.${Date.now()}.json`));
  try { renameSync(file, aside); } catch { /* reported below either way */ }
  warnings.push(`${name} could not be read and was moved aside; defaults apply`);
  return structuredClone(fallback);
}

function saveJson(name: string, value: object) {
  ensureDir(CONFIG);
  const file = join(CONFIG, name);
  const temp = `${file}.tmp.${process.pid}`;
  writeFileSync(temp, JSON.stringify(value, null, 2) + "\n", { mode: 0o600 });
  chmodSync(temp, 0o600);
  renameSync(temp, file);
}

const isObject = (v: any) => v !== null && typeof v === "object" && !Array.isArray(v);

function loadDevices(): Devices {
  // A cap is what stands between a headset and the level of the speakers: one outside 5 to 100 % in the file is
  // no cap, so the whole file is moved aside and the defaults, which cap headphones, hold instead.
  const capOk = (c: any) => c === undefined || c === null || (typeof c === "number" && c >= 0.05 && c <= 1);
  const d = loadJson("devices.json", DEFAULT_DEVICES, (v) => isObject(v.devices) && isObject(v.caps)
    && Object.values(v.caps).every(capOk) && Object.values(v.devices).every((e: any) => isObject(e) && capOk(e.cap)));
  d.caps = { ...DEFAULT_DEVICES.caps, ...d.caps };
  return d;
}
// Read once per process: readGraph asks for the rules, and waitFor reads the graph every few milliseconds, so
// without this the file would be parsed dozens of times per verb and a warning about it pushed as often.
let rulesCache: Rules | null = null;
function loadRules(): Rules {
  if (rulesCache) return structuredClone(rulesCache);
  rulesCache = readRules();
  return structuredClone(rulesCache);
}
// Writers hold the lock; a file from before routes were kept per setup is moved aside here, not while reading:
// a reading verb runs beside the writer, and its rename could take the file the writer just wrote.
function saveRules(rules: Rules) {
  if (oldRules()) { try { renameSync(join(CONFIG, "rules.json"), join(CONFIG, "rules.v1.json")); } catch { /* the new file replaces it anyway */ } }
  saveJson("rules.json", rules);
  rulesCache = null;
}
// A file from before routes were kept per setup holds one device per application (schema 1).
function oldRules(): boolean {
  try { const old = JSON.parse(readFileSync(join(CONFIG, "rules.json"), "utf8")); return old?.schemaVersion === 1 && isObject(old.routes); }
  catch { return false; }
}
function readRules(): Rules {
  // An old file is not read as one setup: a rule chosen at the desk would otherwise bind at the kitchen table. It
  // is left in place for the next writer to move aside, and said so once per process.
  if (oldRules()) {
    warnings.push("rules.json came from an older Ballroom; routes are kept per setup now, choose them again (the next route moves it aside as rules.v1.json)");
    return structuredClone(DEFAULT_RULES);
  }
  return loadJson("rules.json", DEFAULT_RULES, (v) => isObject(v.routes)
    && Object.values(v.routes).every((m: any) => isObject(m) && Object.values(m).every((d) => typeof d === "string")));
}
// The setup: which outputs are plugged in, as one key. The filter is plumbing and not part of it.
function setupKey(outputs: Device[]): string {
  return outputs.filter((d) => d.available && !d.filter).map((d) => d.name).sort().join("|");
}
// The routes that hold in the setup at hand.
function routesIn(rules: Rules, setup: string): Record<string, string> { return rules.routes[setup] ?? {}; }
// Every output an application is sent to in any setup. WirePlumber remembers the last target per application,
// so a stream found on one of these without a rule here is that memory at work, not a choice made by hand.
// The rule for an application, by its name as the stream gives it. A rule typed while the application was closed
// carries the spelling that was typed, so a name that differs only in case is the same application.
function ruleOf(routes: Record<string, string>, app: string): string | undefined {
  if (routes[app] !== undefined) return routes[app];
  const low = app.toLowerCase();
  for (const [k, v] of Object.entries(routes)) if (k.toLowerCase() === low) return v;
  return undefined;
}
function ruleTargets(rules: Rules, app: string): Set<string> {
  const out = new Set<string>();
  for (const map of Object.values(rules.routes)) { const d = ruleOf(map, app); if (d) out.add(d); }
  return out;
}

// ---------------------------------------------------------------- reading the graph
type Device = {
  name: string; serial: number; id: number; description: string; nick: string; label: string; available: boolean;
  cls: "sink" | "source";
  api: string; kind: Kind; volume: number; mute: boolean; isDefault: boolean; hidden: boolean;
  favorite: boolean; cap: number | null; codec: string | null; profile: string | null; filter: boolean;
  btAddress: string | null; deviceId: number | null;
};
type Stream = {
  serial: number; id: number; name: string; app: string; media: string; direction: "playback" | "record";
  volume: number; mute: boolean; target: string | null; device: string | null; fromMonitor: boolean;
  routed: string | null; internal: boolean; meter: boolean;
};
type Graph = { objects: any[]; outputs: Device[]; inputs: Device[]; streams: Stream[];
               defaultSink: string | null; defaultSource: string | null; setup: string };

// The cubic scale: PipeWire keeps linear channel volumes, everyone who shows a slider shows the cube root.
function visualVolume(props: any): number {
  const v: number[] = props?.channelVolumes ?? [];
  if (!v.length) return 1;
  return v.reduce((a, x) => a + Math.cbrt(Math.max(0, x)), 0) / v.length;
}

// p is the node's properties over the card's: a Bluetooth headset says "headset" in device.form-factor and
// device.icon-name on the card only, never on its sink node (measured on PipeWire 1.6.8).
function inferKind(p: any, stored?: DeviceSettings): Kind {
  if (stored?.kind === "headphones" || stored?.kind === "speakers") return stored.kind;
  const form = String(p["device.form-factor"] ?? "");
  if (/headphone|headset|hands-?free|earbud/i.test(form)) return "headphones";
  if (/speaker|internal|hifi|tv|computer/i.test(form)) return "speakers";
  const text = `${p["node.description"] ?? ""} ${p["node.nick"] ?? ""} ${p["api.alsa.pcm.id"] ?? ""} ${p["device.icon-name"] ?? ""}`;
  return /headphone|headset/i.test(text) ? "headphones" : "speakers";
}

// The short name a device shows. PipeWire's nick is what the card calls the port ("Speaker", the monitor
// behind an HDMI port); the description names the whole card, and on one card every port shares it. A stored
// alias beats both. Two devices that would end up with the same name fall back to their descriptions.
function friendlyLabel(text: unknown): string {
  return String(text ?? "").trim()
    .replace(/^sof-soundwire\s+/i, "").replace(/^built-?in audio\s+/i, "")
    .replace(/\s+Output$/i, "").replace(/\s+Input$/i, "").replace(/\bMicrophones\b/g, "Microphone");
}

function metadataDefault(objects: any[], key: string): string | null {
  const md = objects.find((o) => o.type === "PipeWire:Interface:Metadata" && o.props?.["metadata.name"] === "default");
  const entry = (md?.metadata ?? []).find((e: any) => e.key === key && e.subject === 0);
  return entry?.value?.name ?? null;
}

// A monitor port learns its plug from the display driver, and on some machines that message never comes when a
// dock is pulled: the jack stays on, the route says available, and WirePlumber keeps the default on a monitor
// that is gone. The display side knows better. So while no external display is connected, a display port counts
// as unplugged. With one connected the jack is trusted, since a port cannot be matched to its connector
// reliably. null when there is nothing to ask; the bench hands in its own connectors and never reads the host.
// A connector that answers "unknown" (while a display settles, or with no probe at all) is not asked; only
// "connected" and "disconnected" count, and with nothing that answers the route is trusted. Read once per
// process: a verb is done within seconds, and readGraph asks for it on every read.
let displayCache: boolean | null | undefined;
function externalDisplay(): boolean | null {
  if (displayCache === undefined) displayCache = readExternalDisplay();
  return displayCache;
}
function readExternalDisplay(): boolean | null {
  const dir = BENCH ? process.env.BALLROOM_DRM : "/sys/class/drm";
  if (!dir) return null;
  let names: string[];
  try { names = readdirSync(dir); } catch { return null; }
  let asked = false;
  for (const n of names) {
    const m = /^card\d+-(.+)$/.exec(n);
    if (!m) continue;
    let status: string;
    try { status = readFileSync(join(dir, n, "status"), "utf8").trim(); } catch { continue; }
    if (/^(eDP|LVDS|DSI)-/.test(m[1])) continue;
    if (status === "connected") return true;
    if (status === "disconnected") asked = true;
  }
  return asked ? false : null;
}

// A route's info is a count followed by key and value pairs.
function displayRoute(r: any): boolean {
  const info: any[] = Array.isArray(r.info) ? r.info.slice(1) : [];
  for (let i = 0; i + 1 < info.length; i += 2) {
    if (info[i] === "port.type") return /^(hdmi|displayport|dp)$/i.test(String(info[i + 1]));
  }
  return /hdmi|displayport/i.test(String(r.name ?? ""));
}

function readGraph(): Graph {
  // The bench hands in a recorded graph to test what null sinks cannot show, such as an unplugged port.
  const recorded = BENCH ? process.env.BALLROOM_DUMP : undefined;
  // Null sinks have no ports to pull, so the bench names the outputs it calls unplugged. Only Ballroom's reading
  // changes: the node stays in the graph and WirePlumber keeps what is linked to it, as with a real monitor.
  const unplugged = new Set(BENCH ? String(process.env.BALLROOM_UNPLUGGED ?? "").split(",").filter(Boolean) : []);
  const raw = recorded ? readFileSync(recorded, "utf8") : must(run(["pw-dump"]), "pw-dump").out;
  let objects: any[];
  try { objects = JSON.parse(raw); } catch { throw new Fail("pw-dump returned no readable JSON"); }
  const devices = loadDevices();
  const rules = loadRules();
  const nodes = objects.filter((o) => o.type === "PipeWire:Interface:Node");
  const byId = new Map<number, any>(nodes.map((n) => [n.id, n]));
  const defaultSink = metadataDefault(objects, "default.audio.sink");
  const defaultSource = metadataDefault(objects, "default.audio.source");

  // A port with nothing plugged in is still a node. The card knows: among its routes, the ones carrying the
  // node's profile device say available yes, no or unknown. Only a plain no counts as unplugged, except for a
  // display port while no external display is connected (see externalDisplay).
  const cards = objects.filter((o) => o.type === "PipeWire:Interface:Device");
  const display = externalDisplay();
  const plugged = (p: any, cls: "sink" | "source"): boolean => {
    if (p["device.id"] === undefined || p["card.profile.device"] === undefined) return true;
    const card = cards.find((o) => o.id === Number(p["device.id"]));
    const direction = cls === "sink" ? "Output" : "Input";
    const mine = (card?.info?.params?.EnumRoute ?? []).filter((r: any) =>
      r.direction === direction && (r.devices ?? []).includes(Number(p["card.profile.device"])));
    if (mine.length === 0) return true;
    if (display === false && mine.every(displayRoute)) return false;
    return mine.some((r: any) => r.available !== "no");
  };

  // Muted is muted wherever it is set. On a card with routes, wpctl and the shell set the mute on the active route,
  // and on some devices (a USB webcam was the case) the node's own Props never follow: the node says open while
  // the route, and the sound, is muted. Either one muted means no sound gets through, so either one counts.
  const routeMuted = (p: any, cls: "sink" | "source"): boolean => {
    if (p["device.id"] === undefined || p["card.profile.device"] === undefined) return false;
    const card = cards.find((o) => o.id === Number(p["device.id"]));
    const direction = cls === "sink" ? "Output" : "Input";
    const route = (card?.info?.params?.Route ?? []).find((r: any) =>
      r.direction === direction && Number(r.device) === Number(p["card.profile.device"]));
    return route?.props?.mute === true;
  };

  const device = (n: any, cls: "sink" | "source"): Device => {
    const p = n.info?.props ?? {};
    const name = String(p["node.name"] ?? "");
    const stored = devices.devices[name] ?? {};
    const card = p["device.id"] !== undefined ? cards.find((o) => o.id === Number(p["device.id"])) : undefined;
    const kind = inferKind({ ...(card?.info?.props ?? {}), ...p }, stored);
    const description = String(p["node.description"] ?? p["node.nick"] ?? name);
    const nick = friendlyLabel(p["node.nick"]);
    const cap = stored.cap !== undefined ? stored.cap : (cls === "sink" ? devices.caps[kind] ?? null : null);
    return {
      name, serial: Number(p["object.serial"]), id: n.id, description, nick,
      label: stored.alias || nick || friendlyLabel(description) || name, available: plugged(p, cls) && !unplugged.has(name), cls,
      api: String(p["device.api"] ?? "virtual"), kind, volume: visualVolume(n.info?.params?.Props?.[0]),
      mute: !!n.info?.params?.Props?.[0]?.mute || routeMuted(p, cls), isDefault: name === (cls === "sink" ? defaultSink : defaultSource),
      hidden: !!stored.hidden, favorite: !!stored.favorite, cap,
      codec: p["api.bluez5.codec"] ?? null, profile: p["api.bluez5.profile"] ?? null,
      filter: p["filter.smart"] === true || p["filter.smart"] === "true" || name.startsWith("ballroom."),
      btAddress: p["api.bluez5.address"] ?? null, deviceId: p["device.id"] !== undefined ? Number(p["device.id"]) : null,
    };
  };

  const outputs: Device[] = [], inputs: Device[] = [], streams: Stream[] = [];
  for (const n of nodes) {
    const cls = String(n.info?.props?.["media.class"] ?? "");
    if (cls === "Audio/Sink") outputs.push(device(n, "sink"));
    else if (cls === "Audio/Source" || cls === "Audio/Source/Virtual") inputs.push(device(n, "source"));
  }
  const setup = setupKey(outputs);
  const routes = routesIn(rules, setup);
  for (const list of [outputs, inputs]) {
    const seen = new Map<string, number>();
    for (const d of list) seen.set(d.label, (seen.get(d.label) ?? 0) + 1);
    for (const d of list) if ((seen.get(d.label) ?? 0) > 1 && !devices.devices[d.name]?.alias) d.label = friendlyLabel(d.description) || d.name;
  }

  const links = objects.filter((o) => o.type === "PipeWire:Interface:Link");
  const peersOut = (id: number) => links.filter((l) => l.info?.["output-node-id"] === id).map((l) => byId.get(l.info["input-node-id"])).filter(Boolean);
  const peersIn = (id: number) => links.filter((l) => l.info?.["input-node-id"] === id).map((l) => byId.get(l.info["output-node-id"])).filter(Boolean);
  // A stream that plays into a filter plays, in the end, into the device behind the filter. The filter's
  // output stream shares its link group, so the chain is followed through that.
  const behind = (node: any, depth = 0): any => {
    const p = node?.info?.props ?? {};
    if (!node || depth > 4 || String(p["media.class"]).startsWith("Audio/Sink") === false) return node;
    const group = p["node.link-group"];
    if (!group) return node;
    const partner = nodes.find((m) => m !== node && m.info?.props?.["node.link-group"] === group);
    const next = partner ? peersOut(partner.id)[0] : null;
    return next ? behind(next, depth + 1) : node;
  };

  for (const n of nodes) {
    const p = n.info?.props ?? {};
    const cls = String(p["media.class"] ?? "");
    const direction = cls === "Stream/Output/Audio" ? "playback" : cls === "Stream/Input/Audio" ? "record" : null;
    if (!direction) continue;
    const name = String(p["node.name"] ?? "");
    const app = String(p["application.name"] ?? name);
    const peer = direction === "playback" ? peersOut(n.id)[0] : peersIn(n.id)[0];
    const peerName = peer?.info?.props?.["node.name"] ?? null;
    const final = direction === "playback" && peer ? behind(peer) : peer;
    const fromMonitor = direction === "record" && String(peer?.info?.props?.["media.class"] ?? "") === "Audio/Sink";
    streams.push({
      serial: Number(p["object.serial"]), id: n.id, name, app, media: String(p["media.name"] ?? ""), direction,
      volume: visualVolume(n.info?.params?.Props?.[0]), mute: !!n.info?.params?.Props?.[0]?.mute,
      target: peerName, device: final?.info?.props?.["node.name"] ?? null, fromMonitor,
      routed: ruleOf(routes, app) ?? null,
      // The filter's own output and anything Ballroom starts itself are plumbing, not a way sound takes.
      internal: name.startsWith("ballroom."),
      // Quickshell's PwNodePeakMonitor names its capture so. The level bar in Ballroom's own panel is one of
      // these, and the panel leaves it out of "who is listening" while that bar runs; the command shows it.
      meter: app === "Quickshell Peak Detect",
    });
  }
  return { objects, outputs, inputs, streams, defaultSink, defaultSource, setup };
}

// ---------------------------------------------------------------- finding what the user means
// A device is named by node.name, by its alias, by its number in the listing, or by a unique part of its
// description. Anything ambiguous is refused with the candidates, never guessed.
function findDevice(g: Graph, cls: "sink" | "source", query: string): Device {
  const list = (cls === "sink" ? g.outputs : g.inputs).filter((d) => !d.filter);
  const q = query.trim();
  if (q === "" || q === "default") {
    const def = list.find((d) => d.isDefault);
    if (def) return def;
    throw new Fail(`there is no default ${cls === "sink" ? "output" : "input"}`, EXIT.notFound);
  }
  const exact = list.find((d) => d.name === q) ?? list.find((d) => d.label === q);
  if (exact) return exact;
  if (/^\d+$/.test(q)) {
    const i = Number(q) - 1;
    if (list[i]) return list[i];
  }
  const lower = q.toLowerCase();
  const partial = list.filter((d) => d.label.toLowerCase().includes(lower) || d.description.toLowerCase().includes(lower));
  if (partial.length === 1) return partial[0];
  if (partial.length > 1) throw new Fail(`"${q}" matches ${partial.length} devices: ${partial.map((d) => d.label).join(", ")}`, EXIT.usage);
  throw new Fail(`no ${cls === "sink" ? "output" : "input"} called "${q}"`, EXIT.notFound);
}

function findStreams(g: Graph, query: string): Stream[] {
  const q = query.trim();
  const own = g.streams.filter((s) => !s.internal);
  const bySerial = /^#?\d+$/.test(q) ? own.filter((s) => s.serial === Number(q.replace("#", ""))) : [];
  if (bySerial.length) return bySerial;
  const lower = q.toLowerCase();
  return own.filter((s) => s.app.toLowerCase() === lower || s.name === q);
}

// ---------------------------------------------------------------- writing, always read back
const percent = (v: number) => Math.round(v * 100);

function parseLevel(text: string, current: number): number {
  const m = /^([+-]?)(\d+(?:\.\d+)?)%?$/.exec(text.trim());
  if (!m) throw new Fail(`"${text}" is not a volume; use 0 to 150, +5 or -5`, EXIT.usage);
  const value = Number(m[2]) / 100;
  const next = m[1] === "+" ? current + value : m[1] === "-" ? current - value : value;
  return Math.max(0, Math.min(1.5, next));
}

// The id is looked up again right before each write: an id from an earlier reading may belong to another
// object by now.
function idOf(kind: "node", name: string): number {
  const g = readGraph();
  const n = g.objects.find((o) => o.type === "PipeWire:Interface:Node" && o.info?.props?.["node.name"] === name);
  if (!n) throw new Fail(`"${name}" is gone`, EXIT.notFound);
  return n.id;
}

function setVolume(nodeName: string, level: number) {
  must(run(["wpctl", "set-volume", String(idOf("node", nodeName)), level.toFixed(4)]), "wpctl set-volume");
}
function setVolumeOfStream(serial: number, level: number) {
  const g = readGraph();
  const s = g.streams.find((x) => x.serial === serial);
  if (!s) throw new Fail(`stream #${serial} is gone`, EXIT.notFound);
  must(run(["wpctl", "set-volume", String(s.id), level.toFixed(4)]), "wpctl set-volume");
}
function setMute(id: number, on: boolean) {
  must(run(["wpctl", "set-mute", String(id), on ? "1" : "0"]), "wpctl set-mute");
}
function setDefault(nodeName: string) {
  must(run(["wpctl", "set-default", String(idOf("node", nodeName))]), "wpctl set-default");
}

// Reading back takes a moment: WirePlumber applies a default or a route asynchronously.
function waitFor(check: (g: Graph) => boolean, limitMs = 2000): Graph {
  const until = Date.now() + limitMs;
  let g = readGraph();
  while (!check(g) && Date.now() < until) {
    Bun.sleepSync(25);
    g = readGraph();
  }
  return g;
}

// ---------------------------------------------------------------- rules
// Rule 6. Everything that could catch the sound while the device is away is muted first, and afterwards only
// what this function muted is unmuted again: a device the user had muted stays muted.
// `isBack` says when the device has returned. It is a predicate, not a name: a Bluetooth sink in call mode can
// carry another node name than in music mode, and only its hardware address stays the same.
// If the device does not come back, the outputs stay muted and a warning says so: the sound would otherwise land
// on whatever WirePlumber picks next, at that output's level. Failing quiet is the safe way to fail here; the
// warning names the way out.
function guarded(keep: (d: Device) => boolean, isBack: (g: Graph) => boolean, action: () => void, limitMs = 15000): { mutedAround: number; backAfterMs: number | null; heldMuted: number } {
  const g = readGraph();
  const others = g.outputs.filter((d) => !keep(d) && !d.filter && !d.mute);
  for (const d of others) setMute(d.id, true);
  const started = Date.now();
  let backAfterMs: number | null = null;
  let heldMuted = 0;
  try {
    action();
    const after = waitFor(isBack, limitMs);
    if (isBack(after)) backAfterMs = Date.now() - started;
  } finally {
    const now = readGraph();
    // Decided on the graph as it is now, not on how the action went: an action that failed before the device ever
    // left leaves it where it was, and then nothing has to stay muted.
    if (isBack(now)) {
      for (const d of others) {
        const live = now.outputs.find((x) => x.name === d.name);
        if (live) setMute(live.id, false);
      }
    } else if (others.length) {
      heldMuted = others.length;
      warnings.push(`the device did not come back, so ${others.length} other output(s) stay muted rather than play in its place; unmute them with ballroom mute OUTPUT off once the sound is where it should be`);
    }
  }
  return { mutedAround: others.length, backAfterMs, heldMuted };
}

// Hearing protection for a device that is about to carry the sound: above its cap it is brought down first,
// then made the default. Never the other way round.
function capBeforeUse(d: Device): boolean {
  if (d.cap === null || d.volume <= d.cap + 0.005) return false;
  setVolume(d.name, d.cap);
  return true;
}

// ---------------------------------------------------------------- verbs
type Out = { json: any; text: string; osd?: { icon: string; percent?: number; message?: string } };

function statusLines(g: Graph): string[] {
  const out = g.outputs.find((d) => d.isDefault);
  const inp = g.inputs.find((d) => d.isDefault);
  const playing = g.streams.filter((s) => !s.internal && s.direction === "playback");
  const listening = g.streams.filter((s) => !s.internal && s.direction === "record" && !s.fromMonitor);
  return [
    `Output  ${out ? `${out.label}  ${percent(out.volume)} %${out.mute ? "  muted" : ""}${out.codec ? `  ${out.codec.toUpperCase()}` : ""}` : "none"}`,
    `Input   ${inp ? `${inp.label}  ${percent(inp.volume)} %${inp.mute ? "  muted" : ""}` : "none"}`,
    `Playing ${playing.length ? playing.map((s) => `${s.app} ${percent(s.volume)} %${s.mute ? " muted" : ""}`).join(", ") : "nothing"}`,
    `Listening ${listening.length ? listening.map((s) => s.app).join(", ") : "nobody"}`,
  ];
}

async function verbStatus(): Promise<Out> {
  const g = readGraph();
  return { json: await stateJson(g), text: [...statusLines(g), ...warnings.map((w) => `warning: ${w}`)].join("\n") };
}

async function stateJson(g: Graph) {
  const pick = (d: Device) => ({ name: d.name, serial: d.serial, label: d.label, description: d.description, kind: d.kind,
    api: d.api, volume: d.volume, mute: d.mute, isDefault: d.isDefault, hidden: d.hidden, available: d.available,
    favorite: d.favorite, cap: d.cap, codec: d.codec, profile: d.profile });
  return {
    ok: true, version: VERSION,
    defaultOutput: g.defaultSink, defaultInput: g.defaultSource,
    outputs: g.outputs.filter((d) => !d.filter).map(pick),
    inputs: g.inputs.filter((d) => !d.filter).map(pick),
    sound: (() => { try { return eqReport(soundPlan(g), !!eqNode(g), g); } catch { return null; } })(),
    health: (() => { try { return health(g); } catch { return []; } })(),
    // The rules that send an application to one output. They hold whether that application runs or not, so the
    // panel needs them beside the streams: a rule for a program that is closed has no row of its own otherwise.
    // Only the rules of the setup at hand: the others belong to other places and would show as pinned here.
    setup: g.setup,
    routes: Object.entries(routesIn(loadRules(), g.setup)).map(([app, device]) => ({ app: clean(app).slice(0, 120), device })),
    // Every Bluetooth audio device with what can be set on it: the mode it is in, the codec it carries, and the
    // codecs it offers in music mode. The panel cannot work these out from the graph alone.
    bluetooth: (() => {
      try {
        return btDevices(g).map((b) => ({ address: b.address, node: b.name, mode: btModeNow(b), codec: btCodecNow(b),
                                          codecs: [...new Set(btOffers(b).map((x) => x.codec!))] }));
      } catch { return []; }
    })(),
    // The limit a device of each kind starts at when it arrives without one of its own. The panel offers it
    // beside a device's own limit, and the two are not the same thing.
    caps: loadDevices().caps,
    // Whether WirePlumber switches a Bluetooth headset to call mode when an application opens its microphone.
    btAuto: (() => { try { return smSetting(g, "bluetooth.autoswitch-to-headset-profile") === "true"; } catch { return null; } })(),
    stage: await stageState().catch(() => null),
    // stage marks our own player among the streams, by node.name and never by the application name: the name
    // carries whatever mpv was told to call itself, node.name is what the unit set.
    streams: g.streams.filter((s) => !s.internal).map((s) => ({ serial: s.serial, app: clean(s.app).slice(0, 120), media: maskKey(clean(s.media)).slice(0, 160),
      direction: s.direction, volume: s.volume, mute: s.mute, device: s.device, fromMonitor: s.fromMonitor, routed: s.routed,
      meter: s.meter, stage: s.name === STAGE_NODE })),
    warnings,
  };
}

function listDevices(g: Graph, cls: "sink" | "source"): Out {
  const list = (cls === "sink" ? g.outputs : g.inputs).filter((d) => !d.filter);
  const text = list.map((d, i) => `${d.isDefault ? "*" : " "} ${String(i + 1).padStart(2)}  ${d.label}  ${percent(d.volume)} %${d.mute ? "  muted" : ""}${d.hidden ? "  hidden" : ""}${d.available ? "" : "  unplugged"}  (${d.kind})`).join("\n");
  return { json: { ok: true, devices: list }, text: text || "no devices" };
}

function verbOut(args: string[]): Out {
  const g = readGraph();
  if (!args.length) return listDevices(g, "sink");
  return withLock(() => outNow(g, args));
}
function outNow(g: Graph, args: string[]): Out {
  const d = args.length === 1 && args[0] === "next" ? nextOutput(g) : findDevice(g, "sink", args.join(" "));
  // The cap is for an output that arrives. The one already playing keeps the level it is listened at.
  const capped = d.isDefault ? false : capBeforeUse(d);
  // An output the user chose is theirs: Ballroom no longer moves the default back after an undock.
  rmSync(join(CONFIG, "undocked.json"), { force: true });
  setDefault(d.name);
  const after = waitFor((x) => x.defaultSink === d.name);
  if (after.defaultSink !== d.name) throw new Fail(`${d.label} did not become the default output`);
  // The new device's preset is set now, while the sound changes device anyway: one change, one click.
  if (loadSound().enabled) { try { eqSync(); } catch (e) { warnings.push(e instanceof Fail ? e.message : "the equalizer did not follow"); } }
  const now = after.outputs.find((x) => x.name === d.name)!;
  return { json: { ok: true, output: d.name, volume: now.volume, capped },
           text: `Output ${now.label}, ${percent(now.volume)} %${capped ? ` (brought down to its cap of ${percent(d.cap!)} % first)` : ""}`,
           osd: { icon: now.mute ? "volume-muted" : "volume-high", percent: percent(now.volume), message: now.label } };
}

function verbIn(args: string[]): Out {
  const g = readGraph();
  if (!args.length) return listDevices(g, "source");
  const d = findDevice(g, "source", args.join(" "));
  // WirePlumber does not make an unplugged input the default; refused before anything is switched on its way.
  if (!d.available) throw new Fail(`${d.label} is unplugged; choose an input that is plugged in`, EXIT.usage);
  // A microphone the user muted stays closed: switching to another one does not open a live microphone.
  const previous = g.inputs.find((x) => x.isDefault);
  const keepClosed = !!previous && previous.mute && !d.mute;
  if (keepClosed) {
    setMute(d.id, true);
    // Rule 1 and the microphone: the switch happens only once the new input reads back as muted.
    const shut = waitFor((x) => x.inputs.find((y) => y.name === d.name)?.mute === true);
    if (shut.inputs.find((y) => y.name === d.name)?.mute !== true) throw new Fail(`${d.label} could not be muted, so it did not become the default input`);
  }
  setDefault(d.name);
  const after = waitFor((x) => x.defaultSource === d.name);
  if (after.defaultSource !== d.name) throw new Fail(`${d.label} did not become the default input`);
  const now = after.inputs.find((x) => x.name === d.name)!;
  return { json: { ok: true, input: d.name, mute: now.mute, keptClosed: keepClosed },
           text: `Input ${now.label}${now.mute ? ", muted" : ""}${keepClosed ? " (kept muted, the previous input was muted)" : ""}`,
           osd: { icon: now.mute ? "microphone-muted" : "microphone", message: now.label } };
}

// vol [TARGET] [LEVEL]. TARGET is "out", "in", a device or an application; without it the default output.
function resolveTarget(g: Graph, words: string[]): { devices: Device[]; streams: Stream[]; label: string } {
  const q = words.join(" ").trim();
  if (q === "" || q === "out") { const d = findDevice(g, "sink", ""); return { devices: [d], streams: [], label: d.label }; }
  if (q === "in") { const d = findDevice(g, "source", ""); return { devices: [d], streams: [], label: d.label }; }
  const streams = findStreams(g, q);
  for (const cls of ["sink", "source"] as const) {
    try { const d = findDevice(g, cls, q); return { devices: [d], streams: [], label: d.label }; }
    catch (e) { if (!(e instanceof Fail) || e.code !== EXIT.notFound) throw e; }
  }
  if (streams.length) return { devices: [], streams, label: streams[0].app };
  throw new Fail(`nothing called "${q}"`, EXIT.notFound);
}

function verbVol(args: string[]): Out {
  const g = readGraph();
  const last = args[args.length - 1];
  const hasLevel = last !== undefined && /^[+-]?\d+(\.\d+)?%?$/.test(last);
  const target = resolveTarget(g, hasLevel ? args.slice(0, -1) : args);
  const current = target.devices[0]?.volume ?? target.streams[0]?.volume ?? 1;
  if (!hasLevel) return { json: { ok: true, target: target.label, volume: current }, text: `${target.label} ${percent(current)} %` };
  const level = parseLevel(last, current);
  for (const d of target.devices) setVolume(d.name, level);
  for (const s of target.streams) setVolumeOfStream(s.serial, level);
  const after = readGraph();
  const now = target.devices.length ? after.outputs.concat(after.inputs).find((d) => d.name === target.devices[0].name)?.volume
                                     : after.streams.find((s) => s.serial === target.streams[0].serial)?.volume;
  return { json: { ok: true, target: target.label, volume: now ?? null }, text: `${target.label} ${now === undefined ? "gone" : `${percent(now)} %`}`,
           osd: { icon: target.devices[0]?.cls === "source" ? "microphone" : "volume-high", percent: percent(now ?? 0), message: target.devices.length ? undefined : target.label } };
}

function verbMute(args: string[]): Out {
  const g = readGraph();
  const last = args[args.length - 1];
  const mode = ["on", "off", "toggle"].includes(last) ? last : "toggle";
  const target = resolveTarget(g, mode === last ? args.slice(0, -1) : args);
  const items = [...target.devices.map((d) => ({ id: d.id, mute: d.mute })), ...target.streams.map((s) => ({ id: s.id, mute: s.mute }))];
  const next = mode === "on" ? true : mode === "off" ? false : !items[0]?.mute;
  for (const it of items) setMute(it.id, next);
  // Rule 1: the answer is what the graph says now, not what was sent.
  const after = readGraph();
  const now = target.devices.length ? [...after.outputs, ...after.inputs].find((d) => d.name === target.devices[0].name)?.mute
                                     : after.streams.find((s) => s.serial === target.streams[0].serial)?.mute;
  if (now === undefined) throw new Fail(`${target.label} is gone`, EXIT.notFound);
  if (now !== next) throw new Fail(`${target.label} did not ${next ? "mute" : "unmute"}`);
  const src = target.devices[0]?.cls === "source";
  return { json: { ok: true, target: target.label, mute: now }, text: `${target.label} ${now ? "muted" : "unmuted"}`,
           osd: { icon: src ? (next ? "microphone-muted" : "microphone") : (next ? "volume-muted" : "volume-high"), message: `${target.label} ${next ? "muted" : "on"}` } };
}

// route APP DEVICE | route APP follow | route. WirePlumber remembers the target per application by device name
// once a stream was moved; the rule file adds what WirePlumber does not do: letting a stream follow the default
// while its device is unplugged, moving it back when the device returns, and keeping the rule for the setup it
// was chosen in, so that docking and undocking switch between rules (see apply). A rule is written for the setup
// at hand and read only there; follow removes it there.
function verbRoute(args: string[]): Out { return args.length ? withLock(() => routeNow(args)) : routeNow(args); }
function routeNow(args: string[]): Out {
  const rules = loadRules();
  if (!args.length) {
    // The listing is the file; the graph only says which setup is the one at hand, and without an answer from
    // PipeWire the file is still listed.
    let setup: string | null = null;
    try { setup = readGraph().setup; } catch { warnings.push("PipeWire did not answer, so which setup holds is unknown"); }
    const lines: string[] = [];
    for (const [key, map] of Object.entries(rules.routes)) {
      lines.push(key === setup ? "this setup:" : `setup ${key.split("|").join(", ")}:`);
      for (const [app, dev] of Object.entries(map)) lines.push(`  ${app} -> ${dev}`);
    }
    return { json: { ok: true, setup, routes: setup === null ? {} : routesIn(rules, setup), setups: rules.routes }, text: lines.join("\n") || "no routes" };
  }
  const g = readGraph();
  if (args.length < 2) throw new Fail("usage: ballroom route APP DEVICE|follow", EXIT.usage);
  const wanted = args.slice(1).join(" ");
  const streams = g.streams.filter((s) => !s.internal && s.direction === "playback" && s.app.toLowerCase() === args[0].toLowerCase());
  const here = routesIn(rules, g.setup);
  const app = streams[0]?.app ?? Object.keys(here).find((k) => k.toLowerCase() === args[0].toLowerCase()) ?? args[0];
  for (const k of Object.keys(here)) if (k !== app && k.toLowerCase() === app.toLowerCase()) delete here[k];
  if (wanted === "follow") {
    delete here[app];
    if (Object.keys(here).length) rules.routes[g.setup] = here; else delete rules.routes[g.setup];
    saveRules(rules);
    for (const s of streams) must(run(["pw-metadata", "-n", "default", "--", String(s.id), "target.object", "-1", "Spa:Id"]), "pw-metadata");
    // Rule 1: WirePlumber moves a freed stream to the default output; count the ones that arrived there.
    const back = streams.length && g.defaultSink ? waitFor((x) => streams.every((s) => x.streams.find((y) => y.serial === s.serial)?.device === g.defaultSink)) : g;
    const moved = streams.filter((s) => back.streams.find((y) => y.serial === s.serial)?.device === g.defaultSink).length;
    return { json: { ok: true, app, route: null, moved, running: streams.length }, text: `${app} follows the default output in this setup${streams.length ? ` (${moved} of ${streams.length} running streams moved)` : ""}` };
  }
  const d = findDevice(g, "sink", wanted);
  if (!d.available) throw new Fail(`${d.label} is unplugged; a rule is chosen among the outputs that are plugged in`, EXIT.usage);
  here[app] = d.name;
  rules.routes[g.setup] = here;
  saveRules(rules);
  for (const s of streams) must(run(["pw-metadata", "-n", "default", "--", String(s.id), "target.object", String(d.serial), "Spa:Id"]), "pw-metadata");
  const after = streams.length ? waitFor((x) => streams.every((s) => x.streams.find((y) => y.serial === s.serial)?.device === d.name)) : g;
  const moved = streams.filter((s) => after.streams.find((y) => y.serial === s.serial)?.device === d.name).length;
  return { json: { ok: true, app, route: d.name, moved, running: streams.length },
           text: `${app} -> ${d.label} in this setup${streams.length ? ` (${moved} of ${streams.length} running streams moved)` : " (applies when it plays)"}` };
}

function verbDevice(args: string[]): Out { return !args.length || args[0] === "list" ? deviceNow(args) : withLock(() => deviceNow(args)); }
function deviceNow(args: string[]): Out {
  const [sub, ...rest] = args;
  const g = readGraph();
  if (!sub || sub === "list") {
    const all = [...g.outputs, ...g.inputs].filter((d) => !d.filter);
    return { json: { ok: true, devices: all }, text: all.map((d) => `${d.cls === "sink" ? "out" : "in "} ${d.label}  (${d.kind}${d.cap !== null ? `, cap ${percent(d.cap)} %` : ""}${d.hidden ? ", hidden" : ""}${d.available ? "" : ", unplugged"})`).join("\n") };
  }
  const devices = loadDevices();
  const findAny = (q: string) => { try { return findDevice(g, "sink", q); } catch (e) { if (e instanceof Fail && e.code === EXIT.notFound) return findDevice(g, "source", q); throw e; } };
  const entry = (d: Device) => (devices.devices[d.name] ??= {});
  switch (sub) {
    case "alias": {
      if (rest.length < 2) throw new Fail("usage: ballroom device alias DEVICE NAME|-", EXIT.usage);
      const d = findAny(rest[0]); const text = rest.slice(1).join(" ");
      if (text === "-") delete entry(d).alias; else entry(d).alias = text;
      break;
    }
    case "hide": case "show": {
      const d = findAny(rest.join(" ")); entry(d).hidden = sub === "hide"; break;
    }
    case "kind": {
      if (rest.length < 2 || !["headphones", "speakers", "auto"].includes(rest[rest.length - 1])) throw new Fail("usage: ballroom device kind DEVICE headphones|speakers|auto", EXIT.usage);
      const d = findAny(rest.slice(0, -1).join(" ")); const k = rest[rest.length - 1];
      if (k === "auto") delete entry(d).kind; else entry(d).kind = k as Kind;
      break;
    }
    case "classcap": {
      const [kind, v] = rest;
      if (!["headphones", "speakers"].includes(kind) || v === undefined) throw new Fail("usage: ballroom device classcap headphones|speakers PERCENT|none", EXIT.usage);
      // The same bound as a device's own cap. A cap of 0 would let every headset that arrives arrive silent, and
      // 150 is no cap at all; parseLevel alone takes both. The bound used to sit in the surface that asked for
      // the number, which left the verb open to anything.
      if (v === "none") devices.caps[kind as Kind] = null;
      else {
        if (!/^\d+(\.\d+)?%?$/.test(v)) throw new Fail("a cap is a percentage from 5 to 100, or none", EXIT.usage);
        const cap = parseLevel(v, 0);
        if (cap < 0.05 || cap > 1) throw new Fail("a cap is a percentage from 5 to 100, or none", EXIT.usage);
        devices.caps[kind as Kind] = cap;
      }
      break;
    }
    case "reset": {
      const d = findAny(rest.join(" "));
      delete devices.devices[d.name];
      break;
    }
    case "cap": {
      if (rest.length < 2) throw new Fail("usage: ballroom device cap DEVICE PERCENT|-|none", EXIT.usage);
      const d = findAny(rest.slice(0, -1).join(" ")); const v = rest[rest.length - 1];
      // A cap says how loud something may arrive at the ear, so it belongs to an output. On an input it would
      // quietly hold a microphone down, which is not what anyone asks for here.
      if (d.cls !== "sink") throw new Fail("a cap belongs to an output; an input has none", EXIT.usage);
      if (v === "-") delete entry(d).cap; else if (v === "none") entry(d).cap = null;
      else {
        if (!/^\d+(\.\d+)?%?$/.test(v)) throw new Fail("a cap is a percentage from 5 to 100, or none", EXIT.usage);
        const cap = parseLevel(v, 0);
        if (cap < 0.05 || cap > 1) throw new Fail("a cap is a percentage from 5 to 100, or none", EXIT.usage);
        entry(d).cap = cap;
      }
      break;
    }
    default: throw new Fail(`unknown: device ${sub}`, EXIT.usage);
  }
  saveJson("devices.json", devices);
  return { json: { ok: true }, text: "saved" };
}

// apply: brings the current graph in line with the stored rules. It is what the service runs when anything in
// the graph comes or goes, and it changes nothing the second time.
//
// WirePlumber moves the default off an output whose route says unplugged. When the plug is not reported (see
// externalDisplay), it never hears of it and the default stays on a monitor that is gone, taking every new
// stream with it. So apply moves the default to the plugged output WirePlumber ranks highest, capped first like
// one that arrives, and remembers which one the user had chosen. Once that one is plugged in again, the default
// goes back, but only if it still sits where apply put it: a default the user chose meanwhile is theirs. The
// note lives beside the settings, not in the runtime directory: WirePlumber keeps the default that apply set as
// the configured one across logins, so the way back has to survive a login as well.
function followPlug(g: Graph, changes: string[]): boolean {
  const file = join(CONFIG, "undocked.json");
  let note: { chosen: string; placed: string } | null = null;
  try {
    const v = JSON.parse(readFileSync(file, "utf8"));
    if (typeof v?.chosen === "string" && typeof v?.placed === "string") note = v;
  } catch { /* nothing was moved */ }
  const def = g.outputs.find((x) => x.isDefault && !x.filter);
  if (note) {
    // Only a default the user chose ends the note: one that is plugged in, where Ballroom did not put it, while
    // the output Ballroom put it on is still there to be chosen against. No default yet (a login in progress), or
    // a default WirePlumber moved because that output went away, is not a choice, and the note stays.
    const placed = g.outputs.find((x) => x.name === note!.placed && x.available && !x.filter);
    if (def && def.available && def.name !== note.placed && placed) { rmSync(file, { force: true }); note = null; }
    else {
      const chosen = g.outputs.find((x) => x.name === note!.chosen && x.available && !x.filter);
      // The chosen output is still away. If the one the default was placed on is unplugged now as well, the
      // default moves on below and the note keeps naming the output the user had chosen.
      if (chosen) {
        if (def?.name === chosen.name) { rmSync(file, { force: true }); return false; }
        if (capBeforeUse(chosen)) changes.push(`${chosen.name}: brought down to ${percent(chosen.cap!)} %`);
        setDefault(chosen.name);
        // The note goes only once the way back is read back; a switch that did not take is tried again next time.
        if (waitFor((x) => x.defaultSink === chosen.name).defaultSink === chosen.name) {
          rmSync(file, { force: true });
          changes.push(`default output: back to ${chosen.name}, plugged in again`);
        } else warnings.push(`the default output did not go back to ${chosen.name}`);
        return true;
      }
      if (!def || def.available) return false;
    }
  }
  if (!def || def.available) return false;
  const chosenName = note?.chosen ?? def.name;
  const rank = (d: Device) => Number(g.objects.find((o) => o.type === "PipeWire:Interface:Node" && o.info?.props?.["node.name"] === d.name)?.info?.props?.["priority.session"] ?? 0) || 0;
  const candidates = g.outputs.filter((x) => x.available && !x.filter && x.name !== def.name);
  const shown = candidates.filter((x) => !x.hidden);
  const next = (shown.length ? shown : candidates).sort((a, b) => rank(b) - rank(a) || a.name.localeCompare(b.name))[0];
  if (!next) return false;
  if (capBeforeUse(next)) changes.push(`${next.name}: brought down to ${percent(next.cap!)} %`);
  // Written before the move: a default that moves late, after the read-back gave up, still finds its way back.
  // If it did not move at all, the default is still on the unplugged output and the next apply tries again.
  saveJson("undocked.json", { chosen: chosenName, placed: next.name });
  setDefault(next.name);
  if (waitFor((x) => x.defaultSink === next.name).defaultSink !== next.name) {
    warnings.push(`${def.name} is unplugged and the default output did not move to ${next.name}`);
    return true;
  }
  changes.push(`default output: ${def.name} is unplugged, ${next.name} until ${chosenName} is back`);
  return true;
}

// The cap is for an output that arrives, not for one that is already there: the service runs apply on every
// node that appears, a stream that starts or the panel's own spectrum included, and capping then would pull a
// headset the user turned up to 70 % down to 50 % in the middle of a song. So apply remembers which outputs it has seen, in the runtime directory, and caps only the ones
// that were not there last time. After a login the file is gone and every output counts as arriving. An output
// that was there but unplugged counts as arriving when it is plugged in: a headphone jack or a monitor port stays
// a node while nothing is in it, so only its plug says that something new now carries the sound.
//
// Unplugging a port leaves its node in the graph, and WirePlumber leaves a stream linked to a node it was sent
// to: a player routed to a monitor plays into a dock that is gone. So apply lets every stream that sits on an
// unplugged output follow the default, and a stream with a rule goes back to its device once that device is
// plugged in again. The default itself goes too when WirePlumber leaves it on an unplugged output (see
// followPlug).
function verbApply(): Out { return withLock(applyNow); }
function applyNow(): Out {
  let g = readGraph();
  const changes: string[] = [];
  const seenFile = join(RUNTIME, "outputs-seen.json");
  let seen: string[] | null = null;
  try { const v = JSON.parse(readFileSync(seenFile, "utf8")); if (Array.isArray(v)) seen = v.map(String); } catch { /* first apply of this login */ }
  const outputs = g.outputs.filter((x) => !x.filter && x.available);
  for (const d of outputs) {
    if (seen !== null && seen.includes(d.name)) continue;
    if (capBeforeUse(d)) changes.push(`${d.name}: brought down to ${percent(d.cap!)} %`);
  }
  ensureDir(RUNTIME);
  writeRuntime("outputs-seen.json", JSON.stringify(outputs.map((d) => d.name)) + "\n");
  // Read again when a cap was applied: followPlug caps the output it moves to from the graph it is handed, and
  // a stale level there would have it report the same drop a second time.
  if (changes.length) g = readGraph();
  if (followPlug(g, changes)) g = readGraph();
  // The equalizer: make up for a lost preamp, bring it back, and give it the new default device's preset.
  eqGuard(g, changes);
  if (loadSound().enabled || eqNode(g)) {
    try { const r = eqSync(); if (r.action !== "none") changes.push(`equalizer: ${r.action}`); }
    catch (e) { warnings.push(e instanceof Fail ? e.message : "the equalizer could not be brought in line"); }
  }
  const rules = loadRules();
  // Read again right before the routes: the equalizer may just have been restarted above, and PipeWire hands
  // out ids anew when nodes come and go (rule 3). What was moved is read back afterwards (rule 1).
  g = readGraph();
  const routes = routesIn(rules, g.setup);
  const moved: Stream[] = [], freed: Stream[] = [], released: Stream[] = [];
  const def = g.outputs.find((x) => x.isDefault && !x.filter && x.available);
  for (const s of g.streams.filter((x) => !x.internal && x.direction === "playback")) {
    const want = ruleOf(routes, s.app);
    const d = want ? g.outputs.find((x) => x.name === want) : undefined;
    if (d && d.available) {
      if (s.device === want) continue;
      must(run(["pw-metadata", "-n", "default", "--", String(s.id), "target.object", String(d.serial), "Spa:Id"]), "pw-metadata");
      moved.push(s);
      continue;
    }
    // Freed only toward a default that is plugged in and is another device: anything else changes nothing
    // audible and would move the stream again on every apply.
    const on = g.outputs.find((x) => x.name === s.device);
    if (!on || !def || def.name === on.name) continue;
    if (on.available) {
      // Plugged in, but not the default, and no rule here. If that output is where a rule of another setup sends
      // this application, the stream is there by that rule or by WirePlumber's memory of it, and it is let go,
      // whether the setup changed in this run or the application started later. Anywhere else it was put by
      // hand, and stays.
      if (!ruleTargets(rules, s.app).has(on.name)) continue;
      must(run(["pw-metadata", "-n", "default", "--", String(s.id), "target.object", "-1", "Spa:Id"]), "pw-metadata");
      released.push(s);
      continue;
    }
    must(run(["pw-metadata", "-n", "default", "--", String(s.id), "target.object", "-1", "Spa:Id"]), "pw-metadata");
    freed.push(s);
  }
  if (freed.length || released.length) {
    const all = [...freed, ...released];
    const after = waitFor((x) => all.every((s) => x.streams.find((y) => y.serial === s.serial)?.device === def!.name));
    for (const s of freed) {
      if (after.streams.find((y) => y.serial === s.serial)?.device === def!.name) changes.push(`${s.app}: ${s.device} is unplugged, follows the default ${def!.name}`);
      else warnings.push(`${s.app} plays into ${s.device}, which is unplugged, and did not follow the default`);
    }
    for (const s of released) {
      if (after.streams.find((y) => y.serial === s.serial)?.device === def!.name) changes.push(`${s.app}: no rule in this setup, follows the default ${def!.name}`);
      else warnings.push(`${s.app} has no rule in this setup and did not follow the default`);
    }
  }
  if (moved.length) {
    const after = waitFor((x) => moved.every((s) => x.streams.find((y) => y.serial === s.serial)?.device === ruleOf(routes, s.app)));
    for (const s of moved) {
      const to = ruleOf(routes, s.app);
      if (after.streams.find((y) => y.serial === s.serial)?.device === to) changes.push(`${s.app}: back to ${to}`);
      else warnings.push(`${s.app} did not move to ${to}`);
    }
  }
  return { json: { ok: true, changes }, text: changes.length ? changes.join("\n") : "nothing to do" };
}

// _guard DEVICE -- COMMAND: runs a command that makes DEVICE vanish and return, with rule 6 around it. The
// Bluetooth verbs use the same function; the bench uses this verb to prove it.
function verbGuard(args: string[]): Out {
  const sep = args.indexOf("--");
  if (sep < 1 || sep === args.length - 1) throw new Fail("usage: ballroom _guard DEVICE -- COMMAND", EXIT.usage);
  const g = readGraph();
  const d = findDevice(g, "sink", args.slice(0, sep).join(" "));
  const cmd = args.slice(sep + 1);
  const result = guarded((x) => x.name === d.name, (x) => x.defaultSink === d.name && x.outputs.some((y) => y.name === d.name),
    () => { const r = run(cmd, 20000); if (r.rc !== 0) throw new Fail(`the guarded command exited ${r.rc}`); });
  return { json: { ok: result.backAfterMs !== null, ...result }, text: result.backAfterMs !== null ? `back after ${result.backAfterMs} ms, ${result.mutedAround} outputs held muted` : "the device did not come back" };
}

// ---------------------------------------------------------------- bluetooth
// Only the sound of a headset: its codec, music or call mode, and whether WirePlumber may switch to call mode by
// itself. Pairing and connecting stay with Omarchy's Bluetooth panel.
type BtDevice = { id: number; label: string; address: string; profile: string; profiles: { index: number; name: string; codec: string | null; available: boolean }[] };

function btDevices(g: Graph): BtDevice[] {
  return g.objects.filter((o) => o.type === "PipeWire:Interface:Device" && o.info?.props?.["device.api"] === "bluez5").map((o) => {
    const sink = g.outputs.find((d) => d.deviceId === o.id);
    const p = o.info.props;
    return {
      id: o.id, address: String(p["api.bluez5.address"] ?? ""),
      label: sink?.label ?? String(p["device.description"] ?? "Bluetooth device"),
      profile: o.info?.params?.Profile?.[0]?.name ?? "off",
      profiles: (o.info?.params?.EnumProfile ?? []).map((e: any) => ({
        index: e.index, name: e.name, available: e.available !== "no",
        codec: (/codec ([^)]+)\)/.exec(String(e.description ?? ""))?.[1] ?? null),
      })),
    };
  });
}

function findBt(g: Graph, words: string[]): BtDevice {
  const all = btDevices(g);
  if (!all.length) throw new Fail("no Bluetooth audio device is connected", EXIT.notFound);
  const q = words.join(" ").trim().toLowerCase();
  if (!q) {
    if (all.length === 1) return all[0];
    throw new Fail(`${all.length} Bluetooth devices are connected; name one: ${all.map((d) => d.label).join(", ")}`, EXIT.usage);
  }
  const hits = all.filter((d) => d.label.toLowerCase().includes(q));
  if (hits.length === 1) return hits[0];
  throw new Fail(hits.length ? `"${q}" matches ${hits.length} Bluetooth devices` : `no Bluetooth device called "${q}"`, hits.length ? EXIT.usage : EXIT.notFound);
}

// Switch a headset to a profile with rule 6 around it, then read back what really happened.
function switchProfile(bt: BtDevice, index: number): { profile: string; codec: string | null; backAfterMs: number | null } {
  const sameDevice = (d: Device) => d.btAddress === bt.address;
  const result = guarded(sameDevice, (g) => g.outputs.some((d) => sameDevice(d) && d.isDefault),
    () => must(run(["wpctl", "set-profile", String(bt.id), String(index)]), "wpctl set-profile"));
  const after = readGraph();
  const now = btDevices(after).find((d) => d.address === bt.address);
  const sink = after.outputs.find(sameDevice);
  return { profile: now?.profile ?? "gone", codec: sink?.codec ?? null, backAfterMs: result.backAfterMs };
}

const btOffers = (bt: BtDevice) => bt.profiles.filter((p) => p.name.startsWith("a2dp-sink") && p.codec && p.available);
const normCodec = (x: string) => x.toLowerCase().replace(/[^a-z0-9]/g, "");
const btCodecNow = (bt: BtDevice) => bt.profiles.find((p) => p.name === bt.profile)?.codec ?? null;
const btModeNow = (bt: BtDevice) => bt.profile.startsWith("a2dp-sink") ? "music" : bt.profile.startsWith("headset-head-unit") ? "call" : "off";

function btSetMode(bt: BtDevice, mode: "music" | "call") {
  const target = bt.profiles.find((p) => p.available && p.name === (mode === "music" ? "a2dp-sink" : "headset-head-unit"))
    ?? bt.profiles.find((p) => p.available && p.name.startsWith(mode === "music" ? "a2dp-sink" : "headset-head-unit"));
  if (!target) throw new Fail(`${bt.label} has no ${mode} mode`, EXIT.notFound);
  const r = switchProfile(bt, target.index);
  return { ok: r.profile.startsWith(mode === "music" ? "a2dp-sink" : "headset-head-unit"), ...r };
}

function btSetCodec(bt: BtDevice, codec: string) {
  const match = btOffers(bt).find((p) => normCodec(p.codec!) === normCodec(codec));
  if (!match) throw new Fail(`${bt.label} does not offer ${codec}; it offers ${[...new Set(btOffers(bt).map((p) => p.codec))].join(", ")}`, EXIT.notFound);
  const r = switchProfile(bt, match.index);
  return { ok: r.codec !== null && normCodec(r.codec) === normCodec(match.codec!), ...r };
}

function smSetting(g: Graph, key: string): string | null {
  const md = g.objects.find((o) => o.type === "PipeWire:Interface:Metadata" && o.props?.["metadata.name"] === "sm-settings");
  const e = (md?.metadata ?? []).find((x: any) => x.key === key);
  return e === undefined ? null : String(e.value);
}

function verbBt(args: string[]): Out {
  const [sub, ...rest] = args;
  const g = readGraph();
  if (sub === "auto") {
    const want = rest[0];
    const key = "bluetooth.autoswitch-to-headset-profile";
    if (want === undefined) {
      const v = smSetting(g, key);
      return { json: { ok: true, auto: v === "true" }, text: `switch to call mode when an app records: ${v === "true" ? "on" : "off"}` };
    }
    if (!["on", "off"].includes(want)) throw new Fail("usage: ballroom bt auto [on|off]", EXIT.usage);
    must(run(["wpctl", "settings", "--save", key, want === "on" ? "true" : "false"]), "wpctl settings");
    const after = waitFor((x) => smSetting(x, key) === (want === "on" ? "true" : "false"));
    const v = smSetting(after, key);
    if (v !== (want === "on" ? "true" : "false")) throw new Fail("the setting did not take");
    return { json: { ok: true, auto: v === "true" }, text: `switch to call mode when an app records: ${want}` };
  }
  if (sub === undefined || sub === "list") {
    const all = btDevices(g);
    const text = all.map((d) => `${d.label}  ${d.profile}  codecs: ${[...new Set(d.profiles.filter((p) => p.name.startsWith("a2dp-sink") && p.codec).map((p) => p.codec))].join(", ")}`).join("\n");
    return { json: { ok: true, devices: all.map(({ id, address, ...rest }) => rest) }, text: text || "no Bluetooth audio device" };
  }
  if (sub === "codec") {
    const codecOf = (bt: BtDevice, word: string | undefined) => word ? btOffers(bt).find((p) => normCodec(p.codec!) === normCodec(word)) : undefined;
    // The last word is a codec if the device offers it; everything before it names the device.
    const last = rest[rest.length - 1];
    let bt = findBt(g, rest.slice(0, -1).length ? rest.slice(0, -1) : []);
    let match = codecOf(bt, last);
    if (!match && rest.length === 1) { bt = findBt(g, rest); match = undefined; }
    if (!match) {
      if (rest.length > 1) throw new Fail(`${bt.label} does not offer ${last}; it offers ${[...new Set(btOffers(bt).map((p) => p.codec))].join(", ")}`, EXIT.notFound);
      const list = [...new Set(btOffers(bt).map((p) => p.codec))];
      return { json: { ok: true, device: bt.label, current: btCodecNow(bt), codecs: list }, text: `${bt.label}: ${btCodecNow(bt) ?? "not in music mode"}; offers ${list.join(", ")}` };
    }
    const r = btSetCodec(bt, match.codec!);
    return { json: { ok: r.ok, device: bt.label, codec: r.codec, profile: r.profile, backAfterMs: r.backAfterMs },
             text: `${bt.label}: ${r.codec ?? "no codec"}${r.backAfterMs !== null ? `, back after ${r.backAfterMs} ms` : ", did not come back as the default"}` };
  }
  if (sub === "mode") {
    const mode = rest[rest.length - 1];
    if (mode !== "music" && mode !== "call") throw new Fail("usage: ballroom bt mode [DEVICE] music|call", EXIT.usage);
    const bt = findBt(g, rest.slice(0, -1));
    const r = btSetMode(bt, mode);
    return { json: { ok: r.ok, device: bt.label, mode, profile: r.profile, codec: r.codec, backAfterMs: r.backAfterMs },
             text: `${bt.label}: ${mode} mode, ${r.codec ?? "no codec"}` };
  }
  throw new Fail(`unknown: bt ${sub}`, EXIT.usage);
}

// ---------------------------------------------------------------- sound
// The equalizer is a PipeWire client of its own (ballroom-eq.service runs `pipewire -c eq.conf`), a filter-chain
// that WirePlumber puts in front of the default output as a smart filter. WirePlumber is never touched.
//
// Once running, the process is never stopped or rebuilt by a change: a sink that vanishes under a playing
// stream makes many players pause, and a rebuild plays the stream straight on the
// device for ~30 ms without the preamp. So the graph has one fixed shape with room for any preset (16 peaks,
// 4 low and 4 high shelves; a filter at 0 dB passes the sound unchanged), every change is a change of values,
// sent once because every real change of a builtin biquad resets it and clicks, and "off" sets all of them
// to neutral. Only `eq restart` (after an update) and `eq stop` end the process.
//
// The graph, per channel after a 2x2 matrix: copy -> mixer (balance, mono, swap) -> preamp -> filters. The
// preamp is a high shelf at 0 Hz, which is a plain gain. PipeWire's biquads follow the RBJ cookbook with Q for
// peaks and shelves alike (measured within 0.02 dB), so the curve computed here is the curve that is heard.
type BandType = "peaking" | "lowshelf" | "highshelf";
type Band = { type: BandType; freq: number; gain: number; q: number };
type Preset = { preamp: "auto" | number; bands: Band[] };
type Presets = { schemaVersion: 1; presets: Record<string, Preset> };
type Sound = { schemaVersion: 1; enabled: boolean; balance: number; mono: boolean; swap: boolean };

const EQ_UNIT = "ballroom-eq.service";
const EQ_NODE = "ballroom.eq";
// The unit reads %h/.config/ballroom/eq.conf; the path is spelled the same way here, whatever XDG says.
const EQ_CONF = join(HOME, ".config", "ballroom", "eq.conf");
const SAMPLE_RATE = 48000;
const MAX_BANDS = 16;
const SLOT_COUNT: Record<BandType, number> = { peaking: 16, lowshelf: 4, highshelf: 4 };
const SLOT_PREFIX: Record<BandType, string> = { peaking: "p", lowshelf: "l", highshelf: "h" };
const SHAPE = "fixed:16p4l4h";
const LABEL: Record<BandType, string> = { peaking: "bq_peaking", lowshelf: "bq_lowshelf", highshelf: "bq_highshelf" };

// Ten slots: a low shelf, eight peaks, a high shelf. Built-in presets only move gains, so switching between them
// is a change of values and never a restart.
const SLOTS: Band[] = [
  { type: "lowshelf", freq: 105, gain: 0, q: 0.7 },
  ...[63, 125, 250, 500, 1000, 2000, 4000, 8000].map((freq) => ({ type: "peaking" as BandType, freq, gain: 0, q: 1.0 })),
  { type: "highshelf", freq: 12000, gain: 0, q: 0.7 },
];
const withGains = (g: Record<number, number>): Band[] => SLOTS.map((b, i) => ({ ...b, gain: g[i] ?? 0 }));
const BUILTIN_PRESETS: Record<string, Preset> = {
  "Flat": { preamp: "auto", bands: withGains({}) },
  "Bass": { preamp: "auto", bands: withGains({ 0: 6, 1: 2 }) },
  "Treble": { preamp: "auto", bands: withGains({ 8: 2, 9: 4 }) },
  "Vocal": { preamp: "auto", bands: withGains({ 0: -2, 5: 1.5, 6: 3, 7: 1.5 }) },
  "Loudness": { preamp: "auto", bands: withGains({ 0: 5, 1: 2, 8: 1, 9: 3 }) },
};

const DEFAULT_SOUND: Sound = { schemaVersion: 1, enabled: false, balance: 0, mono: false, swap: false };
function loadSound(): Sound {
  const v = loadJson("sound.json", DEFAULT_SOUND, (x) => typeof x.enabled === "boolean");
  return { ...DEFAULT_SOUND, ...v, balance: Math.max(-1, Math.min(1, Number(v.balance) || 0)) };
}
const validBand = (b: any) => isObject(b) && ["peaking", "lowshelf", "highshelf"].includes(b.type)
  && [b.freq, b.gain, b.q].every((x) => typeof x === "number" && isFinite(x));
function loadPresets(): Presets {
  return loadJson("presets.json", { schemaVersion: 1, presets: {} } as Presets,
    (v) => isObject(v.presets) && Object.values(v.presets).every((p: any) => isObject(p) && Array.isArray(p.bands) && p.bands.every(validBand)));
}
function allPresets(): Record<string, Preset> { return { ...BUILTIN_PRESETS, ...loadPresets().presets }; }

function clampBand(b: Band): Band {
  const num = (v: number, fallback: number) => (Number.isFinite(v) ? v : fallback);
  return { type: b.type, freq: Math.round(Math.max(20, Math.min(20000, num(b.freq, 1000)))), gain: Math.round(Math.max(-24, Math.min(24, num(b.gain, 0))) * 10) / 10,
           q: Math.round(Math.max(0.1, Math.min(10, num(b.q, 1))) * 100) / 100 };
}

function biquad(b: Band): number[] {
  const A = Math.pow(10, b.gain / 40), w0 = 2 * Math.PI * b.freq / SAMPLE_RATE, c = Math.cos(w0), alpha = Math.sin(w0) / (2 * b.q);
  if (b.type === "peaking") return [1 + alpha * A, -2 * c, 1 - alpha * A, 1 + alpha / A, -2 * c, 1 - alpha / A];
  const sq = 2 * Math.sqrt(A) * alpha;
  if (b.type === "lowshelf") return [A * ((A + 1) - (A - 1) * c + sq), 2 * A * ((A - 1) - (A + 1) * c), A * ((A + 1) - (A - 1) * c - sq),
